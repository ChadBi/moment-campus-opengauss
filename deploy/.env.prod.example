# 此刻校园 - 生产环境配置
# 复制此文件为 .env.prod 并修改以下值

# 域名（必填！替换为你的实际域名，例如：example.com 或 moment.example.com）
DOMAIN=your-domain.com

# 数据库配置（生产环境请修改密码！）
DB_USER=gaussdb
DB_PASSWORD=Gaussdb@123_Change_Me
DB_PASSWORD_ENCODED=Gaussdb%40123_Change_Me
DB_NAME=moment_campus

# JWT密钥（生产环境必须修改为随机字符串！）
# 在服务器上生成方式：openssl rand -hex 32
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production-please-use-openssl

# 其他配置
APP_ENV=production
DEBUG=false

# ============================================================
# AI-01: AI Provider 配置（P2-011 补齐 9 项）
# 生产环境推荐 openai；未配置时自动降级为 mock（AI 功能不可用，但不影响主流程）
# 密钥仅服务端环境变量，不进前端、不进日志、不进 git
# ============================================================
# Provider 类型：mock / openai（生产推荐 openai；mock 仅用于无 Key 的演示/测试）
AI_PROVIDER=mock
# OpenAI API Key（仅 openai 模式必填；mock 模式留空）
# 建议使用网关代理后的 Key，避免直接暴露原始 OpenAI Key
AI_API_KEY=
# OpenAI API Base URL（可选，用于兼容代理/自建网关，例如 https://api.openai.com/v1 或自建网关）
AI_API_BASE=
# 模型名（推荐 gpt-4o-mini 性价比高；如需更强能力可换 gpt-4o）
AI_MODEL=gpt-4o-mini
# 超时（秒，单次请求；网络抖动场景可适当调大）
AI_TIMEOUT=15.0
# 单次请求最大输出 Token（控制成本；发布建议/搜索摘要 1024 已足够）
AI_MAX_TOKENS=1024
# 最大重试次数（指数退避：1s, 2s, 4s）；不含首次调用
AI_MAX_RETRIES=3
# 熔断：连续失败次数达到阈值后熔断（防止雪崩）
AI_CIRCUIT_FAILURE_THRESHOLD=5
# 熔断恢复时间（秒，超过此时间后半开尝试）
AI_CIRCUIT_RESET_SECONDS=60
