# 此刻校园 - 生产环境配置
# 复制此文件为 .env.prod 并修改以下值

# 域名（必填！替换为你的实际域名，例如：example.com 或 moment.example.com）
DOMAIN=your-domain.com

# 数据库配置（生产环境请修改密码！）
DB_USER=gaussdb
DB_PASSWORD=Gaussdb@123_Change_Me
DB_PASSWORD_ENCODED=Gaussdb%40123_Change_Me
DB_NAME=moment_campus

# JWT密钥（生产环境必须修改为随机字符串！）
# 在服务器上生成方式：openssl rand -hex 32
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production-please-use-openssl

# 其他配置
APP_ENV=production
DEBUG=false
