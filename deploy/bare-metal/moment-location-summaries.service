[Unit]
Description=Moment Campus Location Summary Worker
After=network-online.target docker.service moment-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=moment
Group=moment
WorkingDirectory=/opt/moment-campus/backend
Environment="PATH=/opt/moment-campus/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/opt/moment-campus/backend/.env.prod
ExecStart=/opt/moment-campus/backend/.venv/bin/python scripts/location_summary_worker.py --batch-size 20
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moment-location-summaries
NoNewPrivileges=true
PrivateTmp=true

