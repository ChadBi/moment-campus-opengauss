# P2-012: frontend .dockerignore
# 避免 COPY . . 把 node_modules / 测试 / e2e / 密钥打入构建上下文
# 构建器只需 src/ + 配置文件 + package*.json；nginx 阶段只需 dist/

# 版本控制
.git
.gitignore
.gitattributes

# 依赖与构建产物（构建器内 npm ci + npm run build 重新生成）
node_modules/
dist/
build/

# 测试与 E2E（生产镜像不需要）
e2e/
playwright-report/
test-results/
playwright/.cache/
*.spec.ts
*.spec.tsx
*.test.ts
*.test.tsx
coverage/

# 日志与临时文件
*.log
*.txt
logs/
tmp/
temp/
*.tmp
eslint_result.json
lint_*.txt
tsc_out.txt

# 环境变量（密钥不能进入镜像）
.env
.env.*
!.env.example

# IDE / 编辑器
.vscode/
.idea/
.trae/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 文档（生产镜像不需要）
docs/
*.md

# Docker 自身
Dockerfile
.dockerignore
docker-compose*.yml

# 设计稿与原型
*.fig
*.sketch
*.psd
*.ai
