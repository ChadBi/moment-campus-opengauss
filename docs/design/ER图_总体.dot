// 渲染命令: dot -Tpng ER图_总体.dot -o ER图_总体.png
// 或横向: dot -Tpng -Grankdir=LR ER图_总体.dot -o ER图_总体.png
digraph ER_Overall {
    graph [
        rankdir=LR,
        fontname="Microsoft YaHei",
        fontsize=16,
        label="此刻校园 数据库总体 E-R 图（江南大学蠡湖校区）",
        labelloc=t,
        splines=ortho,
        nodesep=0.4,
        ranksep=0.6
    ];
    node [fontname="Microsoft YaHei", fontsize=11];
    edge [fontname="Microsoft YaHei", fontsize=10, arrowhead=none];

    // ============================================================
    // 实体（方框）
    // ============================================================
    schools    [shape=box, label="schools",    style=filled, fillcolor="#EFF6FF"];
    users      [shape=box, label="users",     style=filled, fillcolor="#EFF6FF"];
    locations  [shape=box, label="locations", style=filled, fillcolor="#EFF6FF"];

    categories      [shape=box, label="categories",      style=filled, fillcolor="#FFF7ED"];
    post_types      [shape=box, label="post_types",      style=filled, fillcolor="#FFF7ED"];
    posts           [shape=box, label="posts",            style=filled, fillcolor="#FFF7ED"];
    tags            [shape=box, label="tags",             style=filled, fillcolor="#FFF7ED"];
    post_images     [shape=box, label="post_images",     style=filled, fillcolor="#FFF7ED"];
    drafts          [shape=box, label="drafts",           style=filled, fillcolor="#FFF7ED"];
    topic_collections [shape=box, label="topic_collections", style=filled, fillcolor="#FFF7ED"];

    comments          [shape=box, label="comments",          style=filled, fillcolor="#F0FDF4"];
    validation_records[shape=box, label="validation_records", style=filled, fillcolor="#F0FDF4"];

    reports        [shape=box, label="reports",        style=filled, fillcolor="#FEF2F2"];
    notifications  [shape=box, label="notifications",  style=filled, fillcolor="#FEF2F2"];

    browse_histories   [shape=box, label="browse_histories",   style=filled, fillcolor="#F5F3FF"];
    search_histories   [shape=box, label="search_histories",   style=filled, fillcolor="#F5F3FF"];
    admin_operation_logs [shape=box, label="admin_operation_logs", style=filled, fillcolor="#F5F3FF"];
    archive            [shape=box, label="logs_archive",       style=filled, fillcolor="#F5F3FF"];

    // ============================================================
    // 主码属性（椭圆，下划线）
    // ============================================================
    {node [shape=ellipse, style=filled, fillcolor=white, fontsize=10];
        pk_schools   [label=<<U>id</U>>];
        pk_users     [label=<<U>id</U>>];
        pk_locations [label=<<U>id</U>>];
        pk_categories [label=<<U>id</U>>];
        pk_post_types [label=<<U>id</U>>];
        pk_posts     [label=<<U>id,created_at</U>>];
        pk_tags      [label=<<U>id</U>>];
        pk_post_images [label=<<U>id</U>>];
        pk_drafts    [label=<<U>id</U>>];
        pk_tc        [label=<<U>id</U>>];
        pk_comments  [label=<<U>id,created_at</U>>];
        pk_validation [label=<<U>id,created_at</U>>];
        pk_reports   [label=<<U>id</U>>];
        pk_notif     [label=<<U>id,created_at</U>>];
        pk_browse    [label=<<U>id,created_at</U>>];
        pk_search    [label=<<U>id,created_at</U>>];
        pk_admin_log [label=<<U>id,created_at</U>>];
        pk_archive   [label=<<U>id</U>>];
    }

    // ============================================================
    // 联系（菱形）
    // ============================================================
    {node [shape=diamond, style=filled, fillcolor=white, fontsize=10, width=0.9, height=0.5];
        R_register   [label="注册"];
        R_contain_loc [label="包含"];
        R_publish    [label="发布"];
        R_category   [label="归类"];
        R_type       [label="类型"];
        R_locate     [label="定位"];
        R_image      [label="附图"];
        R_tag        [label="标签"];      // posts M:N tags
        R_like       [label="点赞"];      // posts M:N users
        R_tc_post    [label="收录"];      // tc M:N posts
        R_draft      [label="草稿"];
        R_create_tc  [label="创建"];
        R_comment    [label="评论"];
        R_reply      [label="回复"];      // comments 自引用
        R_validate   [label="验证"];
        R_report     [label="举报"];
        R_notify     [label="通知"];
        R_browse     [label="浏览"];
        R_search     [label="搜索"];
        R_admin_op   [label="操作"];
        R_archive    [label="归档"];
    }

    // ============================================================
    // 连线（无向，旁标基数比）
    // 实体—主码：1:1 无标
    // 实体—联系—实体：两端各标基数
    // ============================================================

    // ---- 实体—主码 ----
    schools -> pk_schools;
    users -> pk_users;
    locations -> pk_locations;
    categories -> pk_categories;
    post_types -> pk_post_types;
    posts -> pk_posts;
    tags -> pk_tags;
    post_images -> pk_post_images;
    drafts -> pk_drafts;
    topic_collections -> pk_tc;
    comments -> pk_comments;
    validation_records -> pk_validation;
    reports -> pk_reports;
    notifications -> pk_notif;
    browse_histories -> pk_browse;
    search_histories -> pk_search;
    admin_operation_logs -> pk_admin_log;
    archive -> pk_archive;

    // ---- A. 用户子系统 ----
    schools -> R_register [taillabel="1", labeldistance=1.5];
    R_register -> users   [headlabel="n", labeldistance=1.5];

    schools -> R_contain_loc [taillabel="1", labeldistance=1.5];
    R_contain_loc -> locations [headlabel="n", labeldistance=1.5];

    // ---- B. 信息核心子系统 ----
    users -> R_publish [taillabel="1", labeldistance=1.5];
    R_publish -> posts [headlabel="n", labeldistance=1.5];

    categories -> R_category [taillabel="1", labeldistance=1.5];
    R_category -> posts      [headlabel="n", labeldistance=1.5];

    post_types -> R_type [taillabel="1", labeldistance=1.5];
    R_type -> posts      [headlabel="n", labeldistance=1.5];

    locations -> R_locate [taillabel="0..1", labeldistance=1.5];
    R_locate -> posts     [headlabel="n", labeldistance=1.5];

    posts -> R_image [taillabel="1", labeldistance=1.5];
    R_image -> post_images [headlabel="n", labeldistance=1.5];

    // M:N 联系（posts-tags）
    posts -> R_tag [taillabel="m", labeldistance=1.5];
    R_tag -> tags  [headlabel="n", labeldistance=1.5];

    // M:N 联系（posts-likes-users）
    posts -> R_like [taillabel="m", labeldistance=1.5];
    R_like -> users [headlabel="n", labeldistance=1.5];

    // M:N 联系（topic_collections-posts）
    topic_collections -> R_tc_post [taillabel="m", labeldistance=1.5];
    R_tc_post -> posts             [headlabel="n", labeldistance=1.5];

    users -> R_draft [taillabel="1", labeldistance=1.5];
    R_draft -> drafts [headlabel="n", labeldistance=1.5];

    users -> R_create_tc [taillabel="1", labeldistance=1.5];
    R_create_tc -> topic_collections [headlabel="n", labeldistance=1.5];

    // ---- C. 互动子系统 ----
    posts -> R_comment [taillabel="1", labeldistance=1.5];
    R_comment -> comments [headlabel="n", labeldistance=1.5];

    users -> R_comment [taillabel="1", labeldistance=1.5];

    // comments 自引用
    comments -> R_reply [taillabel="0..1", labeldistance=1.5];
    R_reply -> comments [headlabel="n", labeldistance=1.5];

    posts -> R_validate [taillabel="1", labeldistance=1.5];
    R_validate -> validation_records [headlabel="n", labeldistance=1.5];

    users -> R_validate [taillabel="1", labeldistance=1.5];

    // ---- D. 治理子系统 ----
    posts -> R_report [taillabel="1", labeldistance=1.5];
    R_report -> reports [headlabel="n", labeldistance=1.5];
    users -> R_report [taillabel="1", labeldistance=1.5];
    comments -> R_report [taillabel="0..1", labeldistance=1.5];

    posts -> R_notify [taillabel="1", labeldistance=1.5];
    R_notify -> notifications [headlabel="n", labeldistance=1.5];
    users -> R_notify [taillabel="1", labeldistance=1.5];

    // ---- E. 历史与日志子系统 ----
    users -> R_browse [taillabel="1", labeldistance=1.5];
    R_browse -> browse_histories [headlabel="n", labeldistance=1.5];
    posts -> R_browse [taillabel="1", labeldistance=1.5];

    users -> R_search [taillabel="1", labeldistance=1.5];
    R_search -> search_histories [headlabel="n", labeldistance=1.5];

    users -> R_admin_op [taillabel="1", labeldistance=1.5];
    R_admin_op -> admin_operation_logs [headlabel="n", labeldistance=1.5];

    admin_operation_logs -> R_archive [taillabel="1", labeldistance=1.5];
    R_archive -> archive [headlabel="n", labeldistance=1.5];
}
