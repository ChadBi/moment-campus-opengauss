// ============================================================
// 此刻校园 - 数据库 ER 图（基于源码反向提取，非文档推导）
// 输出：graphviz dot
// 数据源：backend/app/models/*.py + backend/scripts/opengauss/*.sql
// 共 22 张表（21 业务表 + 1 归档表）
// 关系记号：Crow's Foot（鸦爪表示法）
//   crow  = N（多端）   tee = 1（强制一）   odot = 0/1（可选）
//   正向 1:N  →  [tee]──>[crow]
//   可选 0:N  →  [odot]──>[crow]
//   M:N      →  [crow]──>[crow]（通过中间表实现）
// ============================================================

digraph MomentCampusER {
    // ===== 全局样式 =====
    graph [
        rankdir=LR,
        fontname="Microsoft YaHei",
        bgcolor="#FAFAFA",
        splines=ortho,          // 正交连线，避免重叠
        nodesep=0.55,
        ranksep=1.0,
        pad=0.5,
        label="\n此刻校园 数据库 ER 图（江南大学蠡湖校区）\n基于源码反向提取  ·  共 22 张表  ·  Crow's Foot 表示法",
        labelloc=t,
        fontsize=20,
        fontcolor="#1F2937"
    ];
    node [
        shape=plaintext,
        fontname="Microsoft YaHei",
        fontsize=11
    ];
    edge [
        fontname="Microsoft YaHei",
        fontsize=9,
        color="#4B5563",
        arrowsize=0.8
    ];

    // ============================================================
    // 实体定义（HTML-like label，显示字段、类型、主外键）
    // 颜色分组：
    //   蓝   = 用户子系统     (schools, users, locations)
    //   橙   = 信息核心       (categories, post_types, posts, post_images,
    //                          tags, post_tags, drafts, topic_collections,
    //                          topic_collection_posts)
    //   绿   = 互动子系统     (comments, likes, validation_records)
    //   红   = 治理           (reports, notifications)
    //   紫   = 历史与日志     (browse_histories, search_histories,
    //                          admin_operation_logs, admin_operation_logs_archive)
    // ============================================================

    // ---------- 用户子系统 ----------
    schools [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#1E40AF" COLSPAN="3"><FONT COLOR="white"><B>schools  学校</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE">UQ</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">logo_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">province / city</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">center_lat / lng</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">map_zoom</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    users [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#1E40AF" COLSPAN="3"><FONT COLOR="white"><B>users  用户</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE">UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
            <TR><TD BGCOLOR="#DBEAFE">FK</TD><TD ALIGN="LEFT">school_id</TD><TD ALIGN="LEFT">BIGINT → schools</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">nickname</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">avatar_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">bio</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">reputation_score</TD><TD ALIGN="LEFT">NUMERIC(5,2)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    locations [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#1E40AF" COLSPAN="3"><FONT COLOR="white"><B>locations  地点</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#DBEAFE">FK</TD><TD ALIGN="LEFT">school_id</TD><TD ALIGN="LEFT">BIGINT → schools</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">latitude / longitude</TD><TD ALIGN="LEFT">NUMERIC(10,7)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">building / floor</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">post_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_verified</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    // ---------- 信息核心子系统 ----------
    categories [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>categories  分类</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">icon</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">default_validity_days</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    post_types [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>post_types  信息类型</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    posts [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>posts  信息（分区表，按 created_at 月分区）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">school_id</TD><TD ALIGN="LEFT">BIGINT → schools</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">BIGINT → categories</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">post_type_id</TD><TD ALIGN="LEFT">BIGINT → post_types</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">location_id</TD><TD ALIGN="LEFT">BIGINT → locations</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">title / content</TD><TD ALIGN="LEFT">VARCHAR(200) / TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_anonymous</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20) 6态机</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">view/like/comment/valid/invalid_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">credibility_score</TD><TD ALIGN="LEFT">NUMERIC(5,2)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">expire_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">activity_start_at / end_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">lost_type / contact_info</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_recommend</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    tags [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>tags  标签</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">usage_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_official</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    post_tags [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>post_tags  信息-标签（M:N 关联）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT">BIGINT → tags</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">(post_id, tag_id)</TD><TD ALIGN="LEFT">复合唯一</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    post_images [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>post_images  信息图片</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">image_url / thumbnail_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">file_size / width / height</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    drafts [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>drafts  草稿</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">BIGINT → categories</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">post_type_id</TD><TD ALIGN="LEFT">BIGINT → post_types</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">location_id</TD><TD ALIGN="LEFT">BIGINT → locations</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">title / content</TD><TD ALIGN="LEFT">VARCHAR / TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_anonymous</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">extra_data</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    topic_collections [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>topic_collections  专题合集</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">school_id</TD><TD ALIGN="LEFT">BIGINT → schools</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">creator_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">title / description</TD><TD ALIGN="LEFT">VARCHAR / TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">cover_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">post_count / view_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    topic_collection_posts [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#C2410C" COLSPAN="3"><FONT COLOR="white"><B>topic_collection_posts  合集-信息（M:N）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FED7AA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">topic_collection_id</TD><TD ALIGN="LEFT">BIGINT → topic_collections</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#FED7AA">UQ</TD><TD ALIGN="LEFT">(topic_collection_id, post_id)</TD><TD ALIGN="LEFT">复合唯一</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    // ---------- 互动子系统 ----------
    comments [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#15803D" COLSPAN="3"><FONT COLOR="white"><B>comments  评论（分区表，自引用）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">BIGINT → comments</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">reply_to_user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">like_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    likes [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#15803D" COLSPAN="3"><FONT COLOR="white"><B>likes  点赞</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">UQ</TD><TD ALIGN="LEFT">(post_id, user_id)</TD><TD ALIGN="LEFT">复合唯一</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    validation_records [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#15803D" COLSPAN="3"><FONT COLOR="white"><B>validation_records  协同验证（分区表）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#BBF7D0">UQ</TD><TD ALIGN="LEFT">(post_id, user_id)</TD><TD ALIGN="LEFT">每用户每帖一条</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">validation_type</TD><TD ALIGN="LEFT">VARCHAR(20) 2类</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    // ---------- 治理子系统 ----------
    reports [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#B91C1C" COLSPAN="3"><FONT COLOR="white"><B>reports  举报</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FECACA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">comment_id</TD><TD ALIGN="LEFT">BIGINT → comments</TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">reporter_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">handler_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#FECACA">UQ</TD><TD ALIGN="LEFT">(post_id, reporter_id)</TD><TD ALIGN="LEFT">复合唯一</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">report_type</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">description / handle_result</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">handled_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    notifications [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#B91C1C" COLSPAN="3"><FONT COLOR="white"><B>notifications  通知（分区表）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#FECACA"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#FECACA">FK</TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">type / title</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">target_type / target_id</TD><TD ALIGN="LEFT">VARCHAR / BIGINT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_read / read_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_deleted / deleted_at</TD><TD ALIGN="LEFT">BOOL / TS</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    // ---------- 历史与日志子系统 ----------
    browse_histories [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#6D28D9" COLSPAN="3"><FONT COLOR="white"><B>browse_histories  浏览历史（分区表）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD BGCOLOR="#DDD6FE">FK</TD><TD ALIGN="LEFT">post_id</TD><TD ALIGN="LEFT">BIGINT → posts</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    search_histories [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#6D28D9" COLSPAN="3"><FONT COLOR="white"><B>search_histories  搜索历史（分区表）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">keyword</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">result_count</TD><TD ALIGN="LEFT">INT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    admin_operation_logs [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#6D28D9" COLSPAN="3"><FONT COLOR="white"><B>admin_operation_logs  管理员操作日志（分区表）</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id, created_at</B></TD><TD ALIGN="LEFT"><I>BIGINT, TS</I></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE">FK</TD><TD ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT">BIGINT → users</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">target_type / target_id</TD><TD ALIGN="LEFT">VARCHAR / BIGINT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">detail</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">user_agent</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    admin_operation_logs_archive [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
            <TR><TD BGCOLOR="#6D28D9" COLSPAN="3"><FONT COLOR="white"><B>admin_operation_logs_archive  日志归档表</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#DDD6FE"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><I>BIGINT</I></TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">admin_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">action / target_type</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">target_id / detail</TD><TD ALIGN="LEFT">BIGINT / TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ip_address / user_agent</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at / archived_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    // ============================================================
    // 关系定义（Crow's Foot 表示法）
    // arrowtail（起点端）  arrowhead（终点端）
    //   tee   = 1            crow = N（多）
    //   odot  = 0/1（可选）  none  = 无标记
    // ============================================================

    // ---- 用户子系统内 ----
    schools -> users     [taillabel="1", headlabel="N", arrowtail=tee,    arrowhead=crow,   label="注册"];
    schools -> locations [taillabel="1", headlabel="N", arrowtail=tee,    arrowhead=crow,   label="包含"];

    // ---- 信息核心 ----
    schools          -> posts                  [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="归属"];
    users            -> posts                  [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="发布"];
    categories       -> posts                  [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="归类"];
    post_types       -> posts                  [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="类型"];
    locations        -> posts                  [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label="定位"];
    posts            -> post_images            [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="附图"];

    // 信息-标签 M:N（通过 post_tags 关联表）
    posts -> post_tags [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];
    tags  -> post_tags [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];

    // 草稿
    users      -> drafts        [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="编辑"];
    categories -> drafts        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label=""];
    post_types -> drafts        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label=""];
    locations  -> drafts        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label=""];

    // 专题合集
    schools         -> topic_collections        [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="归属"];
    users           -> topic_collections        [taillabel="1", headlabel="N", arrowtail=tee,  arrowhead=crow, label="创建"];
    topic_collections -> topic_collection_posts [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];
    posts           -> topic_collection_posts   [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];

    // ---- 互动子系统 ----
    posts -> comments           [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="评论"];
    users -> comments           [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="发表"];
    comments -> comments        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label="回复"];

    posts -> likes              [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="点赞"];
    users -> likes              [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];

    posts -> validation_records [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="验证"];
    users -> validation_records [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];

    // ---- 治理子系统 ----
    posts    -> reports         [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label="被举报"];
    comments -> reports        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label=""];
    users    -> reports        [taillabel="1", headlabel="N", arrowtail=tee,   arrowhead=crow, label="举报人", fontcolor="#B91C1C"];
    users    -> reports        [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label="处理人", style=dashed, color="#9CA3AF"];

    users -> notifications     [taillabel="1", headlabel="N", arrowtail=tee,   arrowhead=crow, label="接收", fontcolor="#B91C1C"];
    users -> notifications     [taillabel="0/1", headlabel="N", arrowtail=odot, arrowhead=crow, label="触发", style=dashed, color="#9CA3AF"];

    // ---- 历史与日志 ----
    users -> browse_histories    [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="浏览"];
    posts -> browse_histories    [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label=""];

    users -> search_histories    [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="搜索"];

    users -> admin_operation_logs [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, label="操作"];
    admin_operation_logs -> admin_operation_logs_archive [taillabel="N", headlabel="N", arrowtail=crow, arrowhead=crow, label="归档", style=dashed, color="#9CA3AF"];

    // ============================================================
    // 子系统分组（cluster）
    // ============================================================
    subgraph cluster_user {
        label="用户子系统"; style=dashed; color="#1E40AF"; fontcolor="#1E40AF"; fontsize=14;
        schools; users; locations;
    }
    subgraph cluster_post {
        label="信息核心子系统"; style=dashed; color="#C2410C"; fontcolor="#C2410C"; fontsize=14;
        categories; post_types; posts; tags; post_tags; post_images; drafts;
        topic_collections; topic_collection_posts;
    }
    subgraph cluster_inter {
        label="互动子系统"; style=dashed; color="#15803D"; fontcolor="#15803D"; fontsize=14;
        comments; likes; validation_records;
    }
    subgraph cluster_gov {
        label="治理子系统"; style=dashed; color="#B91C1C"; fontcolor="#B91C1C"; fontsize=14;
        reports; notifications;
    }
    subgraph cluster_log {
        label="历史与日志子系统"; style=dashed; color="#6D28D9"; fontcolor="#6D28D9"; fontsize=14;
        browse_histories; search_histories; admin_operation_logs; admin_operation_logs_archive;
    }
}
