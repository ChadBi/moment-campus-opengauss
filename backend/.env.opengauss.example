APP_NAME=此刻校园-OpenGauss
APP_ENV=opengauss
DEBUG=True
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://gaussdb:Gaussdb%40PLACEHOLDER@localhost:5432/moment_campus
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

LOG_LEVEL=DEBUG

SCHOOL_CODE=jiangnan

# 手机号认证：开发环境使用 Mock，生产环境必须通过环境变量切换为 aliyun
SMS_PROVIDER=mock
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_MOCK_CODE=123456
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 推荐按用途分别配置；未填写时回退到上面的通用模板。
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
ALIYUN_SMS_SET_PASSWORD_TEMPLATE_CODE=
ALIYUN_SMS_EDUCATION_UNBIND_TEMPLATE_CODE=

# 微信真实登录（从微信公众平台/小程序后台获取；未填写时使用 Mock 登录）
WECHAT_APPID=
WECHAT_APPSECRET=

# ============================================================
# AI-01: AI Provider 配置
# 本地开发默认 mock（不依赖外部 API Key）；生产用 openai。
# 密钥仅服务端环境变量，不进前端、不进日志、不进 git。
#
# 兼容方案示例（DeepSeek，兼容 OpenAI API）：
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   AI_API_BASE=https://api.deepseek.com
#   AI_MODEL=deepseek-v4-flash
# ============================================================
# Provider 类型：mock / openai（默认 mock，确保无 API Key 也能运行测试）
AI_PROVIDER=mock
# OpenAI API Key（仅 openai 模式需要，mock 模式可留空）
AI_API_KEY=
# OpenAI API Base URL（可选，用于兼容代理/自建网关，例如 https://api.deepseek.com）
AI_API_BASE=
# 模型名（OpenAI: gpt-4o-mini；DeepSeek: deepseek-v4-flash）
AI_MODEL=gpt-4o-mini
# 超时（秒，单次请求）
AI_TIMEOUT=15.0
# 单次请求最大输出 Token
AI_MAX_TOKENS=1024
# 最大重试次数（指数退避：1s, 2s, 4s）；不含首次调用
AI_MAX_RETRIES=3
# 熔断：连续失败次数达到阈值后熔断
AI_CIRCUIT_FAILURE_THRESHOLD=5
# 熔断恢复时间（秒）
AI_CIRCUIT_RESET_SECONDS=60

# T7: 独立 Embedding 服务（OpenAI 兼容接口；不要复用或提交真实密钥）
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT=15.0
