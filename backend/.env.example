# 此刻校园 - 本地开发环境配置示例
# 复制此文件为 .env 并按需修改（.env 已被 .gitignore 排除，不会进入版本控制）

# 应用配置
APP_NAME=此刻校园
DEBUG=True
API_V1_PREFIX=/api/v1
# APP_ENV 决定运行模式：opengauss（本地开发默认）/ production（生产）/ demo / test
APP_ENV=opengauss

# 数据库配置（openGauss 7.0.0-RC3 轻量版；SQLite 已彻底移除）
# 本地开发默认连接 docker-compose 起的 openGauss 容器
DATABASE_URL=postgresql+asyncpg://gaussdb:Gaussdb%40123@localhost:5432/moment_campus

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# CORS 配置（前端开发端口 5173）
CORS_ORIGINS=["http://localhost:5173"]

# 日志配置
LOG_LEVEL=INFO

# ============================================================
# AI-01: AI Provider 配置（P2-011 补齐 9 项）
# 本地开发默认 mock（不依赖外部 API Key，AI 接口走预置 mock 响应）
# 切换 openai 模式需自备 API Key；密钥仅服务端环境变量，不进前端、不进日志、不进 git
# ============================================================
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15.0
AI_MAX_TOKENS=1024
AI_MAX_RETRIES=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_SECONDS=60
