<view class="tab-bar safe-area-bottom">
  <view class="tab-inner">
    <view
      class="tab-item {{selected === 0 ? 'active' : ''}}"
      data-index="0"
      data-path="/pages/home/home"
      bindtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <icon name="home" size="40rpx" color="{{selected === 0 ? '#174d5e' : 'rgba(255,255,255,0.75)'}}" />
      <text class="tab-label">首页</text>
    </view>

    <view
      class="tab-item {{selected === 1 ? 'active' : ''}}"
      data-index="1"
      data-path="/pages/map/map"
      bindtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <icon name="map" size="40rpx" color="{{selected === 1 ? '#174d5e' : 'rgba(255,255,255,0.75)'}}" />
      <text class="tab-label">地图</text>
    </view>

    <view
      class="tab-item tab-publish {{selected === 3 ? 'active' : ''}}"
      data-index="3"
      data-path="/pages/publish/publish"
      bindtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <view class="publish-btn">
        <icon name="plus-circle" size="48rpx" color="#ffffff" />
      </view>
      <text class="tab-label publish-label">发布</text>
    </view>

    <view
      class="tab-item {{selected === 2 ? 'active' : ''}}"
      data-index="2"
      data-path="/pages/search/search"
      bindtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <icon name="search" size="40rpx" color="{{selected === 2 ? '#174d5e' : 'rgba(255,255,255,0.75)'}}" />
      <text class="tab-label">搜索</text>
    </view>

    <view
      class="tab-item {{selected === 4 ? 'active' : ''}}"
      data-index="4"
      data-path="/pages/profile/profile"
      bindtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <icon name="user" size="40rpx" color="{{selected === 4 ? '#174d5e' : 'rgba(255,255,255,0.75)'}}" />
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
