<view class="map-page">
  <map
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    enable-zoom
    enable-scroll
    bindmarkertap="onMarkerTap"
  ></map>

  <!-- 顶部信息栏 + 学校切换 -->
  <view class="map-header">
    <view class="school-info" bindtap="goToSchoolSelect" hover-class="school-info-hover" hover-stay-time="120">
      <view class="school-name-row">
        <text class="school-name">{{schoolName}}</text>
        <icon name="chevron-down" size="24rpx" color="#174d5e" />
      </view>
      <text class="school-subtitle">点击切换学校</text>
    </view>
  </view>

  <!-- 全部地点入口（直达地点页） -->
  <view class="nearby-entry" bindtap="goToLocationsPage" hover-class="nearby-entry-hover" hover-stay-time="120">
    <icon name="map-pin" size="28rpx" color="#174d5e" />
    <text class="nearby-entry-text">全部地点</text>
  </view>

  <!-- 地点信息卡片 -->
  <view wx:if="{{selectedLocation}}" class="info-card">
    <view class="info-card-header">
      <text class="info-title">{{selectedLocation.name}}</text>
      <view class="info-close" catchtap="closeLocationCard" hover-class="info-close-hover" hover-stay-time="120">
        <icon name="x" size="32rpx" color="#6a7d81" />
      </view>
    </view>
    <view class="loc-meta-row">
      <text class="loc-stars">{{selectedLocation.starsText}}</text>
      <text class="loc-score">{{selectedLocation.avgScoreText}}</text>
      <text class="loc-meta">{{selectedLocation.rating_count}} 人评 · {{selectedLocation.review_count}} 条评价</text>
    </view>
    <view class="info-action" catchtap="goToLocationDetail" hover-class="info-action-hover" hover-stay-time="120">
      <text>查看详情</text>
      <icon name="chevron-right" size="28rpx" color="#ffffff" />
    </view>
  </view>
</view>