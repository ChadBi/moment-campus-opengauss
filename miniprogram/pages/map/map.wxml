<view class="map-page">
  <map
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    enable-zoom
    enable-scroll
    bindmarkertap="onMarkerTap"
  ></map>

  <view class="map-header">
    <view class="school-info">
      <view class="school-name-row">
        <view class="school-dot"></view>
        <text class="school-name">{{schoolName}}</text>
      </view>
      <text class="school-subtitle">静态校园地图 · 点击地点查看动态</text>
    </view>
    <view class="map-status {{locationsLoading ? 'loading' : ''}}">
      <view class="status-dot"></view>
      <text>{{locationsLoading ? '加载中' : '已更新'}}</text>
    </view>
  </view>

  <view class="map-toolbar">
    <view class="toolbar-entry" bindtap="goToLocationsPage" hover-class="toolbar-entry-hover" hover-stay-time="120">
      <icon name="map-pin" size="28rpx" color="#174d5e" />
      <text>全部地点</text>
    </view>
    <view class="zoom-control">
      <view class="zoom-button" bindtap="onZoomIn" hover-class="zoom-button-hover" hover-stay-time="120">
        <text>＋</text>
      </view>
      <view class="zoom-divider"></view>
      <view class="zoom-button" bindtap="onZoomOut" hover-class="zoom-button-hover" hover-stay-time="120">
        <text>－</text>
      </view>
    </view>
  </view>

  <view wx:if="{{locationsError}}" class="map-error" bindtap="loadLocations">
    <icon name="alert-circle" size="26rpx" color="#cc5f30" />
    <text>地点加载失败，点击重试</text>
  </view>

  <view wx:if="{{selectedLocation}}" class="location-sheet {{sheetExpanded ? 'location-sheet-expanded' : 'location-sheet-half'}}">
    <scroll-view class="sheet-scroll" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <view
        class="sheet-drag-area"
        catchtouchstart="onSheetTouchStart"
        catchtouchmove="onSheetTouchMove"
        catchtouchend="onSheetTouchEnd">
        <view class="sheet-handle"></view>
        <view class="sheet-header">
          <view class="sheet-title-wrap">
            <view class="sheet-pin {{selectedLocation.location.is_verified ? 'verified' : 'unverified'}}">
              <icon name="map-pin" size="28rpx" color="#ffffff" />
            </view>
            <view class="sheet-title-text">
              <view class="sheet-name-row">
                <text class="sheet-name">{{selectedLocation.location.name}}</text>
                <text wx:if="{{selectedLocation.location.is_verified}}" class="verified-badge">官方核验</text>
                <text wx:else class="pending-badge">待核验</text>
              </view>
              <text class="sheet-address">{{selectedLocation.location.building || '校园内'}}{{selectedLocation.location.floor ? ' · ' + selectedLocation.location.floor + '层' : ''}}</text>
            </view>
          </view>
          <view class="info-close" catchtap="closeLocationCard" hover-class="info-close-hover" hover-stay-time="120">
            <icon name="x" size="32rpx" color="#6a7d81" />
          </view>
        </view>
      </view>

      <view class="sheet-content">
        <view wx:if="{{selectedLocation.loading}}" class="sheet-loading">
          <skeleton variant="list-item" />
          <skeleton variant="list-item" />
        </view>

        <view wx:elif="{{selectedLocation.error}}" class="sheet-error">
          <icon name="alert-circle" size="30rpx" color="#cc5f30" />
          <text>{{selectedLocation.error}}</text>
        </view>

        <block wx:else>
          <view class="sheet-meta">
            <view class="score-block">
              <text class="score-stars">{{selectedLocation.location.avg_score > 0 ? '★' : '☆'}}</text>
              <text class="score-value">{{selectedLocation.scoreText}}</text>
            </view>
            <text class="meta-text">{{selectedLocation.location.rating_count}} 人评分</text>
            <text class="meta-separator">·</text>
            <text class="meta-text">{{selectedLocation.location.review_count}} 条评价</text>
          </view>

          <view wx:if="{{selectedLocation.detail && selectedLocation.detail.facts.length > 0}}" class="facts-block">
            <text class="block-title">已审核资料</text>
            <view wx:for="{{selectedLocation.detail.facts}}" wx:key="id" class="fact-row">
              <text class="fact-label">{{item.label}}</text>
              <text class="fact-value">{{item.value}}</text>
            </view>
          </view>

          <view class="summary-block">
            <view class="block-title-row">
              <text class="block-title">此刻摘要</text>
              <text wx:if="{{selectedLocation.detail.summary.source_count > 0}}" class="source-count">{{selectedLocation.detail.summary.source_count}} 个来源</text>
            </view>
            <text wx:if="{{selectedLocation.detail.summary.summary_text}}" class="summary-text">{{selectedLocation.detail.summary.summary_text}}</text>
            <text wx:else class="summary-empty">暂无足够近期信息</text>
          </view>

          <view class="posts-block">
            <view class="block-title-row">
              <text class="block-title">相关帖子</text>
              <text class="source-count">{{selectedLocation.relatedPostCount}} 条</text>
            </view>
            <view wx:if="{{selectedLocation.postsLoading}}" class="posts-loading">
              <view class="loading-dot"></view>
              <view class="loading-dot"></view>
              <view class="loading-dot"></view>
            </view>
            <view wx:elif="{{selectedLocation.postsError}}" class="posts-empty error">{{selectedLocation.postsError}}</view>
            <view wx:elif="{{selectedLocation.relatedPosts.length === 0}}" class="posts-empty">暂无相关帖子，快来发布第一条吧</view>
            <view wx:else>
              <post-card
                wx:for="{{selectedLocation.relatedPosts}}"
                wx:key="id"
                post="{{item}}"
                bind:tap="onRelatedPostTap" />
            </view>
          </view>
        </block>

        <view class="sheet-actions">
          <view class="detail-action" bindtap="goToLocationDetail" hover-class="detail-action-hover" hover-stay-time="120">
            <text>查看完整详情</text>
            <icon name="chevron-right" size="28rpx" color="#ffffff" />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
