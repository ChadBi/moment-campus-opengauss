.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100vh;
}

/* ============== 顶部信息栏 ============== */
.map-header {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  z-index: 10;
}

.school-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.school-info-hover {
  opacity: 0.7;
}

.school-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.school-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.school-subtitle {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ============== 标记点信息卡片 ============== */
.info-card {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding: 24rpx 30rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  z-index: 10;
}

.info-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.info-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
}

.info-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  border-radius: 50%;
  transition: all 0.2s;
  flex-shrink: 0;
}

.info-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.verified-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(115, 160, 104, 0.14);
  color: var(--success);
  font-size: 20rpx;
}

.info-close-hover {
  background: var(--paper-hover);
  color: var(--ink);
}

.info-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-lake);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.info-action-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

/* ============== 全部地点入口 ============== */
.locations-entry {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: var(--paper);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  z-index: 10;
  transition: all 0.2s;
}

.locations-entry-hover {
  background: var(--paper-hover);
  transform: scale(0.96);
}

.locations-entry-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--lake);
}

/* ============== 地点信息卡片 ============== */
.loc-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.loc-stars {
  color: var(--lamp);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.loc-score {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 28rpx;
  color: var(--ink);
}

.loc-meta {
  font-size: 22rpx;
  color: var(--muted);
}
