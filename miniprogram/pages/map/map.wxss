.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100vh;
}

/* ============== 顶部信息栏 ============== */
.map-header {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  z-index: 10;
}

.school-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.school-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.school-subtitle {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ============== 定位按钮 ============== */
.locate-btn {
  width: 72rpx;
  height: 72rpx;
  background: var(--lake);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.locate-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.95);
}

/* ============== 权限提示 ============== */
.denied-tip {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  right: 20rpx;
  padding: 16rpx 24rpx;
  background: var(--paper-alt);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 10;
}

.denied-tip-hover {
  background: var(--paper-hover);
}

.denied-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.4;
}

/* ============== 标记点信息卡片 ============== */
.info-card {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 40rpx;
  padding: 24rpx 30rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  z-index: 10;
}

.info-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.info-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
}

.info-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  border-radius: 50%;
  transition: all 0.2s;
  flex-shrink: 0;
}

.info-close-hover {
  background: var(--paper-hover);
  color: var(--ink);
}

.info-snippet {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.info-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.info-tag {
  padding: 4rpx 16rpx;
  background: var(--lake-light);
  color: var(--lake);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
}

.info-status {
  background: #ebf2ed;
  color: var(--grass);
}

.info-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-lake);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.info-action-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

/* ============== 帖子 / 附近 模式切换 ============== */
.mode-switch {
  position: fixed;
  top: 140rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
  z-index: 10;
}

.mode-item {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  transition: all 0.2s;
}

.mode-item.active {
  background: var(--lake);
  color: #fff;
  font-weight: 600;
}

.mode-item-hover {
  background: var(--paper-hover);
}

/* ============== 附近地点入口 ============== */
.nearby-entry {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: var(--paper);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  z-index: 10;
  transition: all 0.2s;
}

.nearby-entry-hover {
  background: var(--paper-hover);
  transform: scale(0.96);
}

.nearby-entry-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--lake);
}

/* ============== 地点信息卡片 ============== */
.loc-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.loc-stars {
  color: var(--lamp);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.loc-score {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 28rpx;
  color: var(--ink);
}

.loc-meta {
  font-size: 22rpx;
  color: var(--muted);
}

.loc-distance-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.loc-distance-text {
  font-size: 24rpx;
  color: var(--ink-2);
}
