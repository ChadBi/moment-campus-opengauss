.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: var(--mist);
}

.map {
  width: 100%;
  height: 100vh;
}

.map-header {
  position: fixed;
  top: calc(18rpx + env(safe-area-inset-top));
  left: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(250, 252, 251, 0.94);
  border: 1rpx solid rgba(216, 225, 227, 0.85);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(21, 38, 41, 0.14);
  backdrop-filter: blur(16rpx);
  z-index: 10;
}

.school-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.school-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.school-dot,
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lake);
  box-shadow: 0 0 0 6rpx rgba(47, 127, 143, 0.12);
  flex-shrink: 0;
}

.school-name {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.school-subtitle {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.map-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(115, 160, 104, 0.12);
  color: var(--success);
  font-size: 20rpx;
  flex-shrink: 0;
}

.map-status.loading {
  background: rgba(47, 127, 143, 0.1);
  color: var(--lake);
}

.map-status.loading .status-dot {
  background: var(--lake);
  animation: map-pulse 1.2s ease-in-out infinite;
}

.map-toolbar {
  position: fixed;
  top: calc(148rpx + env(safe-area-inset-top));
  left: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.toolbar-entry,
.zoom-control {
  display: flex;
  align-items: center;
  background: rgba(250, 252, 251, 0.94);
  border: 1rpx solid rgba(216, 225, 227, 0.85);
  box-shadow: 0 10rpx 24rpx rgba(21, 38, 41, 0.13);
  backdrop-filter: blur(14rpx);
}

.toolbar-entry {
  gap: 9rpx;
  padding: 13rpx 18rpx;
  border-radius: 999rpx;
  color: var(--lake);
  font-size: 24rpx;
  font-weight: 600;
}

.toolbar-entry-hover,
.zoom-button-hover {
  background: #ffffff;
  transform: translateY(-1rpx);
}

.zoom-control {
  overflow: hidden;
  border-radius: 16rpx;
}

.zoom-button {
  width: 70rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 36rpx;
  line-height: 1;
}

.zoom-divider {
  width: 1rpx;
  height: 38rpx;
  background: var(--ink-divider);
}

.map-error {
  position: fixed;
  top: calc(228rpx + env(safe-area-inset-top));
  left: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(204, 95, 48, 0.22);
  border-radius: 16rpx;
  background: rgba(255, 248, 243, 0.95);
  color: var(--danger);
  font-size: 23rpx;
  z-index: 11;
}

.location-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: calc(168rpx + env(safe-area-inset-bottom));
  height: 52vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: rgba(250, 252, 251, 0.98);
  border: 1rpx solid rgba(216, 225, 227, 0.95);
  border-radius: 28rpx;
  box-shadow: 0 22rpx 60rpx rgba(21, 38, 41, 0.24);
  backdrop-filter: blur(18rpx);
  z-index: 20;
  will-change: transform;
  transition: top 280ms cubic-bezier(0.16, 1, 0.3, 1), bottom 280ms cubic-bezier(0.16, 1, 0.3, 1), height 280ms cubic-bezier(0.16, 1, 0.3, 1), border-radius 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  animation: sheet-in 180ms ease-out both;
}

.location-sheet-dragging {
  transition: none;
}

.location-sheet-half {
  border-radius: 28rpx;
}

.location-sheet-expanded {
  top: 8rpx;
  bottom: calc(168rpx + env(safe-area-inset-bottom));
  height: auto;
  border-radius: 28rpx;
}

.sheet-drag-area {
  flex-shrink: 0;
}

.sheet-handle {
  width: 70rpx;
  height: 8rpx;
  margin: 12rpx auto 0;
  border-radius: 999rpx;
  background: var(--ink-divider);
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.sheet-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.sheet-pin {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.sheet-pin.verified {
  background: var(--lake);
  box-shadow: 0 8rpx 18rpx rgba(47, 127, 143, 0.24);
}

.sheet-pin.unverified {
  background: var(--lamp);
  box-shadow: 0 8rpx 18rpx rgba(232, 167, 65, 0.24);
}

.sheet-title-text {
  min-width: 0;
}

.sheet-name-row,
.block-title-row,
.review-header-row,
.rating-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.sheet-name {
  min-width: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-address {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.verified-badge,
.pending-badge {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.verified-badge {
  background: rgba(47, 127, 143, 0.12);
  color: var(--lake);
}

.pending-badge {
  background: rgba(232, 167, 65, 0.16);
  color: #a76c16;
}

.info-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  z-index: 3;
}

.info-close-hover {
  background: var(--mist);
}

.sheet-scroll {
  min-height: 0;
  height: 100%;
  flex: 1;
  width: 100%;
  padding: 0;
  box-sizing: border-box;
}

.sheet-scroll[scroll-y="false"] {
  overflow: hidden;
}

.sheet-content {
  padding: 20rpx 24rpx 8rpx;
}

.sheet-loading,
.sheet-error,
.sheet-meta,
.facts-block,
.summary-block,
.posts-block,
.rating-summary-card,
.my-review-card {
  margin-bottom: 18rpx;
}

.sheet-error,
.posts-empty {
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(204, 95, 48, 0.08);
  color: var(--danger);
  font-size: 23rpx;
  text-align: center;
}

.sheet-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--mist);
}

.sheet-meta-compact {
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
}

.score-block {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-stars {
  color: var(--lamp);
  font-size: 25rpx;
}

.score-value {
  color: var(--ink);
  font-family: var(--font-data);
  font-size: 30rpx;
  font-weight: 800;
}

.meta-text,
.meta-separator {
  color: var(--muted);
  font-size: 21rpx;
}

.block-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.source-count {
  color: var(--lake);
  font-size: 20rpx;
}

.fact-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.fact-label {
  width: 130rpx;
  color: var(--muted);
  font-size: 22rpx;
  flex-shrink: 0;
}

.fact-value,
.summary-text,
.summary-empty {
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.6;
}

.summary-block {
  padding: 18rpx;
  border: 1rpx solid rgba(47, 127, 143, 0.2);
  border-radius: 16rpx;
  background: rgba(47, 127, 143, 0.06);
}

.summary-text,
.summary-empty {
  display: block;
  margin-top: 10rpx;
}

.summary-empty,
.posts-empty {
  color: var(--muted);
}

.posts-empty.error {
  color: var(--danger);
}

.posts-block .post-card {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  padding: 20rpx;
}

.posts-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-disabled);
  animation: map-loading-dot 1.2s ease-in-out infinite both;
}

.loading-dot:nth-child(2) { animation-delay: 0.14s; }
.loading-dot:nth-child(3) { animation-delay: 0.28s; }

/* ============ 评分汇总卡片 ============ */
.rating-summary-card {
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--mist);
}

.rating-score-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.rating-stars-lg {
  color: var(--lamp);
  font-size: 32rpx;
  line-height: 1;
}

.rating-score-lg {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.goto-detail-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(47, 127, 143, 0.22);
  flex-shrink: 0;
}

.goto-detail-btn-hover {
  background: var(--lake-dark);
}

.rating-summary-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.rating-summary-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.6;
}

.rating-summary-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
}

.rating-summary-loc-text {
  color: var(--muted);
  font-size: 21rpx;
}

/* ============ 我的评价卡片 ============ */
.my-review-card {
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--ink-divider);
  border-radius: 14rpx;
  background: #fefefe;
}

.review-section-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.review-main-btn {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(47, 127, 143, 0.2);
}

.review-main-btn.disabled {
  opacity: 0.55;
}

.btn-hover {
  opacity: 0.85;
}

.review-login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.review-login-hint {
  color: var(--muted);
  font-size: 22rpx;
  flex: 1;
}

.review-login-btn {
  display: inline-flex;
  align-items: center;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.my-review-summary {
  margin-top: 10rpx;
}

.review-author-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.review-author-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 600;
}

.rating-stars-inline {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.stars-sm {
  color: var(--lamp);
  font-size: 22rpx;
  line-height: 1;
}

.score-sm {
  color: var(--ink-sub);
  font-size: 21rpx;
  font-weight: 600;
}

.my-review-content,
.my-review-empty {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.6;
}

.my-review-empty {
  color: var(--muted);
}

.review-gate-text {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.star-selector-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.star-option {
  padding: 4rpx;
  line-height: 1;
}

.star-option-hover {
  transform: scale(1.08);
}

.star-char {
  color: var(--line);
  font-size: 40rpx;
  line-height: 1;
}

.star-option.active .star-char {
  color: var(--lamp);
}

.score-preview {
  margin-left: 8rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.review-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--ink-divider);
  border-radius: 12rpx;
  background: #fafcfb;
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
}

.review-textarea::placeholder {
  color: #9aa4a8;
}

.review-secondary-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 10rpx;
}

.review-text-btn {
  color: var(--lake);
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 4rpx;
}

.review-text-btn.danger {
  color: var(--danger);
}

.review-text-btn.disabled {
  opacity: 0.55;
}

@keyframes sheet-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes map-pulse {
  0%, 100% { opacity: 0.45; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes map-loading-dot {
  0%, 80%, 100% { transform: scale(0.55); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}
