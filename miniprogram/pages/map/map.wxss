.map-page {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100vh;
}

.map-header {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 10;
}

.school-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.school-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.school-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.locate-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.35);
}

.locate-icon {
  font-size: 32rpx;
}

.denied-tip {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  right: 20rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 243, 224, 0.96);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #ffe0b2;
  z-index: 10;
}

.denied-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.denied-text {
  flex: 1;
  font-size: 24rpx;
  color: #e65100;
  line-height: 1.4;
}

.info-card {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 40rpx;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.info-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.info-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-right: 16rpx;
}

.info-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.info-snippet {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.info-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.info-tag {
  padding: 4rpx 16rpx;
  background: #f0f4ff;
  color: #667eea;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.info-status {
  background: #e8f5e9;
  color: #2e7d32;
}

.info-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
}
