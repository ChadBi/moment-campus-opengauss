<view class="detail-page">
  <!-- 加载中：骨架屏（对齐 Web 端卡片结构） -->
  <view wx:if="{{loading && !post}}" class="loading-skeleton">
    <skeleton variant="block" height="520rpx" />
    <view class="sk-content-wrap">
      <skeleton variant="post-card" />
    </view>
    <view class="sk-content-wrap">
      <skeleton variant="block" height="180rpx" />
    </view>
    <view class="sk-content-wrap">
      <skeleton variant="block" height="320rpx" />
    </view>
  </view>

  <block wx:if="{{post}}">
    <!-- 图片轮播 -->
    <view wx:if="{{images.length > 0}}" class="swiper-wrap">
      <swiper
        class="swiper"
        indicator-dots="{{images.length > 1}}"
        autoplay="{{false}}"
        circular="{{images.length > 1}}"
        current="{{swiperCurrent}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{images}}" wx:key="*this">
          <image
            class="swiper-image"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            bindtap="onPreviewImage"
          />
        </swiper-item>
      </swiper>
      <view wx:if="{{images.length > 1}}" class="swiper-count">
        <text>{{swiperCurrent + 1}} / {{images.length}}</text>
      </view>
    </view>

    <!-- 标题 + 状态 -->
    <view class="content-card">
      <view class="title-row">
        <text class="post-title">{{post.title}}</text>
        <text class="post-status status-{{post.status}}">{{post.status}}</text>
      </view>

      <!-- 作者信息 -->
      <view class="author-row">
        <image
          class="author-avatar"
          src="{{post.author_avatar || '/assets/default-avatar.png'}}"
          mode="aspectFill"
        />
        <view class="author-meta">
          <view class="author-name-row">
            <text class="author-name">{{post.author_nickname || '匿名'}}</text>
            <text wx:if="{{post.is_verified}}" class="verified-badge">已认证</text>
          </view>
          <text class="post-time">{{post.created_at_text}}</text>
        </view>
        <view wx:if="{{post.category_name}}" class="category-tag cat-{{categoryClass}}">
          <text>{{post.category_name}}</text>
        </view>
      </view>

      <!-- 正文 -->
      <view class="post-content">
        <text>{{post.content}}</text>
      </view>

      <!-- 位置信息 -->
      <view wx:if="{{post.location_name}}" class="location-row">
        <icon name="map-pin" size="32rpx" color="#174d5e" />
        <text class="loc-text">{{post.location_name}}</text>
      </view>

      <!-- 联系方式（仅登录可见，后端对游客返回 null） -->
      <view wx:if="{{post.contact_info}}" class="contact-row">
        <icon name="phone" size="28rpx" color="#174d5e" />
        <text class="contact-label">联系方式</text>
        <text class="contact-value">{{post.contact_info}}</text>
      </view>

      <!-- 复制操作区 -->
      <view class="copy-actions">
        <view wx:if="{{post.location_address}}" class="copy-btn" bindtap="copyAddress" hover-class="copy-btn-hover" hover-stay-time="120">
          <icon name="map-pin" size="28rpx" color="#174d5e" />
          <text>复制地址</text>
        </view>
        <view class="copy-btn" bindtap="copyLink" hover-class="copy-btn-hover" hover-stay-time="120">
          <icon name="link" size="28rpx" color="#174d5e" />
          <text>复制链接</text>
        </view>
      </view>

      <!-- 倒计时 -->
      <view wx:if="{{remainingTime}}" class="countdown-row {{remainingTime === '已过期' ? 'expired' : ''}}">
        <icon
          wx:if="{{remainingTime === '已过期'}}"
          name="alert-circle"
          size="28rpx"
          color="#cd5852"
        />
        <icon
          wx:else
          name="clock"
          size="28rpx"
          color="#cc5f30"
        />
        <text class="countdown-text">{{remainingTime}}</text>
      </view>

      <!-- 浏览数 -->
      <view class="views-row">
        <icon name="eye" size="24rpx" color="#6a7d81" />
        <text>{{post.views_count_text}} 次浏览</text>
      </view>
    </view>

    <!-- 互动栏 -->
    <view class="action-bar">
      <view class="action-item {{isLiked ? 'active' : ''}}" bindtap="onLike" hover-class="action-item-hover" hover-stay-time="120">
        <icon
          name="heart"
          size="44rpx"
          color="{{isLiked ? '#e67340' : '#3d5458'}}"
        />
        <text class="action-text">{{post.likes_count_text}}</text>
      </view>
      <view class="action-item">
        <icon name="message-circle" size="44rpx" color="#3d5458" />
        <text class="action-text">{{post.comments_count_text}}</text>
      </view>
      <view class="action-item">
        <icon name="check-circle" size="44rpx" color="#3d5458" />
        <text class="action-text">{{post.validations_count_text}}</text>
      </view>
      <view class="action-item" bindtap="openReport" hover-class="action-item-hover" hover-stay-time="120">
        <icon name="alert-circle" size="44rpx" color="#3d5458" />
        <text class="action-text">举报</text>
      </view>
    </view>

    <!-- 协同验证区域 -->
    <view class="validation-card">
      <view class="card-title">
        <view class="title-left">
          <icon name="shield" size="36rpx" color="#174d5e" />
          <text>协同验证</text>
        </view>
        <text class="validity-badge validity-{{validityStatus}}">{{validityStatus}}</text>
      </view>
      <view class="validation-stats">
        <view class="stat-block confirm">
          <text class="stat-num">{{confirmationCount}}</text>
          <text class="stat-label">证实</text>
        </view>
        <view class="stat-block refute">
          <text class="stat-num">{{refutationCount}}</text>
          <text class="stat-label">证伪</text>
        </view>
        <view class="stat-block total">
          <text class="stat-num">{{totalValidationCount}}</text>
          <text class="stat-label">总计</text>
        </view>
      </view>
      <view class="validation-actions">
        <view
          class="validate-btn confirm {{userValidationType === 'confirmation' ? 'voted' : ''}}"
          data-type="confirmation"
          bindtap="onValidate"
          hover-class="validate-btn-hover"
          hover-stay-time="120"
        >
          <icon
            wx:if="{{userValidationType === 'confirmation'}}"
            name="check-circle"
            size="32rpx"
            color="#ffffff"
          />
          <text>{{userValidationType === 'confirmation' ? '已证实' : '证实'}}</text>
        </view>
        <view
          class="validate-btn refute {{userValidationType === 'refutation' ? 'voted' : ''}}"
          data-type="refutation"
          bindtap="onValidate"
          hover-class="validate-btn-hover"
          hover-stay-time="120"
        >
          <icon
            wx:if="{{userValidationType === 'refutation'}}"
            name="x"
            size="32rpx"
            color="#ffffff"
          />
          <text>{{userValidationType === 'refutation' ? '已证伪' : '证伪'}}</text>
        </view>
      </view>
    </view>

    <!-- 评论区 -->
    <view class="comments-card">
      <view class="card-title">
        <view class="title-left">
          <icon name="message-circle" size="36rpx" color="#174d5e" />
          <text>评论 {{comments.length > 0 ? commentsCount : ''}}</text>
        </view>
      </view>

      <empty-state
        wx:if="{{comments.length === 0 && !commentLoading}}"
        compact
        icon="message-square"
        title="暂无评论"
        hint="快来抢沙发吧"
      />

      <view wx:for="{{comments}}" wx:key="id" class="comment-item">
        <image
          class="comment-avatar"
          src="{{item.author_avatar || '/assets/default-avatar.png'}}"
          mode="aspectFill"
        />
        <view class="comment-body">
          <view class="comment-header">
            <view class="comment-author-row">
              <text class="comment-author">{{item.author_nickname || '匿名'}}</text>
              <text wx:if="{{item.is_verified}}" class="verified-badge">已认证</text>
            </view>
            <text class="comment-time">{{item.created_at_text}}</text>
          </view>
          <view class="comment-content">
            <text>{{item.content}}</text>
          </view>
          <view class="comment-action" data-id="{{item.id}}" data-nickname="{{item.author_nickname}}" bindtap="onReplyComment">
            <text>回复</text>
          </view>
        </view>
      </view>

      <view wx:if="{{commentLoading}}" class="comment-loading">
        <skeleton variant="list-item" />
        <skeleton variant="list-item" />
      </view>
      <view wx:if="{{commentHasMore && !commentLoading}}" class="load-more-comments" bindtap="onLoadMoreComments">
        <text>加载更多评论</text>
      </view>
    </view>

    <!-- 占位，避免被底部输入框遮挡 -->
    <view class="bottom-placeholder"></view>

    <!-- 评论输入框 -->
    <view class="comment-input-bar">
      <view wx:if="{{replyingTo}}" class="replying-tip">
        <text>回复 @{{replyingTo.nickname}}</text>
        <text class="cancel-reply" bindtap="cancelReply">取消</text>
      </view>
      <view class="input-row">
        <input
          class="comment-input"
          placeholder="写评论..."
          value="{{commentInput}}"
          confirm-type="send"
          bindinput="onCommentInput"
          bindconfirm="onSubmitComment"
        />
        <view class="send-btn {{commentInput ? 'active' : ''}}" bindtap="onSubmitComment" hover-class="send-btn-hover" hover-stay-time="120">
          <icon name="send" size="32rpx" color="{{commentInput ? '#ffffff' : '#9aabae'}}" />
        </view>
      </view>
    </view>
  </block>

  <!-- 举报弹层 -->
  <view wx:if="{{reportVisible}}" class="modal-mask" bindtap="closeReport">
    <view class="modal-content" catchtap="">
      <view class="modal-title">
        <view class="title-left">
          <icon name="alert-circle" size="36rpx" color="#174d5e" />
          <text>举报</text>
        </view>
        <view class="modal-close" bindtap="closeReport">
          <icon name="x" size="36rpx" color="#6a7d81" />
        </view>
      </view>
      <view class="report-types">
        <view
          wx:for="{{reportReasons}}"
          wx:key="value"
          class="report-type {{reportType === item.value ? 'active' : ''}}"
          data-type="{{item.value}}"
          bindtap="onPickReportType"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <textarea
        class="report-textarea"
        placeholder="请填写举报理由（必填）"
        value="{{reportReason}}"
        maxlength="200"
        bindinput="onReportReasonInput"
      />
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeReport" hover-class="modal-btn-hover" hover-stay-time="120">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm" bindtap="onSubmitReport" hover-class="modal-btn-hover" hover-stay-time="120">
          <text>{{submittingReport ? '提交中' : '提交'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
