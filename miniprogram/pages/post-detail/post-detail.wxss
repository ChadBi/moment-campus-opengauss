.detail-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ============== 加载骨架屏 ============== */
.loading-skeleton {
  padding: 0 0 20rpx;
}

.loading-skeleton .sk-content-wrap {
  padding: 0 24rpx;
  margin-top: 20rpx;
}

/* ============== 图片轮播 ============== */
.swiper-wrap {
  position: relative;
  width: 100%;
  background: var(--ink);
}

.swiper {
  width: 100%;
  height: 520rpx;
}

.swiper-image {
  width: 100%;
  height: 520rpx;
}

.swiper-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  background: rgba(21, 38, 41, 0.5);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: #fff;
  font-family: var(--font-data);
}

/* ============== 内容卡片 ============== */
.content-card {
  background: var(--paper);
  padding: 30rpx;
  margin: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.post-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  font-family: var(--font-display);
  color: var(--ink);
  line-height: 1.4;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.post-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 状态标签 .status-published / .status-pending / .status-draft /
   .status-expired / .status-conflict / .status-archived
   已在 app.wxss 全局定义，此处不再重复 */

/* 作者信息 */
.author-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--line);
  margin-right: 16rpx;
  border: 1rpx solid var(--ink-divider);
}

.author-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

/* B-06: 作者昵称行 + 已认证徽标 */
.author-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.verified-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.post-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  font-family: var(--font-data);
}

.category-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 正文 */
.post-content {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.75;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 位置 */
.location-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--lake);
  margin-bottom: 16rpx;
  padding: 10rpx 16rpx;
  background: var(--lake-light);
  border-radius: var(--radius-sm);
  align-self: flex-start;
}

.loc-text {
  font-size: 24rpx;
  color: var(--lake);
  font-weight: 500;
}

/* 倒计时 */
.countdown-row {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #f8efe0;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--lamp-dark);
  font-family: var(--font-data);
  font-weight: 600;
}

.countdown-row.expired {
  background: #f9ede7;
  color: var(--danger);
}

.countdown-text {
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

/* 浏览数 */
.views-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

/* ============== 互动栏 ============== */
.action-bar {
  display: flex;
  background: var(--paper);
  padding: 24rpx 30rpx;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 8rpx 0;
  border-radius: var(--radius-sm);
  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

.action-item.active {
  color: var(--lamp);
}

.action-item-hover {
  transform: scale(0.96);
  background: var(--paper-hover);
}

.action-text {
  font-size: 22rpx;
  font-family: var(--font-data);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ============== 协同验证卡片 ============== */
.validation-card {
  background: var(--paper);
  padding: 30rpx;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  font-family: var(--font-display);
  color: var(--ink);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.title-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.validity-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.validity-valid {
  background: #ebf2ed;
  color: var(--grass);
}

.validity-invalid {
  background: #f9ede7;
  color: var(--danger);
}

.validity-uncertain {
  background: #f8efe0;
  color: var(--lamp-dark);
}

.validation-stats {
  display: flex;
  margin-bottom: 24rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.stat-block.confirm {
  background: #ebf2ed;
}

.stat-block.refute {
  background: #f9ede7;
}

.stat-block.total {
  background: var(--mist);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  font-family: var(--font-data);
  color: var(--ink);
  line-height: 1;
}

.stat-block.confirm .stat-num {
  color: var(--grass);
}

.stat-block.refute .stat-num {
  color: var(--danger);
}

.stat-block.total .stat-num {
  color: var(--ink-2);
}

.stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  letter-spacing: 0.5rpx;
}

.validation-actions {
  display: flex;
  gap: 20rpx;
}

.validate-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  letter-spacing: 1rpx;
}

.validate-btn-hover {
  transform: scale(0.98);
}

.validate-btn.confirm {
  background: #ebf2ed;
  color: var(--grass);
  border-color: var(--grass);
}

.validate-btn.refute {
  background: #f9ede7;
  color: var(--danger);
  border-color: var(--danger);
}

.validate-btn.confirm.voted {
  background: var(--grass);
  color: #fff;
}

.validate-btn.refute.voted {
  background: var(--danger);
  color: #fff;
}

/* ============== 评论区 ============== */
.comments-card {
  background: var(--paper);
  padding: 30rpx;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
}

.empty-comments {
  text-align: center;
  padding: 60rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--line);
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--ink-divider);
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

/* B-06: 评论作者昵称行 + 已认证徽标 */
.comment-author-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.comment-time {
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

.comment-content {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  margin-bottom: 8rpx;
  word-break: break-word;
}

.comment-action {
  font-size: 22rpx;
  color: var(--lake);
  display: inline-block;
  padding: 4rpx 12rpx;
}

.comment-loading {
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.load-more-comments {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--lake);
  font-weight: 500;
}

/* ============== 底部输入框 ============== */
.bottom-placeholder {
  height: 140rpx;
}

.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--paper);
  border-top: 1rpx solid var(--ink-divider);
  padding: 16rpx 24rpx;
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(21, 38, 41, 0.04);
}

.replying-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--muted);
  padding: 6rpx 0 10rpx;
}

.cancel-reply {
  color: var(--lake);
  padding: 4rpx 12rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: var(--mist);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.send-btn {
  margin-left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--paper-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
              background 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

.send-btn.active {
  background: var(--lake);
  box-shadow: var(--shadow-lake);
}

.send-btn-hover {
  transform: scale(0.96);
}

/* ============== 举报弹层 ============== */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 38, 41, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  box-shadow: var(--shadow-lg);
}

.modal-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  font-family: var(--font-display);
  color: var(--ink);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
  border-radius: 50%;
}

.report-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.report-type {
  padding: 12rpx 24rpx;
  background: var(--mist);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  transition: background 200ms, color 200ms;
}

.report-type.active {
  background: var(--lake-light);
  color: var(--lake);
  border: 1rpx solid var(--lake);
  font-weight: 500;
}

.report-textarea {
  width: 100%;
  height: 180rpx;
  background: var(--mist);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  letter-spacing: 1rpx;
}

.modal-btn-hover {
  transform: scale(0.98);
}

.modal-btn.cancel {
  background: var(--mist);
  color: var(--ink-2);
}

.modal-btn.confirm {
  background: var(--lake);
  color: #fff;
  font-weight: 600;
}

/* ============== reduced motion 降级 ============== */
@media (prefers-reduced-motion: reduce) {
  .action-item,
  .validate-btn,
  .send-btn,
  .modal-btn {
    transition: none;
  }
}
