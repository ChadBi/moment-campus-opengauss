.bind-page {
  padding: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-title {
  text-align: center;
  padding: 40rpx 0;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.picker {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.error-msg {
  background: #ffebee;
  color: #c62828;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  opacity: 0.6;
}
