<view class="search-page">
  <!-- ============== 顶部搜索框（对齐 Web SearchPage: icon 搜索框 + lake 按钮） ============== -->
  <view class="search-header">
    <view class="search-input-wrap">
      <icon name="search" size="32rpx" color="#6a7d81" />
      <input
        class="search-input"
        type="text"
        placeholder="{{mode === 'ai' ? '用自然语言描述你想找的内容…' : '搜索关键词…'}}"
        placeholder-class="ph"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirmSearch"
      />
      <view wx:if="{{keyword}}" class="clear-btn" bindtap="onClearInput" hover-class="clear-btn-hover" hover-stay-time="120">
        <icon name="x" size="32rpx" color="#6a7d81" />
      </view>
    </view>
    <view class="search-btn {{searching ? 'disabled' : ''}}" bindtap="onSearch" hover-class="search-btn-hover" hover-stay-time="120">
      <text>{{searching ? '搜索中' : '搜索'}}</text>
    </view>
  </view>

  <!-- ============== 模式切换 Tab（对齐 Web: active 用 lake 背景 + 白字） ============== -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'normal' ? 'active' : ''}}" data-mode="normal" bindtap="onModeSwitch">
      <text>普通搜索</text>
    </view>
    <view class="mode-tab {{mode === 'ai' ? 'active' : ''}}" data-mode="ai" bindtap="onModeSwitch">
      <icon name="sparkles" size="24rpx" color="{{mode === 'ai' ? '#ffffff' : '#6a7d81'}}" />
      <text>AI 搜索</text>
    </view>
  </view>

  <!-- ============== 未搜索：历史 + 热门标签 ============== -->
  <view wx:if="{{!hasSearched}}" class="suggest-wrap">
    <view wx:if="{{history.length > 0}}" class="section">
      <view class="section-header">
        <view class="section-title-wrap">
          <icon name="clock" size="28rpx" color="#174d5e" />
          <text class="section-title">搜索历史</text>
        </view>
        <text class="section-action" bindtap="onClearHistory">清空</text>
      </view>
      <view class="tag-cloud">
        <view
          wx:for="{{history}}"
          wx:key="*this"
          class="tag tag-history"
          data-keyword="{{item}}"
          bindtap="onTagTap"
          hover-class="tag-hover"
          hover-stay-time="120"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{hotTags.length > 0}}" class="section">
      <view class="section-header">
        <view class="section-title-wrap">
          <icon name="sparkles" size="28rpx" color="#e67340" />
          <text class="section-title">热门标签</text>
        </view>
      </view>
      <view class="tag-cloud">
        <view
          wx:for="{{hotTags}}"
          wx:key="*this"
          class="tag tag-hot"
          data-keyword="{{item}}"
          bindtap="onTagTap"
          hover-class="tag-hot-hover"
          hover-stay-time="120"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{history.length === 0 && hotTags.length === 0}}" class="empty-suggest-wrap">
      <empty-state
        icon="search"
        title="输入关键词开始搜索"
        hint="{{mode === 'ai' ? 'AI 搜索支持自然语言查询' : '试试搜索校园里的经验'}}"
      />
      <view wx:if="{{mode === 'ai'}}" class="ai-tip">
        <icon name="sparkles" size="24rpx" color="#174d5e" />
        <view class="ai-tip-text">
          <text class="ai-tip-line">AI 搜索支持自然语言查询，例如：</text>
          <text class="ai-tip-example">"昨天图书馆丢失的校园卡"</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============== 搜索中：骨架屏（对齐 Web Loading） ============== -->
  <view wx:if="{{hasSearched && searching && results.length === 0}}" class="loading-skeleton">
    <view wx:if="{{mode === 'ai'}}" class="ai-skeleton">
      <view class="ai-skeleton-label"></view>
      <view class="ai-skeleton-line"></view>
      <view class="ai-skeleton-line ai-skeleton-short"></view>
    </view>
    <skeleton variant="post-card" />
    <skeleton variant="post-card" />
    <skeleton variant="post-card" />
  </view>

  <!-- ============== 搜索结果 ============== -->
  <view wx:if="{{hasSearched && !searching}}" class="results-wrap">
    <!-- AI 分析卡片（对齐 Web: bg-lake/10 + Sparkles icon） -->
    <view wx:if="{{mode === 'ai' && (aiIntent || aiReasons.length > 0)}}" class="ai-card">
      <view class="ai-card-header">
        <icon name="sparkles" size="28rpx" color="#174d5e" />
        <text class="ai-card-title">AI 分析</text>
      </view>
      <view wx:if="{{aiFallback}}" class="ai-fallback-tip">
        <icon name="alert-circle" size="24rpx" color="#cc5f30" />
        <text>{{aiFallbackReason || 'AI 暂不可用，已降级普通搜索'}}</text>
      </view>
      <view wx:if="{{aiIntent}}" class="ai-row">
        <text class="ai-label">意图分析</text>
        <text class="ai-intent">{{aiIntent}}</text>
      </view>
      <view wx:if="{{aiReasons.length > 0}}" class="ai-row">
        <text class="ai-label">匹配理由</text>
        <view class="ai-reasons">
          <view wx:for="{{aiReasons}}" wx:key="*this" class="ai-reason-item">
            <view class="reason-dot"></view>
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 结果统计 -->
    <view class="results-summary">
      <text>共 {{total}} 条结果</text>
    </view>

    <!-- 空结果（empty-state 组件） -->
    <view wx:if="{{results.length === 0}}" class="empty-result-wrap">
      <empty-state
        icon="search"
        title="没有找到相关内容"
        hint="换个关键词试试吧"
      />
    </view>

    <!-- 结果列表（对齐 Web post-card） -->
    <view
      wx:for="{{results}}"
      wx:key="id"
      class="post-card"
      data-id="{{item.id}}"
      bindtap="goToDetail"
      hover-class="post-card-hover"
      hover-stay-time="120"
    >
      <view class="post-header">
        <image
          class="author-avatar"
          src="{{item.author_avatar}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="author-info">
          <view class="author-name-row">
            <text class="author-name">{{item.author_nickname || '匿名'}}</text>
            <text wx:if="{{item.is_verified}}" class="verified-badge">已认证</text>
          </view>
          <text class="post-time">{{item.created_at_text}}</text>
        </view>
        <text class="post-status status-{{item.status}}">{{item.status}}</text>
      </view>

      <view class="post-body">
        <text class="post-title">{{item.title}}</text>
        <text class="post-content">{{item.content_brief}}</text>
      </view>

      <view wx:if="{{item.cover}}" class="post-cover">
        <image class="cover-image" src="{{item.cover}}" mode="aspectFill" lazy-load />
      </view>

      <view wx:if="{{item.location_name}}" class="post-location">
        <icon name="map-pin" size="24rpx" color="#2d6270" />
        <text class="loc-text">{{item.location_name}}</text>
      </view>

      <view wx:if="{{item.remaining_text}}" class="post-remaining">
        <icon name="clock" size="24rpx" color="#cc5f30" />
        <text class="remaining-text">{{item.remaining_text}}</text>
      </view>

      <!-- AI 单条匹配理由 -->
      <view wx:if="{{item.match_reasons && item.match_reasons.length > 0}}" class="match-reasons">
        <view wx:for="{{item.match_reasons}}" wx:for-item="reason" wx:key="*this" class="match-reason">
          <view class="reason-dot"></view>
          <text>{{reason}}</text>
        </view>
      </view>

      <view class="post-footer">
        <view class="stat-item">
          <icon name="heart" size="24rpx" color="#6a7d81" />
          <text class="stat-num">{{item.likes_count_text}}</text>
        </view>
        <view class="stat-item">
          <icon name="message-circle" size="24rpx" color="#6a7d81" />
          <text class="stat-num">{{item.comments_count_text}}</text>
        </view>
        <view class="stat-item">
          <icon name="check-circle" size="24rpx" color="#6a7d81" />
          <text class="stat-num">{{item.validations_count_text}}</text>
        </view>
        <view class="stat-item">
          <icon name="eye" size="24rpx" color="#6a7d81" />
          <text class="stat-num">{{item.views_count_text}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <skeleton variant="list-item" />
    </view>
    <view wx:if="{{!hasMore && results.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
