.search-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* ============== 顶部搜索框 ============== */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 20;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f0f0f0;
  border-radius: 36rpx;
  padding: 0 24rpx;
  position: relative;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #999;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  font-size: 28rpx;
  color: #bbb;
  padding: 0 8rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============== 模式切换 Tab ============== */
.mode-tabs {
  display: flex;
  background: #fff;
  padding: 0 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: color 0.2s;
}

.mode-tab.active {
  color: #667eea;
  font-weight: 600;
}

.mode-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 3rpx;
}

/* ============== 历史/热门标签 ============== */
.suggest-wrap {
  padding: 20rpx 30rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-action {
  font-size: 24rpx;
  color: #999;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  background: #fff;
  color: #555;
  border: 1rpx solid #eee;
}

.tag-history {
  background: #f7f7f7;
  color: #666;
}

.tag-hot {
  background: #fff3e0;
  color: #e65100;
  border-color: #ffe0b2;
}

/* ============== 空提示 ============== */
.empty-suggest {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-suggest-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-suggest-text {
  color: #999;
  font-size: 28rpx;
}

.ai-tip {
  margin-top: 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(118, 75, 162, 0.08));
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.ai-tip-example {
  color: #667eea;
  font-weight: 600;
}

/* ============== 加载状态 ============== */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ============== 结果区 ============== */
.results-wrap {
  padding: 20rpx 30rpx;
}

.results-summary {
  padding: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* ============== AI 分析卡片 ============== */
.ai-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(118, 75, 162, 0.08));
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.ai-fallback-tip {
  background: #fff3e0;
  color: #e65100;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.ai-row {
  margin-bottom: 16rpx;
}

.ai-row:last-child {
  margin-bottom: 0;
}

.ai-label {
  display: inline-block;
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-weight: 600;
}

.ai-intent {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.ai-reasons {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-reason-item {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

/* ============== 空结果 ============== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #666;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  color: #aaa;
  font-size: 24rpx;
}

/* ============== 帖子卡片 ============== */
.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e0e0e0;
  margin-right: 16rpx;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-published {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-pending {
  background: #fff3e0;
  color: #e65100;
}

.status-expired {
  background: #fce4ec;
  color: #c62828;
}

.status-conflict {
  background: #ffebee;
  color: #d32f2f;
}

.status-archived {
  background: #f5f5f5;
  color: #757575;
}

.status-draft {
  background: #e3f2fd;
  color: #1565c0;
}

.post-body {
  margin-bottom: 16rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  display: block;
  margin-bottom: 8rpx;
}

.post-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-cover {
  margin-bottom: 16rpx;
}

.cover-image {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.post-location {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #667eea;
  margin-bottom: 16rpx;
}

.loc-icon {
  margin-right: 6rpx;
}

/* ============== 单条 AI 匹配理由 ============== */
.match-reasons {
  background: rgba(102, 126, 234, 0.06);
  border-left: 4rpx solid #667eea;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.match-reason {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

/* ============== 互动统计 ============== */
.post-footer {
  display: flex;
  gap: 24rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 24rpx;
  color: #888;
}

/* ============== 加载更多 ============== */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #aaa;
  font-size: 24rpx;
}
