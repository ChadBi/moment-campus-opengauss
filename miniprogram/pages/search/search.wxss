/* ============================================================
 * 搜索页 - 水墨风（对齐 Web SearchPage.tsx）
 * icon 搜索框 + lake 按钮 + 骨架屏 + empty-state + post-card
 * ============================================================ */

.search-page {
  min-height: 100vh;
  background: var(--mist);
  padding-bottom: 60rpx;
}

/* ============== 顶部搜索框 ============== */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--paper);
  position: sticky;
  top: 0;
  z-index: 20;
  box-shadow: var(--shadow-sm);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  background: var(--mist);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  transition: border-color 0.2s;
}

.search-input-wrap:focus-within {
  border-color: var(--lake);
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.ph {
  color: var(--ink-disabled);
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 50%;
}

.clear-btn-hover {
  background: var(--paper-hover);
}

.search-btn {
  margin-left: 20rpx;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--lake);
  color: #ffffff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.15s;
}

.search-btn-hover {
  transform: scale(0.98);
}

.search-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

/* ============== 模式切换 Tab（对齐 Web: active 用 lake 背景 + 白字） ============== */
.mode-tabs {
  display: flex;
  gap: 16rpx;
  background: var(--paper);
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  background: var(--mist);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.mode-tab.active {
  background: var(--lake);
  color: #ffffff;
  font-weight: 600;
  border-color: var(--lake);
  box-shadow: var(--shadow-lake);
}

/* ============== 历史/热门标签 ============== */
.suggest-wrap {
  padding: 30rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-action {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--paper-hover);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  background: var(--paper);
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  transition: transform 0.15s;
}

.tag-hover {
  transform: scale(0.96);
  background: var(--paper-hover);
}

.tag-history {
  background: var(--paper-hover);
  color: var(--ink-2);
  border-color: var(--ink-divider);
}

.tag-hot {
  background: var(--lake-light);
  color: var(--lake);
  border-color: var(--lake-light);
  font-weight: 500;
}

.tag-hot-hover {
  transform: scale(0.96);
}

/* ============== 空提示（empty-state 容器） ============== */
.empty-suggest-wrap {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-tip {
  margin-top: 40rpx;
  padding: 24rpx;
  background: rgba(23, 77, 94, 0.06);
  border: 1rpx solid rgba(23, 77, 94, 0.15);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 90%;
  box-sizing: border-box;
}

.ai-tip-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-tip-line {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.ai-tip-example {
  color: var(--lake);
  font-weight: 600;
  font-size: 26rpx;
}

/* ============== 搜索中：骨架屏 ============== */
.loading-skeleton {
  padding: 30rpx;
}

.loading-skeleton skeleton {
  display: block;
  margin-bottom: 20rpx;
  background: var(--paper);
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.ai-skeleton {
  background: rgba(23, 77, 94, 0.06);
  border: 1rpx solid rgba(23, 77, 94, 0.15);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.ai-skeleton-label {
  width: 120rpx;
  height: 32rpx;
  background: var(--ink-divider);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.ai-skeleton-line {
  width: 100%;
  height: 24rpx;
  background: var(--ink-divider);
  border-radius: var(--radius-sm);
  margin-bottom: 12rpx;
}

.ai-skeleton-short {
  width: 60%;
  margin-bottom: 0;
}

/* ============== 结果区 ============== */
.results-wrap {
  padding: 20rpx 30rpx;
}

.results-summary {
  padding: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* ============== AI 分析卡片（对齐 Web: bg-lake/10 + Sparkles icon） ============== */
.ai-card {
  background: rgba(23, 77, 94, 0.06);
  border: 1rpx solid rgba(23, 77, 94, 0.3);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.ai-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(23, 77, 94, 0.15);
}

.ai-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lake);
}

.ai-fallback-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--paper-alt);
  color: var(--lamp-dark);
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.ai-row {
  margin-bottom: 20rpx;
}

.ai-row:last-child {
  margin-bottom: 0;
}

.ai-label {
  display: inline-block;
  font-size: 22rpx;
  color: var(--lake);
  background: var(--paper);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.ai-intent {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  display: block;
}

.ai-reasons {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-reason-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.reason-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--lake);
  margin-top: 14rpx;
  flex-shrink: 0;
}

/* ============== 空结果（empty-state 容器） ============== */
.empty-result-wrap {
  padding: 40rpx 0;
}

/* ============== 帖子卡片（对齐 Web post-card） ============== */
.post-card {
  background: var(--paper);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s;
}

.post-card-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--paper-hover);
  margin-right: 16rpx;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

/* B-06: 作者昵称行 + 已认证徽标 */
.author-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.verified-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.post-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.post-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.status-published {
  background: #ebf2ed;
  color: #639b69;
}

.status-pending {
  background: #f8efe0;
  color: #cf9335;
}

.status-expired {
  background: #ebf0f7;
  color: #5878a6;
}

.status-conflict {
  background: #f9ede7;
  color: #cd5852;
}

.status-archived {
  background: #edf1f2;
  color: #9aabae;
}

.status-draft {
  background: #edf1f2;
  color: #6a7d81;
}

.post-body {
  margin-bottom: 16rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-cover {
  margin-bottom: 16rpx;
}

.cover-image {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-sm);
  background: var(--ink-divider);
}

.post-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--lake-2);
  margin-bottom: 16rpx;
}

/* ============== 单条 AI 匹配理由 ============== */
.match-reasons {
  background: rgba(23, 77, 94, 0.06);
  border-left: 4rpx solid var(--lake);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.match-reason {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* ============== 互动统计（icon + DIN 数字，对齐 Web post-card） ============== */
.post-footer {
  display: flex;
  gap: 28rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ink-divider);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 24rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

/* ============== 加载更多 ============== */
.loading-more {
  padding: 20rpx 0;
}

.loading-more skeleton {
  display: block;
  background: var(--paper);
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: var(--muted);
  font-size: 24rpx;
}
