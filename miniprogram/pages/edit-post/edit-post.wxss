@import "../publish/publish.wxss";

/* ============== 编辑页容器 ============== */
.edit-post-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 0 160rpx;
}

/* ============== 加载 / 错误 ============== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid #e0e0e0;
  border-top: 5rpx solid #667eea;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.error-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
}

/* ============== 回审提示 ============== */
.review-tip {
  padding: 16rpx 30rpx;
  text-align: center;
}

.review-tip-text {
  font-size: 24rpx;
  color: #ff9800;
}

/* ============== 底部操作栏（单按钮满宽） ============== */
.action-btn.full {
  flex: 1;
}

.action-btn.btn-primary.full {
  width: 100%;
}
