<view class="publish-page">

  <!-- 分类选择 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">分类</text>
      <text class="required">*</text>
    </view>
    <scroll-view class="category-scroll" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view wx:if="{{loadingCategories && categories.length === 0}}" class="cat-loading">加载中...</view>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-tag {{selectedCategoryId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap">
        <text wx:if="{{item.icon}}" class="cat-icon">{{item.icon}}</text>
        <text class="cat-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 标题 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">标题</text>
      <text class="required">*</text>
    </view>
    <view class="input-wrap">
      <input
        class="title-input"
        type="text"
        placeholder="一句话说清核心信息（最多50字）"
        placeholder-class="ph"
        maxlength="{{titleMaxLen}}"
        value="{{title}}"
        bindinput="onTitleInput" />
      <text class="counter">{{title.length}}/{{titleMaxLen}}</text>
    </view>
  </view>

  <!-- 正文 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">正文</text>
    </view>
    <view class="input-wrap">
      <textarea
        class="content-input"
        placeholder="描述详细情况、时间、地点、经过等（最多2000字）"
        placeholder-class="ph"
        maxlength="{{contentMaxLen}}"
        value="{{content}}"
        bindinput="onContentInput"
        auto-height="true"
        disable-default-padding="true" />
      <text class="counter">{{content.length}}/{{contentMaxLen}}</text>
    </view>
  </view>

  <!-- 图片 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">图片</text>
      <text class="label-hint">最多 {{maxImages}} 张，每张不超过 5MB</text>
    </view>
    <view class="image-grid">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="image-item">
        <image
          class="preview-img"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="onPreviewImage" />
        <view
          class="remove-btn"
          data-index="{{index}}"
          catchtap="onRemoveImage">
          <text class="remove-icon">×</text>
        </view>
      </view>
      <view
        wx:if="{{images.length < maxImages}}"
        class="upload-btn {{uploadingImage ? 'uploading' : ''}}"
        bindtap="onChooseImage">
        <view wx:if="{{uploadingImage}}" class="upload-spinner"></view>
        <block wx:else>
          <text class="upload-icon">+</text>
          <text class="upload-text">上传</text>
        </block>
      </view>
    </view>
  </view>

  <!-- 位置 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">位置</text>
      <text class="label-hint">可选</text>
    </view>
    <view class="location-card">
      <block wx:if="{{hasLocation}}">
        <view class="location-info">
          <text class="location-icon">📍</text>
          <text class="location-name text-ellipsis">{{locationName}}</text>
        </view>
        <view class="location-actions">
          <text class="loc-action" bindtap="onChooseLocation">更换</text>
          <text class="loc-action danger" bindtap="onClearLocation">移除</text>
        </view>
      </block>
      <block wx:else>
        <view class="location-empty" bindtap="onChooseLocation">
          <text class="location-icon">📍</text>
          <text class="location-placeholder">选择位置（可选）</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 有效期 -->
  <view class="section">
    <view class="section-label">
      <text class="label-text">有效期</text>
    </view>
    <view class="expiry-wrap">
      <picker
        class="expiry-picker"
        mode="selector"
        range="{{expiryOptions}}"
        value="{{expiryIndex}}"
        bindchange="onExpiryChange">
        <view class="picker-value">
          <text>{{expiryOptions[expiryIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <view wx:if="{{isCustomExpiry}}" class="custom-days-wrap">
        <input
          class="custom-days-input"
          type="number"
          placeholder="天数"
          placeholder-class="ph"
          value="{{customDays}}"
          bindinput="onCustomDaysInput" />
        <text class="custom-days-suffix">天</text>
      </view>
    </view>
  </view>

  <!-- 草稿提示 -->
  <view wx:if="{{draftRestored}}" class="draft-tip" bindtap="onClearDraft">
    <text class="draft-tip-text">已恢复草稿，点击此处清空</text>
  </view>

  <!-- AI 助手 -->
  <view class="ai-section">
    <view class="ai-btn {{aiLoading ? 'loading' : ''}}" bindtap="onAiSuggest">
      <view wx:if="{{aiLoading}}" class="ai-spinner"></view>
      <text wx:else class="ai-icon">✨</text>
      <text>{{aiLoading ? 'AI分析中...' : 'AI助手'}}</text>
    </view>

    <!-- AI 建议结果 -->
    <view wx:if="{{showAiSuggestion && aiSuggestion}}" class="ai-result-card">
      <view class="ai-result-header">
        <text class="ai-result-title">AI 建议结果</text>
        <text class="ai-close" bindtap="onCloseAiSuggestion">×</text>
      </view>

      <!-- 降级提示 -->
      <view wx:if="{{aiSuggestion.fallback}}" class="ai-fallback-tip">
        <text>{{aiSuggestion.fallback_reason || 'AI建议已降级，以下为基本分析'}}</text>
      </view>

      <!-- 结构化建议 -->
      <block wx:if="{{aiSuggestion.suggestions}}">
        <view wx:if="{{aiSuggestion.suggestions.title}}" class="ai-suggest-item">
          <text class="ai-item-label">建议标题</text>
          <text class="ai-item-value">{{aiSuggestion.suggestions.title}}</text>
        </view>
        <view wx:if="{{aiSuggestion.suggestions.summary}}" class="ai-suggest-item">
          <text class="ai-item-label">内容摘要</text>
          <text class="ai-item-value">{{aiSuggestion.suggestions.summary}}</text>
        </view>
        <view wx:if="{{aiSuggestion.suggestions.category}}" class="ai-suggest-item">
          <text class="ai-item-label">建议分类</text>
          <text class="ai-item-value">{{aiSuggestion.suggestions.category}}</text>
        </view>
        <view wx:if="{{aiSuggestion.suggestions.tags.length > 0}}" class="ai-suggest-item">
          <text class="ai-item-label">建议标签</text>
          <view class="ai-tags">
            <text wx:for="{{aiSuggestion.suggestions.tags}}" wx:key="*this" class="ai-tag">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{aiSuggestion.suggestions.default_validity_days}}" class="ai-suggest-item">
          <text class="ai-item-label">建议有效期</text>
          <text class="ai-item-value">{{aiSuggestion.suggestions.default_validity_days}} 天</text>
        </view>
      </block>

      <!-- 遗漏信息 -->
      <view wx:if="{{aiSuggestion.missing_info.length > 0}}" class="ai-block ai-missing">
        <text class="ai-block-title">补充建议</text>
        <view wx:for="{{aiSuggestion.missing_info}}" wx:key="*this" class="ai-list-item">
          <text class="ai-bullet">•</text>
          <text class="ai-list-text">{{item}}</text>
        </view>
      </view>

      <!-- 敏感信息提醒 -->
      <view wx:if="{{aiSuggestion.sensitive_warnings.length > 0}}" class="ai-block ai-warning">
        <text class="ai-block-title">⚠️ 敏感信息提醒</text>
        <view wx:for="{{aiSuggestion.sensitive_warnings}}" wx:key="*this" class="ai-list-item">
          <text class="ai-bullet">•</text>
          <text class="ai-list-text">{{item}}</text>
        </view>
      </view>

      <!-- 一键应用 -->
      <view wx:if="{{aiSuggestion.suggestions}}" class="ai-apply-btn" bindtap="onApplyAiSuggestion">
        <text>一键应用建议</text>
      </view>
    </view>
  </view>

  <!-- 占位高度，避免按钮挡住内容 -->
  <view class="bottom-placeholder"></view>
</view>

<!-- 底部操作栏 -->
<view class="action-bar">
  <view class="action-btn btn-secondary" bindtap="onClearDraft">
    <text>清空</text>
  </view>
  <view
    class="action-btn btn-primary {{submitting ? 'disabled' : ''}}"
    bindtap="onSubmit">
    <text wx:if="{{submitting}}" class="btn-loading"></text>
    <text>{{submitting ? '发布中...' : '发布'}}</text>
  </view>
</view>
