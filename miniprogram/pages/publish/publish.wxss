/* ============================================================
 * 发布页 - 水墨风（对齐 Web PublishPage.tsx）
 * 分类色板圆点 + icon 上传/删除 + lake AI 按钮
 * ============================================================ */

.publish-page {
  min-height: 100vh;
  /* 操作栏位于自定义 TabBar 上方，页面底部需同时预留两层固定元素空间。 */
  padding: 0 0 calc(320rpx + env(safe-area-inset-bottom));
}

/* ============== 通用 Section ============== */
.section {
  background: var(--paper);
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.section-label {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-display);
  color: var(--ink);
}

.required {
  color: var(--danger);
  margin-left: 6rpx;
  font-size: 28rpx;
}

.label-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: 14rpx;
}

.ph {
  color: var(--ink-disabled);
}

/* ============== 分类选择（对齐 Web: 分类色板圆点） ============== */
.category-scroll {
  white-space: nowrap;
}

.cat-loading {
  display: inline-block;
  width: 280rpx;
  padding: 0;
}

.cat-loading skeleton {
  display: block;
}

.cat-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: var(--mist);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  transition: all 0.2s;
}

.cat-tag-hover {
  transform: scale(0.96);
}

.cat-tag.active {
  color: #ffffff;
  background: var(--lake);
  border-color: var(--lake);
  font-weight: 600;
  box-shadow: var(--shadow-lake);
}

/* 分类色板圆点（对齐 Web: cat-X main color） */
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: currentColor;
  flex-shrink: 0;
}

/* 激活态下圆点保持原色（覆盖 currentColor 继承） */
.cat-tag.active .cat-dot {
  background: #ffffff;
  opacity: 0.85;
}

.cat-name {
  font-size: 26rpx;
}

/* ============== 输入框 ============== */
.input-wrap {
  position: relative;
}

.title-input {
  width: 100%;
  height: 80rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--ink-divider);
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 18rpx 0 40rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  border-bottom: 1rpx solid var(--ink-divider);
}

.counter {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  font-size: 22rpx;
  color: var(--ink-disabled);
  font-family: var(--font-data);
}

/* ============== 图片网格（对齐 Web: icon 上传 + icon 删除） ============== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--mist);
  border: 1rpx solid var(--line);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(21, 38, 41, 0.55);
  border-radius: 0 var(--radius-sm) 0 var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--paper);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.upload-btn-hover {
  background: var(--paper-hover);
  border-color: var(--lake);
}

.upload-btn:active {
  background: var(--paper-hover);
  border-color: var(--muted);
}

.upload-btn.uploading {
  opacity: 0.6;
}

.upload-text {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.upload-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--line);
  border-top: 4rpx solid var(--lake);
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
}

@keyframes publish-spin {
  to { transform: rotate(360deg); }
}

/* ============== 位置卡片（对齐 Web: icon map-pin） ============== */
.location-card {
  background: var(--paper-hover);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-right: 20rpx;
}

.location-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  min-width: 0;
}

.location-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.loc-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--lake);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--paper);
  transition: background 0.2s;
}

.loc-action-hover {
  background: var(--mist);
}

.loc-action.danger {
  color: var(--danger);
}

.location-empty {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-empty-hover {
  opacity: 0.7;
}

.anonymous-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 30rpx 20rpx;
}

.anonymous-label {
  font-size: 26rpx;
  color: var(--ink);
}

.anonymous-label.disabled {
  color: var(--muted);
}

.anonymous-hint {
  margin-left: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.location-placeholder {
  font-size: 28rpx;
  color: var(--muted);
}

/* ============== 有效期（对齐 Web: icon chevron-down） ============== */
.expiry-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.expiry-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 26rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--ink);
}

.custom-days-wrap {
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  height: 80rpx;
}

.custom-days-input {
  width: 120rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--ink);
  text-align: center;
}

.custom-days-suffix {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-left: 6rpx;
}

/* ============== 草稿提示 ============== */
.draft-tip {
  padding: 16rpx 30rpx;
  text-align: center;
}

.draft-tip-text {
  font-size: 24rpx;
  color: var(--muted);
}

/* ============== 底部占位 ============== */
.bottom-placeholder {
  height: 24rpx;
}

/* ============== 底部操作栏 ============== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  /* TabBar 高度约为 152rpx（含上下留白），避免提交按钮被其覆盖。 */
  bottom: calc(152rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 30rpx;
  background: var(--paper);
  box-shadow: 0 -2rpx 12rpx rgba(21, 38, 41, 0.06);
  /* bottom 已包含 TabBar 的安全区，操作栏内部不再重复叠加安全区。 */
  padding-bottom: 18rpx;
  z-index: 1000;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.action-btn-hover {
  transform: scale(0.98);
}

.action-btn.btn-secondary {
  flex: 0 0 200rpx;
  background: var(--paper-hover);
  color: var(--ink-2);
}

.action-btn.btn-primary {
  background: var(--lake);
  color: #ffffff;
  box-shadow: var(--shadow-lake);
}

.action-btn.btn-primary.disabled {
  opacity: 0.7;
}

.btn-loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-top: 3rpx solid #ffffff;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
  margin-right: 12rpx;
}

/* ============== AI 助手（对齐 Web: Sparkles icon + lake 背景） ============== */
.ai-section {
  background: var(--paper);
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.ai-btn-hover {
  transform: scale(0.98);
}

.ai-btn:active {
  opacity: 0.85;
}

.ai-btn.loading {
  opacity: 0.7;
}

.ai-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top: 3rpx solid #ffffff;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
}

/* AI 结果卡片 */
.ai-result-card {
  margin-top: 20rpx;
  background: rgba(23, 77, 94, 0.04);
  border: 1rpx solid rgba(23, 77, 94, 0.2);
  border-radius: var(--radius-md);
  padding: 24rpx 26rpx;
}

.ai-result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(23, 77, 94, 0.12);
}

.ai-result-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ai-result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lake);
}

.ai-close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 50%;
}

.ai-close-hover {
  background: var(--paper-hover);
}

.ai-fallback-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--paper-alt);
  border-radius: var(--radius-sm);
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--lamp-dark);
}

.ai-suggest-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.ai-suggest-item:last-child {
  border-bottom: none;
}

.ai-item-label {
  flex: 0 0 140rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.ai-item-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

.ai-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ai-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 22rpx;
  border-radius: 20rpx;
}

.ai-block {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-sm);
}

.ai-block.ai-missing {
  background: var(--lake-light);
}

.ai-block.ai-warning {
  background: #f9ede7;
}

.ai-block-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.ai-list-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 6rpx 0;
}

.ai-bullet-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--lake);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.ai-bullet-dot-danger {
  background: var(--danger);
}

.ai-list-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.ai-apply-btn {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
}

.ai-apply-btn-hover {
  transform: scale(0.98);
  opacity: 0.9;
}
