.publish-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 0 160rpx;
}

/* ============== 通用 Section ============== */
.section {
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.section-label {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.required {
  color: #e53935;
  margin-left: 6rpx;
  font-size: 28rpx;
}

.label-hint {
  font-size: 22rpx;
  color: #999;
  margin-left: 14rpx;
}

.ph {
  color: #bbb;
}

/* ============== 分类选择 ============== */
.category-scroll {
  white-space: nowrap;
}

.cat-loading {
  display: inline-block;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #999;
}

.cat-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.2s;
}

.cat-tag.active {
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.cat-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.cat-name {
  font-size: 26rpx;
}

/* ============== 输入框 ============== */
.input-wrap {
  position: relative;
}

.title-input {
  width: 100%;
  height: 80rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #222;
  border-bottom: 1rpx solid #f0f0f0;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 18rpx 0 40rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.counter {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* ============== 图片网格 ============== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 0 12rpx 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #c5c5c5;
  border-radius: 12rpx;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.upload-btn:active {
  background: #f0f0f0;
  border-color: #999;
}

.upload-btn.uploading {
  opacity: 0.6;
}

.upload-icon {
  font-size: 56rpx;
  color: #999;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.upload-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
}

@keyframes publish-spin {
  to { transform: rotate(360deg); }
}

/* ============== 位置卡片 ============== */
.location-card {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-info {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  margin-right: 20rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.location-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
}

.location-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.loc-action {
  font-size: 26rpx;
  color: #667eea;
  padding: 6rpx 12rpx;
}

.loc-action.danger {
  color: #e53935;
}

.location-empty {
  flex: 1;
  display: flex;
  align-items: center;
}

.location-placeholder {
  font-size: 28rpx;
  color: #999;
}

/* ============== 有效期 ============== */
.expiry-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.expiry-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 26rpx;
  background: #fafafa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.custom-days-wrap {
  display: flex;
  align-items: center;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.custom-days-input {
  width: 120rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.custom-days-suffix {
  font-size: 26rpx;
  color: #666;
  margin-left: 6rpx;
}

/* ============== 草稿提示 ============== */
.draft-tip {
  padding: 16rpx 30rpx;
  text-align: center;
}

.draft-tip-text {
  font-size: 24rpx;
  color: #999;
}

/* ============== 底部占位 ============== */
.bottom-placeholder {
  height: 20rpx;
}

/* ============== 底部操作栏 ============== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.action-btn.btn-secondary {
  flex: 0 0 200rpx;
  background: #f5f5f5;
  color: #666;
}

.action-btn.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.action-btn.btn-primary.disabled {
  opacity: 0.7;
}

.action-btn:active {
  transform: translateY(2rpx);
}

.btn-loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-top: 3rpx solid #fff;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
  margin-right: 12rpx;
}

/* ============== AI 助手 ============== */
.ai-section {
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
}

.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #e0e7ff, #f3e8ff);
  color: #5b67e8;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.ai-btn:active {
  transform: scale(0.98);
  opacity: 0.85;
}

.ai-btn.loading {
  opacity: 0.7;
}

.ai-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.ai-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #c7d2fe;
  border-top: 3rpx solid #5b67e8;
  border-radius: 50%;
  animation: publish-spin 0.8s linear infinite;
  margin-right: 12rpx;
}

/* AI 结果卡片 */
.ai-result-card {
  margin-top: 20rpx;
  background: #fafbff;
  border: 1rpx solid #e8ecff;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
}

.ai-result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.ai-result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.ai-close {
  font-size: 36rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.ai-fallback-tip {
  background: #fff7e6;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #d97706;
}

.ai-suggest-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f2ff;
}

.ai-suggest-item:last-child {
  border-bottom: none;
}

.ai-item-label {
  flex: 0 0 140rpx;
  font-size: 24rpx;
  color: #999;
}

.ai-item-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.ai-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ai-tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  background: #eef2ff;
  color: #5b67e8;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.ai-block {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
}

.ai-block.ai-missing {
  background: #f0f9ff;
}

.ai-block.ai-warning {
  background: #fef2f2;
}

.ai-block-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 8rpx;
}

.ai-list-item {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0;
}

.ai-bullet {
  color: #999;
  margin-right: 8rpx;
  font-size: 24rpx;
}

.ai-list-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.ai-apply-btn {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(102, 126, 234, 0.3);
}

.ai-apply-btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}
