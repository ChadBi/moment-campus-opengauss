/* ============================================================
 * 订阅管理页 - 水墨风
 * ============================================================ */

.subscriptions-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ============== 顶部 Tab ============== */
.tab-header {
  display: flex;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
  position: sticky;
  top: 0;
  z-index: 20;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--muted);
  position: relative;
  transition: all 0.2s;
}

.tab-item-hover {
  background: var(--paper-hover);
}

.tab-item.active {
  color: var(--lake);
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  background: var(--lake);
  border-radius: var(--radius-sm);
}

/* ============== 通用骨架屏 / 空状态 ============== */
.loading-skeleton {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

/* ============== 已订阅列表 ============== */
.sub-list {
  background: var(--paper);
  margin-top: 16rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.sub-item:last-child {
  border-bottom: none;
}

.sub-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--lake);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
}

.sub-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.sub-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 380rpx;
}

.sub-type {
  font-size: 22rpx;
  color: var(--lake);
  background: var(--lake-light);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  font-weight: 500;
}

.sub-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

.sub-cancel {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--danger);
  color: var(--danger);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: all 0.2s;
}

.sub-cancel-hover {
  background: rgba(205, 88, 82, 0.08);
}

/* ============== 分类列表（添加订阅） ============== */
.category-list {
  background: var(--paper);
  margin-top: 16rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
  transition: background 0.2s;
}

.category-item:last-child {
  border-bottom: none;
}

.category-item-hover {
  background: var(--paper-hover);
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--lake-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.category-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.category-desc {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.4;
}

.category-action {
  padding: 12rpx 32rpx;
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.category-action.is-subscribed {
  background: var(--paper-hover);
  color: var(--muted);
  font-weight: 400;
  box-shadow: none;
}

/* 文本省略 */
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
