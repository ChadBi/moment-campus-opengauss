<view class="subscriptions-page">
  <!-- 顶部 Tab 切换 -->
  <view class="tab-header">
    <view
      class="tab-item {{activeTab === 'subscribed' ? 'active' : ''}}"
      data-key="subscribed"
      bindtap="onTabTap"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <text>已订阅</text>
    </view>
    <view
      class="tab-item {{activeTab === 'add' ? 'active' : ''}}"
      data-key="add"
      bindtap="onTabTap"
      hover-class="tab-item-hover"
      hover-stay-time="120">
      <text>添加订阅</text>
    </view>
  </view>

  <!-- 已订阅列表 -->
  <view wx:if="{{activeTab === 'subscribed'}}" class="sub-list">
    <!-- 骨架屏 -->
    <view wx:if="{{loadingSubscriptions && subscriptions.length === 0}}" class="loading-skeleton">
      <skeleton variant="list-item" />
      <skeleton variant="list-item" />
      <skeleton variant="list-item" />
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{subscriptions.length === 0}}" class="empty-result-wrap">
      <empty-state
        icon="bell"
        title="暂无订阅"
        hint="切换到「添加订阅」关注感兴趣的分类"
      />
    </view>

    <!-- 订阅项 -->
    <view
      wx:for="{{subscriptions}}"
      wx:key="id"
      class="sub-item">
      <view class="sub-icon">
        <icon name="{{item.type_icon}}" size="36rpx" color="#ffffff" />
      </view>
      <view class="sub-body">
        <view class="sub-title-row">
          <text class="sub-name">{{item.target_name}}</text>
          <text class="sub-type">{{item.type_label}}</text>
        </view>
        <view class="sub-time">
          <icon name="clock" size="20rpx" color="#6a7d81" />
          <text>订阅于 {{item.created_at_text}}</text>
        </view>
      </view>
      <view
        class="sub-cancel"
        data-id="{{item.id}}"
        bindtap="onCancelSubscription"
        hover-class="sub-cancel-hover"
        hover-stay-time="120">
        <text>{{togglingId === item.id ? '处理中...' : '取消'}}</text>
      </view>
    </view>
  </view>

  <!-- 添加订阅（分类列表） -->
  <view wx:if="{{activeTab === 'add'}}" class="category-list">
    <!-- 骨架屏 -->
    <view wx:if="{{loadingCategories && categories.length === 0}}" class="loading-skeleton">
      <skeleton variant="list-item" />
      <skeleton variant="list-item" />
      <skeleton variant="list-item" />
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{categories.length === 0}}" class="empty-result-wrap">
      <empty-state
        icon="file-text"
        title="暂无可订阅分类"
        hint="分类内容敬请期待"
      />
    </view>

    <!-- 分类项 -->
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{item.subscribed ? 'subscribed' : ''}}"
      data-id="{{item.id}}"
      bindtap="onToggleCategory"
      hover-class="category-item-hover"
      hover-stay-time="120">
      <view class="category-icon">
        <icon name="{{item.icon}}" size="36rpx" color="#174d5e" />
      </view>
      <view class="category-body">
        <text class="category-name">{{item.name}}</text>
        <text wx:if="{{item.description}}" class="category-desc text-ellipsis-2">{{item.description}}</text>
      </view>
      <view class="category-action {{item.subscribed ? 'is-subscribed' : ''}}">
        <text wx:if="{{item.subscribed}}">{{togglingId === item.id ? '处理中...' : '已订阅'}}</text>
        <text wx:else>{{togglingId === item.id ? '处理中...' : '订阅'}}</text>
      </view>
    </view>
  </view>
</view>
