<view class="topic-detail-page">
  <!-- 加载状态：骨架屏 -->
  <view wx:if="{{loading}}" class="loading-skeleton">
    <skeleton variant="list-item" />
    <skeleton variant="list-item" />
    <skeleton variant="list-item" />
  </view>

  <block wx:if="{{topic}}">
    <!-- 顶部专题封面 -->
    <view class="topic-header">
      <view wx:if="{{coverImage}}" class="topic-cover">
        <image class="cover-img" src="{{coverImage}}" mode="aspectFill" />
      </view>
      <view class="topic-meta-wrap">
        <text class="topic-title">{{topic.title}}</text>
        <text wx:if="{{topic.description}}" class="topic-desc">{{topic.description}}</text>
        <view class="topic-meta">
          <view class="meta-item meta-count">
            <icon name="file-text" size="24rpx" color="#174d5e" />
            <text>{{postCountText}} 篇</text>
          </view>
          <view wx:if="{{createdAtText}}" class="meta-item meta-time">
            <icon name="clock" size="24rpx" color="#6a7d81" />
            <text>{{createdAtText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 关联帖子标题 -->
    <view class="section-title">
      <text>关联帖子</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty-result-wrap">
      <empty-state
        icon="file-text"
        title="暂无关联帖子"
        hint="该专题还没有帖子"
      />
    </view>

    <!-- 关联帖子列表：使用 post-card 组件 -->
    <view class="post-list">
      <post-card
        wx:for="{{posts}}"
        wx:key="id"
        post="{{item}}"
        bind:tap="onPostTap"/>
    </view>
  </block>
</view>
