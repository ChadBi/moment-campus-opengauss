.topic-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部专题封面 */
.topic-header {
  position: relative;
  background: #fff;
  overflow: hidden;
}

.topic-cover {
  width: 100%;
  height: 360rpx;
  background: #f0f0f0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.topic-meta-wrap {
  padding: 30rpx;
  background: #fff;
}

.topic-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
  display: block;
}

.topic-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.topic-meta {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 28rpx;
}

/* 关联帖子标题 */
.section-title {
  padding: 30rpx 30rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

/* 帖子列表 */
.post-list {
  padding: 0 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}
