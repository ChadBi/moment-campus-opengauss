/* ============================================================
 * 个人中心 - 水墨风样式
 * 对齐 app.wxss 设计 token（墨青 / 宣纸 / 朱砂）
 * ============================================================ */

.profile-page {
  min-height: 100vh;
  background: var(--mist);
  padding-bottom: 220rpx;
}

/* ============== 用户信息卡片（对齐 Web ProfilePage: bg-gradient-to-br from-lake to-lake-light） ============== */
.user-card {
  background: linear-gradient(135deg, var(--lake) 0%, var(--lake-light) 100%);
  padding: 40rpx 30rpx 50rpx;
  color: #ffffff;
  position: relative;
}

.user-row {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  background: var(--lake-dark);
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 16rpx;
  font-family: var(--font-display);
}

/* B-06: 顶部昵称旁「已认证」徽标（深色渐变背景上的白字变体） */
.verified-badge-header {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: var(--radius-sm);
}

.email {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.bio {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.5;
}

.bio-empty {
  color: rgba(255, 255, 255, 0.7);
}

.meta-line {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-label {
  margin-right: 10rpx;
}

.user-actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  color: #ffffff;
}

.action-bell {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  color: #ffffff;
}

.action-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.action-bell .action-icon {
  margin-right: 0;
}

/* ============== 统计卡片 ============== */
.stats-card {
  margin: -30rpx 30rpx 0;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 统计卡 icon 框（对齐 Web ProfilePage: w-7 h-7 rounded-[8px] bg-mist） */
.stat-icon-box {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mist);
  border-radius: 16rpx;
  margin-bottom: 10rpx;
}

.stat-icon-published { background: var(--lake-light); }
.stat-icon-draft { background: var(--paper-hover); }
.stat-icon-pending { background: rgba(219, 179, 82, 0.15); }
.stat-icon-confirm { background: rgba(115, 160, 104, 0.15); }

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  font-family: var(--font-data);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--ink-divider);
}

/* ============== 加入的学校模块（对齐 Web ProfilePage D2） ============== */
.schools-section {
  margin: 30rpx 30rpx 0;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.schools-section .section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-display);
  margin-left: 12rpx;
}

.section-count {
  font-size: 22rpx;
  color: var(--muted);
  background: var(--mist);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}

.empty-membership {
  padding: 50rpx 30rpx;
  text-align: center;
}

.empty-membership .empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}

.empty-membership .empty-hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}

.membership-list {
  padding: 12rpx 30rpx 20rpx;
}

.membership-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.membership-card:last-child {
  border-bottom: none;
}

.membership-card.current {
  background: linear-gradient(90deg, var(--lake-light) 0%, transparent 100%);
  margin: 0 -30rpx;
  padding: 24rpx 30rpx;
}

.membership-info {
  flex: 1;
  min-width: 0;
}

.membership-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.membership-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 16rpx;
}

.default-badge,
.current-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: 12rpx;
}

.default-badge {
  color: var(--sun);
  background: rgba(219, 179, 82, 0.15);
}

.current-badge {
  color: var(--lake);
  background: var(--lake-light);
}

.membership-meta {
  font-size: 22rpx;
  color: var(--muted);
}

.membership-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-switch,
.action-default {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md);
  margin-left: 12rpx;
}

.action-switch {
  color: var(--lake);
  background: var(--lake-light);
}

.action-default {
  color: var(--muted);
  background: var(--mist);
}

.action-switch:active,
.action-default:active {
  opacity: 0.7;
}

/* ============== 校园身份认证（对齐 Web CampusVerifyCard，B-06） ============== */
.verify-section {
  margin: 30rpx 30rpx 0;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.verify-section .section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.verify-card-badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.verify-body {
  padding: 24rpx 30rpx 30rpx;
}

.verify-desc {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

/* 已认证态 */
.verify-done {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx;
  background: rgba(115, 160, 104, 0.06);
  border: 1rpx solid rgba(115, 160, 104, 0.2);
  border-radius: var(--radius-md);
}

.verify-done-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.verify-done-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.verify-done-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 发送验证码按钮 */
.verify-send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: var(--lake);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.verify-send-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

.verify-send-btn.disabled {
  opacity: 0.6;
}

/* 演示环境验证码提示 */
.verify-devcode {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  background: var(--lake-light);
  border: 1rpx solid rgba(23, 77, 94, 0.2);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--lake);
  margin-bottom: 20rpx;
}

.verify-devcode-val {
  font-weight: 700;
  letter-spacing: 4rpx;
  font-family: var(--font-data);
}

.verify-devcode-hint {
  font-size: 20rpx;
  color: var(--muted);
}

/* 确认认证 / 返回修改 */
.verify-actions {
  display: flex;
  gap: 16rpx;
}

.verify-confirm-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: var(--lake);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.verify-confirm-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

.verify-confirm-btn.disabled {
  opacity: 0.6;
}

.verify-back-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  background: var(--paper-hover);
  color: var(--ink-2);
  font-size: 28rpx;
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.verify-back-btn-hover {
  background: var(--mist);
  transform: scale(0.98);
}

/* ============== 我的帖子 / 历史区域 ============== */
.posts-section {
  margin: 30rpx 30rpx 0;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 分区切换 Tab */
.section-tabs {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.section-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  position: relative;
  transition: all 0.2s;
}

.section-tab.active {
  color: var(--lake);
  font-weight: 700;
}

.section-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--lake);
  border-radius: 3rpx;
}

/* 状态筛选 Tab */
.status-tabs {
  white-space: nowrap;
  padding: 20rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.status-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--mist);
  border-radius: var(--radius-lg);
  transition: all 0.2s;
}

.status-tab.active {
  color: #ffffff;
  background: var(--lake);
  font-weight: 600;
}

.post-list {
  padding: 16rpx 30rpx 8rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--ink-divider);
  border-top: 4rpx solid var(--lake);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--muted);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  color: var(--ink-divider);
  font-family: var(--font-display);
  font-weight: 700;
}

.empty-text {
  color: var(--muted);
  font-size: 28rpx;
}

.post-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.post-card:last-child {
  border-bottom: none;
}

.post-top {
  margin-bottom: 16rpx;
}

.post-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.post-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

/* 状态标签：底色与文字色由 app.wxss 中 .status-* 提供 */
.post-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  flex-shrink: 0;
}

.post-content {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.post-cover {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  background: var(--mist);
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.post-time {
  font-size: 22rpx;
  color: var(--muted);
}

.post-stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.stat-pill {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-left: 16rpx;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

/* ============== 浏览历史 ============== */
.history-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.history-count {
  font-size: 24rpx;
  color: var(--muted);
}

.clear-history-btn {
  padding: 10rpx 24rpx;
  background: #fbeae9;
  color: var(--danger);
  border: 1rpx solid #f0d2d0;
  border-radius: var(--radius-lg);
  font-size: 24rpx;
}

.clear-history-btn.disabled {
  background: var(--mist);
  color: var(--ink-disabled);
  border-color: var(--ink-divider);
}

.history-list {
  padding: 16rpx 30rpx 8rpx;
}

.history-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.history-card:last-child {
  border-bottom: none;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.history-category {
  font-size: 22rpx;
  color: var(--lake);
  background: var(--lake-light);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  margin-right: 16rpx;
}

.history-time {
  font-size: 22rpx;
  color: var(--muted);
}

.history-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--mist);
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-delete:active {
  background: #fbeae9;
  color: var(--danger);
}

/* ============== 设置区域 ============== */
.settings-section {
  margin: 30rpx 30rpx 0;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-icon {
  font-size: 24rpx;
  margin-right: 20rpx;
  min-width: 72rpx;
  text-align: center;
  color: var(--lake);
  background: var(--lake-light);
  border-radius: var(--radius-sm);
  padding: 6rpx 12rpx;
  font-weight: 500;
  box-sizing: content-box;
}

.settings-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.settings-arrow {
  font-size: 36rpx;
  color: var(--ink-disabled);
}

.settings-item.danger .settings-label {
  color: var(--danger);
}

.settings-item.danger .settings-icon {
  color: var(--danger);
  background: #fbeae9;
}

/* 退出登录主按钮（btn-primary 但用 danger 底色） */
.settings-item.btn-primary {
  background: var(--danger);
  border: none;
  border-radius: var(--radius-md);
  margin: 24rpx 30rpx 12rpx;
  padding: 26rpx 30rpx;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(205, 88, 82, 0.22);
}

.settings-item.btn-primary .settings-label {
  color: #ffffff;
  font-weight: 600;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.settings-item.btn-primary .settings-icon,
.settings-item.btn-primary .settings-arrow {
  display: none;
}

/* ============== 弹出层 ============== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(21, 38, 41, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-container {
  width: 86%;
  max-width: 640rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.popup-container.popup-lg {
  width: 92%;
  max-width: 700rpx;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--font-display);
}

.popup-close {
  font-size: 36rpx;
  color: var(--muted);
  padding: 0 8rpx;
}

.popup-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.popup-loading,
.popup-empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--muted);
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--mist);
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background: var(--mist);
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.popup-footer {
  display: flex;
  border-top: 1rpx solid var(--ink-divider);
}

.popup-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
}

.btn-cancel {
  color: var(--ink-2);
  border-right: 1rpx solid var(--ink-divider);
}

.btn-confirm {
  color: var(--lake);
  font-weight: 600;
}

/* 身份列表 */
.identity-list {
  display: flex;
  flex-direction: column;
}

.identity-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.identity-item:last-child {
  border-bottom: none;
}

.identity-info {
  flex: 1;
  min-width: 0;
}

.identity-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.identity-type {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--lake);
  margin-right: 16rpx;
  padding: 6rpx 16rpx;
  background: var(--lake-light);
  border-radius: var(--radius-sm);
}

.identity-key {
  font-size: 26rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-meta {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

.identity-action {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--danger);
  color: var(--danger);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 会话列表 */
.session-list {
  display: flex;
  flex-direction: column;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.session-item:last-child {
  border-bottom: none;
}

.session-info {
  flex: 1;
  min-width: 0;
}

.session-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.session-type {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--lake);
  margin-right: 16rpx;
  padding: 6rpx 16rpx;
  background: var(--lake-light);
  border-radius: var(--radius-sm);
}

.session-current {
  font-size: 22rpx;
  color: var(--grass);
  border: 1rpx solid var(--grass);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.session-device {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session-meta {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

.session-action {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--danger);
  color: var(--danger);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.session-action-disabled {
  border-color: var(--ink-disabled);
  color: var(--ink-disabled);
}

/* ============== 底部 tab bar（对齐 Web MobileNav: 浮动 bg-lake/95 + 4 项均分 grid + 激活态 bg-paper text-lake） ============== */
.tab-bar {
  position: fixed;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
  height: 110rpx;
  background: rgba(23, 77, 94, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-lg);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  padding: 6rpx;
  box-shadow: 0 16rpx 64rpx rgba(20, 55, 63, 0.25);
  z-index: 100;
}

.bar-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: var(--radius-md);
  transition: background 0.2s;
}

.bar-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.bar-tab.active {
  background: var(--paper);
}

.bar-tab.active .bar-label {
  color: var(--lake);
  font-weight: 600;
}
