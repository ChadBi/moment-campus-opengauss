.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* ============== 用户信息卡片 ============== */
.user-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 40rpx 30rpx 50rpx;
  color: #fff;
}

.user-row {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #ddd;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
}

.email {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.bio {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.5;
}

.bio-empty {
  color: rgba(255, 255, 255, 0.7);
}

.meta-line {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-label {
  margin-right: 10rpx;
}

.user-actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
}

.action-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.action-bell {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-bell .action-icon {
  margin-right: 0;
}

/* ============== 统计卡片 ============== */
.stats-card {
  margin: -30rpx 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* ============== 我的帖子 ============== */
.posts-section {
  margin-top: 30rpx;
  background: #fff;
}

.section-title-row {
  padding: 24rpx 30rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.status-tabs {
  white-space: nowrap;
  padding: 0 20rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 28rpx;
  transition: all 0.2s;
}

.status-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  font-weight: 600;
}

.post-list {
  padding: 16rpx 30rpx 8rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

.post-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.post-top {
  margin-bottom: 16rpx;
}

.post-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.post-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.post-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #999;
  flex-shrink: 0;
}

.status-draft { background: #aaa; }
.status-pending { background: #f0a020; }
.status-published { background: #52c41a; }
.status-expired { background: #999; }
.status-conflict { background: #ff4d4f; }
.status-archived { background: #b0b0b0; }

.post-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.post-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #f0f0f0;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
}

.post-stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.stat-pill {
  font-size: 22rpx;
  color: #888;
  margin-left: 16rpx;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* ============== 设置区域 ============== */
.settings-section {
  margin-top: 30rpx;
  background: #fff;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.settings-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.settings-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.settings-item.danger .settings-label {
  color: #ff4d4f;
}

.settings-item.danger .settings-icon {
  color: #ff4d4f;
}

/* ============== 弹出层 ============== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-container {
  width: 86%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.popup-container.popup-lg {
  width: 92%;
  max-width: 700rpx;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.popup-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.popup-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.popup-loading,
.popup-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.popup-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.popup-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
}

.btn-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  color: #667eea;
  font-weight: 600;
}

/* 身份列表 */
.identity-list {
  display: flex;
  flex-direction: column;
}

.identity-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.identity-item:last-child {
  border-bottom: none;
}

.identity-info {
  flex: 1;
  min-width: 0;
}

.identity-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.identity-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  padding: 4rpx 16rpx;
  background: #eef0ff;
  color: #667eea;
  border-radius: 8rpx;
}

.identity-key {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.identity-meta {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.identity-action {
  padding: 12rpx 24rpx;
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
  border-radius: 28rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 会话列表 */
.session-list {
  display: flex;
  flex-direction: column;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.session-item:last-child {
  border-bottom: none;
}

.session-info {
  flex: 1;
  min-width: 0;
}

.session-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.session-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  padding: 4rpx 16rpx;
  background: #eef0ff;
  color: #667eea;
  border-radius: 8rpx;
}

.session-current {
  font-size: 22rpx;
  color: #52c41a;
  border: 1rpx solid #52c41a;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.session-device {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session-meta {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.session-action {
  padding: 12rpx 24rpx;
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
  border-radius: 28rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.session-action-disabled {
  border-color: #ccc;
  color: #ccc;
}

/* ============== 底部 tab bar ============== */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.bar-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 10rpx 0;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #999;
}

.bar-tab.active .bar-label {
  color: #667eea;
  font-weight: 600;
}

.bar-publish {
  position: relative;
}

.publish-btn {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -30rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.4);
}

.publish-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.publish-label {
  margin-top: 4rpx;
}
