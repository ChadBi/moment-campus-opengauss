<view class="login-page {{step === 'phone' ? 'form-mode' : ''}}">
  <view class="brand-area">
    <view class="brand-logo"><image class="brand-logo-image" src="/assets/logo.png" mode="aspectFit" /></view>
    <text class="brand-title">{{step === 'wechat' ? '欢迎回来' : '绑定手机'}}</text>
    <text class="brand-slogan">{{step === 'wechat' ? '微信登录，已绑定账号将直接进入' : '首次登录需要绑定手机号'}}</text>
  </view>
  <view class="login-card">
    <view wx:if="{{step === 'wechat'}}" class="wechat-login">
      <button class="wechat-btn {{wechatLoading ? 'disabled' : ''}}" bindtap="onWechatLogin" disabled="{{wechatLoading}}" hover-class="wechat-btn-hover">
        <icon name="message-circle" size="32rpx" color="#ffffff" />
        <text>{{wechatLoading ? '微信登录中...' : '微信登录'}}</text>
      </button>
      <view class="login-tip"><text>已绑定微信账号将直接登录，新用户需要绑定手机号</text></view>
    </view>

    <view wx:else class="phone-bind-form">
      <view class="form-item school-field">
        <text class="field-label">选择学校</text>
        <view wx:if="{{schoolLoading}}" class="input-wrap school-picker school-picker-disabled">
          <icon name="school" size="30rpx" color="#6a7d81" />
          <text class="school-picker-value placeholder">学校列表加载中...</text>
        </view>
        <view wx:elif="{{schools.length === 0}}" class="input-wrap school-picker" bindtap="loadSchools">
          <icon name="school" size="30rpx" color="#6a7d81" />
          <text class="school-picker-value placeholder">加载失败，点击重试</text>
        </view>
        <picker wx:else mode="selector" range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
          <view class="input-wrap school-picker">
            <icon name="school" size="30rpx" color="#174d5e" />
            <text class="school-picker-value">{{selectedSchoolName}}</text>
            <icon name="chevron-down" size="24rpx" color="#6a7d81" />
          </view>
        </picker>
        <text class="school-binding-tip">新账号将绑定所选学校，登录后只能在个人主页切换</text>
      </view>

      <view class="form-item">
        <view class="input-wrap">
          <icon name="phone" size="30rpx" color="#6a7d81" />
          <input class="form-input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="onPhoneInput" />
        </view>
      </view>

      <view class="form-item sms-row">
        <view class="input-wrap sms-input-wrap">
          <icon name="message-circle" size="30rpx" color="#6a7d81" />
          <input class="form-input" type="number" maxlength="6" value="{{smsCode}}" placeholder="6 位短信验证码" placeholder-class="ph" bindinput="onSmsCodeInput" />
        </view>
        <button class="sms-code-btn {{sendingCode || countdown > 0 ? 'disabled' : ''}}" bindtap="onSendSms" disabled="{{sendingCode || countdown > 0}}">
          {{sendingCode ? '发送中' : (countdown > 0 ? countdown + 's' : '获取验证码')}}
        </button>
      </view>

      <button class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="onSubmitWechatSmsLogin" disabled="{{loading}}" hover-class="submit-btn-hover">
        {{loading ? '绑定登录中...' : '绑定手机号并登录'}}
      </button>
      <view class="login-tip"><text>首次使用将自动创建未认证账号</text></view>
    </view>

    <view wx:if="{{errorMsg}}" class="error-msg login-error"><icon name="alert-circle" size="24rpx" color="#cd5852" /><text>{{errorMsg}}</text></view>
  </view>
  <view class="guest-link" bindtap="goToHome" hover-class="guest-link-hover" hover-stay-time="120"><icon name="arrow-left" size="24rpx" color="#6a7d81" /><text>以访客身份继续浏览</text></view>
</view>
