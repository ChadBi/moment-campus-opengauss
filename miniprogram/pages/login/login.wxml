<view class="login-page">
  <view class="brand-area">
    <view class="brand-logo"><image class="brand-logo-image" src="/assets/logo.png" mode="aspectFit" /></view>
    <text class="brand-title">欢迎回来</text>
    <text class="brand-slogan">微信登录，手机号就是你的账号</text>
  </view>
  <view class="login-card">
    <view class="wechat-login">
      <button class="wechat-btn {{loading ? 'disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{loading}}">
        <icon name="message-circle" size="32rpx" color="#ffffff" />
        <text>{{loading ? '登录中...' : '微信登录并授权手机号'}}</text>
      </button>
      <view class="login-tip"><text>首次登录自动创建账号，登录后即可浏览</text></view>
      <view wx:if="{{errorMsg}}" class="error-msg"><icon name="alert-circle" size="24rpx" color="#cd5852" /><text>{{errorMsg}}</text></view>
    </view>
  </view>
  <view class="guest-link" bindtap="goToHome" hover-class="guest-link-hover" hover-stay-time="120"><icon name="arrow-left" size="24rpx" color="#6a7d81" /><text>以访客身份继续浏览</text></view>
</view>
