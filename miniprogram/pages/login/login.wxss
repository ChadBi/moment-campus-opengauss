/* ============================================================
 * 登录页 - 水墨风（对齐 Web LoginPage.tsx）
 * 品牌区 + 微信会话初始化 + 手机号短信绑定 + 访客浏览
 * ============================================================ */

.login-page {
  min-height: 100vh;
  padding: 120rpx 60rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.login-page.form-mode {
  padding-top: 72rpx;
}

.login-page.form-mode .brand-area {
  margin-bottom: 40rpx;
}

/* ============== 品牌区（对齐 Web LoginPage: brand-logo + 欢迎回来 + slogan） ============== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: #e8f3f4;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.brand-logo-image {
  width: 160rpx;
  height: 160rpx;
  margin: -16rpx;
}

.brand-title {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--lake);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: var(--muted);
}

/* ============== 卡片容器 ============== */
.login-card {
  background: var(--paper);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx 56rpx;
  box-shadow: var(--shadow);
}

.login-tabs {
  display: flex;
  background: var(--paper-hover);
  border-radius: var(--radius-sm);
  padding: 8rpx;
  margin-bottom: 48rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-sm);
  color: var(--muted);
  font-size: 28rpx;
  transition: all 0.3s;
}

.tab.active {
  background: var(--paper);
  color: var(--lake);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* ============== 微信登录 ============== */
.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: var(--grass);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.15s;
}

.wechat-btn-hover {
  transform: scale(0.98);
}

.wechat-btn.disabled {
  opacity: 0.6;
}

.login-tip {
  text-align: center;
  margin-top: 28rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.wechat-ready {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 36rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(63, 125, 98, 0.2);
  border-radius: var(--radius-md);
  background: rgba(63, 125, 98, 0.08);
}

.wechat-ready-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wechat-ready-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
}

.wechat-ready-tip {
  color: var(--muted);
  font-size: 22rpx;
}

.change-wechat {
  color: var(--lake);
  font-size: 23rpx;
}

.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sms-input-wrap {
  flex: 1;
  min-width: 0;
}

.sms-code-btn {
  flex: 0 0 190rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--lake);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--lake);
  font-size: 25rpx;
  line-height: 1;
}

.sms-code-btn.disabled {
  border-color: var(--line);
  color: var(--muted);
  opacity: 0.75;
}

.login-error {
  margin-top: 24rpx;
  margin-bottom: 0;
}

/* ============== 登录辅助样式 ============== */
.form-item {
  margin-bottom: 28rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--mist);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 88rpx;
  transition: border-color 0.2s;
}

.input-wrap:focus-within {
  border-color: var(--lake);
}

.form-input {
  flex: 1;
  height: 100%;
  background: transparent;
  font-size: 30rpx;
  color: var(--ink);
}

.pwd-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-left: 8rpx;
  transition: background 0.15s;
}

.pwd-toggle-hover {
  background: rgba(23, 77, 94, 0.08);
}

.ph {
  color: var(--ink-disabled);
}

.error-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(205, 88, 82, 0.08);
  color: var(--danger);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: var(--lake);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
  transition: transform 0.15s;
}

.submit-btn-hover {
  transform: scale(0.98);
}

.submit-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.form-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  font-size: 26rpx;
}

.link-register {
  color: var(--lake);
  font-weight: 500;
}

.link-forgot {
  color: var(--muted);
}

/* ============== 访客浏览入口 ============== */
.guest-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 48rpx;
  padding: 24rpx 0;
  color: var(--muted);
  font-size: 26rpx;
  transition: color 0.2s;
}

.guest-link-hover {
  color: var(--lake);
}

/* ============== 绑定并登录副按钮 & 分割线 ============== */
.submit-btn-secondary {
  background: transparent;
  color: var(--lake);
  border: 2rpx solid var(--lake);
  box-shadow: none;
  margin-top: 16rpx;
}

.bind-info-text {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  margin: 32rpx 10rpx 20rpx;
}

.divider-or {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 10rpx;
}
.divider-or .line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}
.divider-or .divider-text {
  color: var(--muted);
  font-size: 22rpx;
  padding: 0 6rpx;
}
