.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 100rpx 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 120rpx;
}

.app-name {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #fff;
  color: #667eea;
  font-weight: 600;
}

.wechat-login, .email-login {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 100rpx;
  background: #07c160;
  border-radius: 50rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.wechat-btn.disabled {
  opacity: 0.6;
}

.wechat-icon {
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.login-tip {
  text-align: center;
  margin-top: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.error-msg {
  background: #ffebee;
  color: #c62828;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.register-link {
  text-align: center;
  margin-top: 40rpx;
  color: #667eea;
  font-size: 28rpx;
}
