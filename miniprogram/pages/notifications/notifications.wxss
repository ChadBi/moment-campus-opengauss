/* ============================================================
 * 通知页 - 水墨风
 * ============================================================ */

.notifications-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ============== 顶部操作栏 ============== */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: var(--paper);
  position: sticky;
  top: 0;
  z-index: 20;
  box-shadow: var(--shadow-sm);
}

.unread-info {
  flex: 1;
}

.unread-text {
  font-size: 28rpx;
  color: var(--lake);
  font-weight: 600;
}

.unread-text-empty {
  color: var(--muted);
  font-weight: 400;
}

.mark-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.mark-all-btn-hover {
  background: var(--lake-dark, #0f3a47);
  transform: scale(0.97);
}

.mark-all-btn.disabled {
  background: var(--paper-hover);
  color: var(--ink-disabled);
  box-shadow: none;
}

/* ============== 类型筛选 Tab ============== */
.type-tabs {
  white-space: nowrap;
  background: var(--paper);
  padding: 12rpx 20rpx 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
  position: sticky;
  top: 96rpx;
  z-index: 19;
}

.type-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper-hover);
  border-radius: var(--radius-md);
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.type-tab-hover {
  background: var(--ink-divider);
}

.type-tab.active {
  color: #fff;
  background: var(--lake);
  font-weight: 600;
  border-color: var(--lake);
  box-shadow: var(--shadow-lake);
}

/* ============== 通知列表 ============== */
.notification-list {
  padding: 16rpx 0;
}

/* 骨架屏 */
.loading-skeleton {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

/* 通知项 */
.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 30rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
  position: relative;
  transition: background 0.2s;
}

.notification-item-hover {
  background: var(--paper-hover);
}

.notification-item.unread {
  background: var(--lake-light);
}

.notification-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: transparent;
}

.notification-item.unread::before {
  background: var(--lake);
}

/* 头像：按类型上色 */
.noti-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  color: #ffffff;
}

.noti-avatar.type-comment { background: var(--lake); }
.noti-avatar.type-like { background: var(--lamp); }
.noti-avatar.type-validation { background: var(--grass); }
.noti-avatar.type-report { background: var(--danger); }
.noti-avatar.type-system { background: var(--sun); }

.noti-body {
  flex: 1;
  min-width: 0;
}

.noti-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.noti-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.notification-item.unread .noti-title {
  color: var(--lake);
}

/* 未读标记 */
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--lamp);
  flex-shrink: 0;
}

.noti-content {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.noti-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.noti-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  color: #fff;
  background: var(--muted);
  font-weight: 500;
}

.type-comment { background: var(--lake); }
.type-like { background: var(--lamp); }
.type-validation { background: var(--grass); }
.type-report { background: var(--danger); }
.type-system { background: var(--sun); }

.noti-time {
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

.noti-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-disabled);
  flex-shrink: 0;
  margin-left: 12rpx;
  border-radius: 50%;
  transition: all 0.2s;
}

.noti-delete-hover {
  background: rgba(205, 88, 82, 0.12);
  color: var(--danger);
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.loading-spinner-sm {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--ink-divider);
  border-top: 3rpx solid var(--lake);
  border-radius: 50%;
  animation: noti-spin 0.8s linear infinite;
}

@keyframes noti-spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--ink-disabled);
  font-size: 24rpx;
}
