/* ============================================================
 * 绑定/注册账号页 - 水墨风（全量改造自灰色风）
 * ============================================================ */

.bind-page {
  padding: 40rpx 30rpx 60rpx;
  background: var(--paper-alt);
  min-height: 100vh;
}

/* ============== 顶部标题区 ============== */
.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 48rpx;
}

.header-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--lake-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

/* ============== 表单分区 ============== */
.form-section {
  background: var(--paper);
  border-radius: var(--radius-lg);
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.label {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--paper-alt);
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color 0.2s;
}

.input:focus {
  border-color: var(--lake);
}

.ph {
  color: var(--ink-disabled);
}

/* ============== Picker ============== */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: var(--paper-alt);
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink-disabled);
  transition: all 0.2s;
}

.picker.has-value {
  color: var(--ink);
}

/* ============== 错误提示 ============== */
.error-msg {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(205, 88, 82, 0.1);
  border: 1rpx solid rgba(205, 88, 82, 0.3);
  color: var(--danger);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* ============== 提交按钮 ============== */
.submit-btn {
  background: var(--lake);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.submit-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

.submit-btn.disabled {
  background: var(--paper-hover);
  color: var(--ink-disabled);
  box-shadow: none;
}

.mode-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  min-height: 40rpx;
}

.mode-switch-label {
  color: var(--muted);
  line-height: 40rpx;
  vertical-align: middle;
}

.mode-switch-link {
  color: var(--lake);
  font-weight: 600;
  line-height: 40rpx;
  vertical-align: middle;
}
