<view class="bind-page">
  <!-- 顶部标题区 -->
  <view class="page-header">
    <view class="header-icon">
      <icon name="{{mode === 'bind' ? 'log-in' : 'user'}}" size="56rpx" color="#174d5e" />
    </view>
    <text class="page-title">{{mode === 'bind' ? '绑定已有账号' : '注册新账号'}}</text>
    <text class="page-subtitle">{{mode === 'bind' ? '使用已有账号密码完成微信绑定' : '使用教育邮箱完成注册并绑定微信'}}</text>
  </view>

  <!-- 注册和绑定共用一个连续表单容器，避免表单被切成多个突出的卡片 -->
  <view class="form-section">
    <!-- 注册模式：昵称 + 学校 -->
    <block wx:if="{{mode === 'register'}}">
      <view class="form-item">
        <view class="label-row">
          <icon name="user" size="24rpx" color="#6a7d81" />
          <text class="label">昵称</text>
        </view>
        <input
          type="text"
          placeholder="请输入昵称"
          placeholder-class="ph"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          class="input"/>
      </view>
      <view class="form-item">
        <view class="label-row">
          <icon name="school" size="24rpx" color="#6a7d81" />
          <text class="label">学校</text>
        </view>
        <picker bindchange="onSchoolSelect" value="{{schoolIndex}}" range="{{schools}}" range-key="name">
          <view class="picker {{schoolId ? 'has-value' : ''}}">
            <text>{{schoolName || '点击选择学校'}}</text>
            <icon name="chevron-down" size="24rpx" color="#6a7d81" />
          </view>
        </picker>
      </view>
    </block>

    <!-- 邮箱 + 密码 -->
    <view class="form-item">
      <view class="label-row">
        <icon name="mail" size="24rpx" color="#6a7d81" />
        <text class="label">{{mode === 'bind' ? '邮箱' : '教育邮箱'}}</text>
      </view>
      <input
        type="text"
        placeholder="{{mode === 'bind' ? '请输入邮箱' : '请输入学校官方邮箱'}}"
        placeholder-class="ph"
        value="{{email}}"
        bindinput="onEmailInput"
        class="input"/>
    </view>
    <view class="form-item">
      <view class="label-row">
        <icon name="lock" size="24rpx" color="#6a7d81" />
        <text class="label">密码</text>
      </view>
      <view class="pwd-input-wrap">
        <input
          type="text"
          password="{{!showPassword}}"
          placeholder="请输入密码"
          placeholder-class="ph"
          value="{{password}}"
          bindinput="onPasswordInput"
          class="pwd-input"/>
        <view class="pwd-toggle" bindtap="toggleShowPassword" hover-class="pwd-toggle-hover" hover-stay-time="80">
          <icon name="{{showPassword ? 'eye-off' : 'eye'}}" size="28rpx" color="#6a7d81" />
        </view>
      </view>
    </view>

    <!-- 注册模式：确认密码 -->
    <view wx:if="{{mode === 'register'}}" class="form-item">
      <view class="label-row">
        <icon name="lock" size="24rpx" color="#6a7d81" />
        <text class="label">确认密码</text>
      </view>
      <view class="pwd-input-wrap">
        <input
          type="text"
          password="{{!showConfirmPassword}}"
          placeholder="请再次输入密码"
          placeholder-class="ph"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          class="pwd-input"/>
        <view class="pwd-toggle" bindtap="toggleShowConfirmPassword" hover-class="pwd-toggle-hover" hover-stay-time="80">
          <icon name="{{showConfirmPassword ? 'eye-off' : 'eye'}}" size="28rpx" color="#6a7d81" />
        </view>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{errorMsg}}" class="error-msg">
    <icon name="alert-circle" size="28rpx" color="#cd5852" />
    <text>{{errorMsg}}</text>
  </view>

  <!-- 提交按钮 -->
  <view
    class="submit-btn {{loading ? 'disabled' : ''}}"
    bindtap="onSubmit"
    hover-class="{{loading ? '' : 'submit-btn-hover'}}"
    hover-stay-time="120">
    <text>{{loading ? '处理中...' : (mode === 'bind' ? '绑定并登录' : '注册并登录')}}</text>
  </view>

  <view class="mode-switch">
    <text class="mode-switch-label">{{mode === 'bind' ? '还没有账号？' : '已有此刻校园账号？'}}</text>
    <text class="mode-switch-link" bindtap="switchMode" data-mode="{{mode === 'bind' ? 'register' : 'bind'}}">{{mode === 'bind' ? '注册新账号' : '绑定并登录'}}</text>
  </view>
</view>
