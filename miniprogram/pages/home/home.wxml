<view class="home-page page-fade-in">
  <!-- 顶部栏：校名 + Slogan + 搜索入口 -->
  <view class="top-bar">
    <view class="school-info">
      <icon name="school" size="36rpx" color="#174d5e" />
      <view class="school-text">
        <text class="school-name">{{schoolName}}</text>
        <text class="school-slogan">把会消失的校园经验留下来</text>
      </view>
    </view>
    <view class="search-entry" bindtap="goToSearch" hover-class="search-entry-hover" hover-stay-time="120">
      <icon name="search" size="28rpx" color="#6a7d81" />
      <text class="search-text">搜索校园信息...</text>
    </view>
  </view>

  <!-- 分类 Tab 横向滚动 -->
  <scroll-view class="category-tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-tab {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap">
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 校园地点入口 -->
  <view class="locations-entry" bindtap="goToLocations" hover-class="locations-entry-hover" hover-stay-time="120">
    <view class="locations-entry-icon">
      <icon name="map-pin" size="40rpx" color="#ffffff" />
    </view>
    <view class="locations-entry-text">
      <text class="locations-entry-title">校园地点 · 设施评分</text>
      <text class="locations-entry-sub">打印店 · 食堂 · 图书馆，看评分做选择</text>
    </view>
    <icon name="chevron-right" size="32rpx" color="#174d5e" />
  </view>

  <!-- 内容概要 -->
  <view wx:if="{{totalPosts > 0}}" class="content-summary">
    <icon name="file-text" size="22rpx" color="#6a7d81" />
    <text>共 {{formattedTotal}} 条内容 · {{formattedRefreshTime}}更新</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <!-- 推荐区块标题（仅推荐 Tab 显示） -->
    <view wx:if="{{activeCategoryId === 0 && posts.length > 0}}" class="recommend-header">
      <icon name="sparkles" size="28rpx" color="#174d5e" />
      <text class="recommend-title">为你推荐</text>
    </view>

    <!-- 加载中：骨架屏（首次加载时显示 3 张骨架卡片） -->
    <block wx:if="{{loading}}">
      <skeleton variant="post-card" />
      <skeleton variant="post-card" />
      <skeleton variant="post-card" />
    </block>

    <!-- 空状态 -->
    <empty-state
      wx:if="{{posts.length === 0 && !loading}}"
      icon="file-text"
      title="暂无内容"
      hint="来发布第一条校园经验吧"
      action-text="去发布"
      bind:action="goToPublish"
    />

    <!-- post-card 组件渲染帖子 -->
    <post-card
      wx:for="{{posts}}"
      wx:key="id"
      post="{{item}}"
      class="stagger-card"
      style="animation-delay: {{index * 40}}ms;"
      bind:tap="onPostTap"/>
  </view>

  <!-- 底部加载状态 -->
  <view wx:if="{{loadingMore}}" class="loading-more">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <text>加载更多</text>
  </view>
  <view wx:if="{{!hasMore && posts.length > 0 && !loadingMore}}" class="no-more">
    <view class="no-more-line"></view>
    <text>没有更多了</text>
    <view class="no-more-line"></view>
  </view>
</view>
