<view class="home-page page-fade-in">
  <view class="top-bar">
    <view class="school-info">
      <icon name="school" size="36rpx" color="#174d5e" />
      <view class="school-text">
        <text class="school-name">{{schoolName}}</text>
        <text class="school-slogan">把会消失的校园经验留下来</text>
      </view>
    </view>
    <view class="search-entry" bindtap="goToSearch" hover-class="search-entry-hover" hover-stay-time="120">
      <icon name="search" size="28rpx" color="#6a7d81" />
      <text class="search-text">搜索校园信息...</text>
    </view>
  </view>

  <view class="locations-entry" bindtap="goToLocations" hover-class="locations-entry-hover" hover-stay-time="120">
    <view class="locations-entry-icon">
      <icon name="map-pin" size="40rpx" color="#ffffff" />
    </view>
    <view class="locations-entry-text">
      <text class="locations-entry-title">校园地点 · 设施评分</text>
      <text class="locations-entry-sub">打印店 · 食堂 · 图书馆，看评分做选择</text>
    </view>
    <icon name="chevron-right" size="32rpx" color="#174d5e" />
  </view>

  <view wx:if="{{hotLoading || hotPosts.length > 0 || hotError}}" class="hot-section">
    <view class="hot-heading" bindtap="goToHotRanking" hover-class="hot-heading-hover" hover-stay-time="120">
      <view class="hot-heading-title">
        <view class="hot-flame"><text>火</text></view>
        <view>
          <text class="hot-title">校园热榜</text>
          <text class="hot-subtitle">近 7 天浏览量 Top10</text>
        </view>
      </view>
      <view class="hot-more"><text>查看榜单</text><icon name="chevron-right" size="26rpx" color="#b65335" /></view>
    </view>

    <view wx:if="{{hotLoading}}" class="hot-loading"><view class="hot-loading-bar"></view><view class="hot-loading-bar short"></view></view>
    <view wx:elif="{{hotError}}" class="hot-error" bindtap="retryHotPosts">
      <icon name="refresh-cw" size="24rpx" color="#b65335" />
      <text>热榜暂时走丢了，点击重试</text>
    </view>
    <scroll-view wx:elif="{{hotPosts.length > 0}}" class="hot-scroll" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view wx:for="{{hotPosts}}" wx:key="id" class="hot-item" data-id="{{item.id}}" bindtap="onHotPostTap" hover-class="hot-item-hover" hover-stay-time="120">
        <view class="hot-rank {{index < 3 ? 'hot-rank-top' : ''}}"><text>{{index + 1}}</text></view>
        <view class="hot-item-body">
          <text class="hot-item-title">{{item.title}}</text>
          <view class="hot-item-meta">
            <text wx:if="{{item.category && item.category.name}}" class="hot-item-category">{{item.category.name}}</text>
            <text>{{item.view_count}} 浏览</text>
            <text>{{item.comment_count}} 评论</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:elif="{{!hotLoading && !hotError}}" class="hot-empty">近 7 天还没有形成热榜</view>
  </view>

  <view wx:if="{{recommendationLoading || recommendations.length > 0 || recommendationError}}" class="recommendation-section">
    <view class="section-heading">
      <view class="section-heading-title">
        <icon name="sparkles" size="28rpx" color="#174d5e" />
        <text>为你推荐</text>
      </view>
      <text wx:if="{{recommendationMode && recommendationMode.personalized}}" class="personalized-badge">个性化</text>
    </view>
    <text wx:if="{{recommendationMode && recommendationMode.reason_code === 'cold_start_guest'}}" class="section-hint">登录后开启个性化推荐</text>
    <text wx:elif="{{recommendationMode && recommendationMode.reason_code === 'cold_start_no_history'}}" class="section-hint">多浏览帖子，推荐会越来越贴近你的兴趣</text>
    <view wx:if="{{recommendationLoading}}" class="recommendation-loading">
      <skeleton variant="post-card" />
    </view>
    <view wx:elif="{{recommendationError}}" class="recommendation-error" bindtap="retryRecommendations">
      <icon name="alert-circle" size="28rpx" color="#cc5f30" />
      <text>推荐暂时走丢了，点击重试</text>
    </view>
    <view wx:elif="{{featuredRecommendation}}" class="recommendation-featured" bindtap="onRecommendationTap" data-id="{{featuredRecommendation.id}}" hover-class="recommendation-featured-hover" hover-stay-time="120">
      <view class="recommendation-featured-top">
        <view class="recommendation-featured-tag">
          <icon name="sparkles" size="22rpx" color="#174d5e" />
          <text>精选一条</text>
        </view>
        <text wx:if="{{featuredRecommendation.category && featuredRecommendation.category.name}}" class="recommendation-featured-category">{{featuredRecommendation.category.name}}</text>
      </view>
      <text class="recommendation-featured-title">{{featuredRecommendation.title}}</text>
      <text class="recommendation-featured-content">{{featuredRecommendation.content}}</text>
      <view class="recommendation-featured-meta">
        <text wx:if="{{featuredRecommendation.location_name}}">{{featuredRecommendation.location_name}}</text>
        <text wx:if="{{featuredRecommendation.recommend_reason}}" class="recommendation-featured-reason">{{featuredRecommendation.recommend_reason}}</text>
      </view>
    </view>
  </view>

  <view class="feed-section">
    <view class="feed-heading">
      <view>
        <text class="feed-title">校园动态</text>
        <text wx:if="{{totalPosts > 0}}" class="feed-summary">共 {{formattedTotal}} 条 · {{formattedRefreshTime}}更新</text>
      </view>
    </view>

    <scroll-view class="category-tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-tab {{activeCategoryId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap">
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <view class="post-list">
      <block wx:if="{{loading}}">
        <skeleton variant="post-card" />
        <skeleton variant="post-card" />
        <skeleton variant="post-card" />
      </block>

      <empty-state
        wx:if="{{posts.length === 0 && !loading}}"
        icon="file-text"
        title="暂无内容"
        hint="来发布第一条校园经验吧"
        action-text="去发布"
        bind:action="goToPublish" />

      <post-card
        wx:for="{{posts}}"
        wx:key="id"
        post="{{item}}"
        class="stagger-card"
        style="animation-delay: {{index * 40}}ms;"
        bind:tap="onPostTap" />
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <text>加载更多</text>
  </view>
  <view wx:if="{{!hasMore && posts.length > 0 && !loadingMore}}" class="no-more">
    <view class="no-more-line"></view>
    <text>没有更多了</text>
    <view class="no-more-line"></view>
  </view>
</view>
