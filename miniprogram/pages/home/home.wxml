<view class="home-page">
  <!-- 顶部栏：校名 + 搜索入口 + 专题入口 -->
  <view class="top-bar">
    <view class="school-info">
      <text class="school-name">{{schoolName}}</text>
    </view>
    <view class="search-entry" bindtap="goToSearch">
      <text class="search-icon">搜</text>
      <text class="search-text">搜索校园信息...</text>
    </view>
    <view class="topics-entry" bindtap="goToTopics">
      <text class="topics-label">专题</text>
    </view>
  </view>

  <!-- 分类 Tab 横向滚动 -->
  <scroll-view class="category-tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-tab {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap">
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 内容概要 -->
  <view wx:if="{{totalPosts > 0}}" class="content-summary">
    <text>共 {{formattedTotal}} 条内容 · {{formattedRefreshTime}}更新</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <!-- 空状态 -->
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">○</text>
      <text class="empty-text">暂无内容，来发布第一条吧</text>
    </view>

    <!-- post-card 组件渲染帖子 -->
    <post-card
      wx:for="{{posts}}"
      wx:key="id"
      post="{{item}}"
      bind:tap="onPostTap"/>
  </view>

  <!-- 底部加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中</text>
  </view>
  <view wx:if="{{loadingMore}}" class="loading-more">
    <text>加载更多...</text>
  </view>
  <view wx:if="{{!hasMore && posts.length > 0 && !loadingMore}}" class="no-more">
    <text>— 没有更多了 —</text>
  </view>
</view>

<!-- 底部导航：首页 / 地图 / 发布 / 我的 -->
<view class="tab-bar">
  <view class="bar-tab {{activeTab === 'home' ? 'active' : ''}}" bindtap="goToHome">
    <text class="bar-label">首页</text>
  </view>
  <view class="bar-tab {{activeTab === 'map' ? 'active' : ''}}" bindtap="goToMap">
    <text class="bar-label">地图</text>
  </view>
  <view class="bar-tab bar-publish" bindtap="goToPublish">
    <view class="publish-btn">
      <text class="publish-icon">+</text>
    </view>
    <text class="bar-label publish-label">发布</text>
  </view>
  <view class="bar-tab {{activeTab === 'profile' ? 'active' : ''}}" bindtap="goToProfile">
    <text class="bar-label">我的</text>
  </view>
</view>
