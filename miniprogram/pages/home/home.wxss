/* ============================================================
 * home 首页 - 水墨风样式
 * 对齐 Web MobileNav 设计
 * ============================================================ */

.home-page {
  min-height: 100vh;
  /* 背景继承 app.wxss 的 mist */
  padding-bottom: 220rpx;
}

/* === 顶部栏 === */
.top-bar {
  display: flex;
  align-items: center;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 16rpx;
}

.school-info {
  flex-shrink: 0;
  max-width: 360rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.school-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.school-name {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lake);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.school-slogan {
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 2rpx;
}

/* === 搜索入口 === */
.search-entry {
  flex: 1;
  height: 64rpx;
  background: var(--mist);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 24rpx;
  transition: background 200ms;
}

.search-entry-hover {
  background: var(--paper-hover);
}

.search-text {
  font-size: 26rpx;
  color: var(--muted);
}

/* === 分类 Tab === */
.category-tabs {
  white-space: nowrap;
  background: var(--paper);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
  position: sticky;
  top: 105rpx;
  z-index: 99;
}

.cat-tab {
  display: inline-block;
  padding: 20rpx 24rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--muted);
  border-bottom: 4rpx solid transparent;
  transition: color 0.2s, border-color 0.2s;
}

.cat-tab.active {
  color: var(--lake);
  border-bottom: 4rpx solid var(--lake);
  font-weight: 600;
}

/* === 校园地点入口 === */
.locations-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.locations-entry-hover {
  border-color: rgba(23, 77, 94, 0.4);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow);
}

.locations-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--lake);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
  flex-shrink: 0;
}

.locations-entry-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.locations-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.locations-entry-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* === 内容概要 === */
.content-summary {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 30rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

/* === 帖子列表 === */
.post-list {
  padding: 24rpx;
}

/* === 推荐区块标题 === */
.recommend-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 8rpx 20rpx;
  margin-bottom: 8rpx;
}

.recommend-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lake);
  letter-spacing: 2rpx;
}

/* === 推荐区与普通信息流分层 === */
.recommendation-section {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 20rpx 18rpx;
  background: var(--paper);
  border: 1rpx solid rgba(47, 127, 143, 0.28);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-heading,
.feed-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-heading-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--lake);
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.personalized-badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 127, 143, 0.1);
  color: var(--lake);
  font-size: 20rpx;
}

.section-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.recommendation-list {
  margin-top: 12rpx;
}

.recommendation-list .post-card {
  margin-bottom: 12rpx;
}

.recommendation-list .post-card:last-child {
  margin-bottom: 0;
}

.recommendation-featured {
  margin-top: 14rpx;
  padding: 18rpx 20rpx 16rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(231, 240, 241, 0.82), rgba(250, 252, 251, 0.96));
  border: 1rpx solid rgba(47, 127, 143, 0.16);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.recommendation-featured-hover {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-sm);
}

.recommendation-featured-top,
.recommendation-featured-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.recommendation-featured-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--lake);
  font-size: 22rpx;
  font-weight: 600;
}

.recommendation-featured-category {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 127, 143, 0.1);
  color: var(--lake);
  font-size: 20rpx;
}

.recommendation-featured-title {
  display: -webkit-box;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.42;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommendation-featured-content {
  display: -webkit-box;
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  line-height: 1.55;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommendation-featured-meta {
  justify-content: flex-start;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.recommendation-featured-reason {
  padding-left: 12rpx;
  border-left: 1rpx solid var(--line);
}

.recommendation-loading {
  margin-top: 12rpx;
}

.recommendation-error {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: rgba(204, 95, 48, 0.08);
  color: var(--danger);
  font-size: 24rpx;
}

/* === 校园热榜：横向滚动卡片 === */
.hot-section {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 0 18rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(255, 244, 234, 0.98), rgba(250, 252, 251, 0.92));
  border: 1rpx solid rgba(204, 95, 48, 0.2);
  box-shadow: 0 6rpx 22rpx rgba(204, 95, 48, 0.08);
  overflow: hidden;
}

.hot-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 20rpx 16rpx;
}

.hot-heading-hover {
  opacity: 0.72;
}

.hot-heading-title,
.hot-more,
.hot-item-meta {
  display: flex;
  align-items: center;
}

.hot-heading-title {
  gap: 12rpx;
}

.hot-flame {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  background: var(--lamp);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  transform: rotate(-6deg);
  box-shadow: var(--shadow-lamp);
}

.hot-title {
  display: block;
  color: #9e422b;
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hot-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #a36b5b;
  font-family: var(--font-data);
  font-size: 20rpx;
}

.hot-more {
  gap: 2rpx;
  color: #b65335;
  font-size: 21rpx;
  flex-shrink: 0;
}

.hot-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 0 20rpx 4rpx;
}

.hot-item {
  display: inline-flex;
  vertical-align: top;
  width: 356rpx;
  min-height: 118rpx;
  margin-right: 14rpx;
  padding: 16rpx;
  align-items: flex-start;
  gap: 12rpx;
  white-space: normal;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(204, 95, 48, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(204, 95, 48, 0.06);
  transition: transform 180ms ease;
}

.hot-item:last-child {
  margin-right: 0;
}

.hot-item-hover {
  transform: translateY(-2rpx);
}

.hot-rank {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #edf1f2;
  color: var(--muted);
  font-family: var(--font-data);
  font-size: 22rpx;
  font-weight: 700;
}

.hot-rank-top {
  background: #ffd36a;
  color: #8d4e1f;
}

.hot-item-body {
  min-width: 0;
  flex: 1;
}

.hot-item-title {
  display: -webkit-box;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hot-item-meta {
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-family: var(--font-data);
  font-size: 19rpx;
}

.hot-item-category {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #b65335;
  font-family: var(--font-body);
}

.hot-loading,
.hot-error,
.hot-empty {
  margin: 0 20rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  color: #a36b5b;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.7);
}

.hot-loading-bar {
  height: 20rpx;
  width: 78%;
  border-radius: 999rpx;
  background: rgba(204, 95, 48, 0.14);
  animation: hotPulse 1.2s ease-in-out infinite;
}

.hot-loading-bar.short {
  width: 52%;
  margin-top: 10rpx;
  animation-delay: 100ms;
}

.hot-error {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

@keyframes hotPulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.feed-section {
  margin-top: 28rpx;
}

.feed-heading {
  padding: 0 30rpx 12rpx;
}

.feed-title {
  display: block;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 700;
}

.feed-summary {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-family: var(--font-data);
  font-size: 20rpx;
}

/* === 加载更多 === */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-disabled);
  animation: loadingDot 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes loadingDot {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 30rpx;
  color: var(--ink-disabled);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--ink-divider);
}

/* === reduced motion 降级 === */
@media (prefers-reduced-motion: reduce) {
  .search-entry {
    transition: none;
  }
  .loading-dot {
    animation: none;
  }
  .stagger-card {
    animation: none;
  }
}
