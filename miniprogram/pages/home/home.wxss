/* ============================================================
 * home 首页 - 水墨风样式
 * 对齐 Web MobileNav 设计
 * ============================================================ */

.home-page {
  min-height: 100vh;
  /* 背景继承 app.wxss 的 mist */
  padding-bottom: 220rpx;
}

/* === 顶部栏 === */
.top-bar {
  display: flex;
  align-items: center;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 16rpx;
}

.school-info {
  flex-shrink: 0;
  max-width: 360rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.school-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.school-name {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lake);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.school-slogan {
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 2rpx;
}

/* === 搜索入口 === */
.search-entry {
  flex: 1;
  height: 64rpx;
  background: var(--mist);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 24rpx;
  transition: background 200ms;
}

.search-entry-hover {
  background: var(--paper-hover);
}

.search-text {
  font-size: 26rpx;
  color: var(--muted);
}

/* === 分类 Tab === */
.category-tabs {
  white-space: nowrap;
  background: var(--paper);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
  position: sticky;
  top: 105rpx;
  z-index: 99;
}

.cat-tab {
  display: inline-block;
  padding: 20rpx 24rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--muted);
  border-bottom: 4rpx solid transparent;
  transition: color 0.2s, border-color 0.2s;
}

.cat-tab.active {
  color: var(--lake);
  border-bottom: 4rpx solid var(--lake);
  font-weight: 600;
}

/* === 校园地点入口 === */
.locations-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.locations-entry-hover {
  border-color: rgba(23, 77, 94, 0.4);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow);
}

.locations-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--lake);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
  flex-shrink: 0;
}

.locations-entry-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.locations-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.locations-entry-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* === 内容概要 === */
.content-summary {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 30rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-family: var(--font-data);
}

/* === 帖子列表 === */
.post-list {
  padding: 24rpx;
}

/* === 推荐区块标题 === */
.recommend-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 8rpx 20rpx;
  margin-bottom: 8rpx;
}

.recommend-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lake);
  letter-spacing: 2rpx;
}

/* === 加载更多 === */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-disabled);
  animation: loadingDot 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes loadingDot {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 30rpx;
  color: var(--ink-disabled);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--ink-divider);
}

/* === reduced motion 降级 === */
@media (prefers-reduced-motion: reduce) {
  .search-entry {
    transition: none;
  }
  .loading-dot {
    animation: none;
  }
  .stagger-card {
    animation: none;
  }
}
