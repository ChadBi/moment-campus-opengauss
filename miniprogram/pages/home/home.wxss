/* ============================================================
 * home 首页 - 水墨风样式
 * 对齐 Web MobileNav 设计
 * ============================================================ */

.home-page {
  min-height: 100vh;
  /* 背景继承 app.wxss 的 mist */
  padding-bottom: 200rpx;
}

/* === 顶部栏 === */
.top-bar {
  display: flex;
  align-items: center;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.school-info {
  flex-shrink: 0;
  margin-right: 20rpx;
  max-width: 280rpx;
}

.school-name {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 800;
  color: var(--lake);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
}

/* === 搜索入口 === */
.search-entry {
  flex: 1;
  height: 64rpx;
  background: var(--mist);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.search-text {
  font-size: 26rpx;
  color: var(--muted);
}

/* === 专题入口 === */
.topics-entry {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 4rpx 10rpx;
}

.topics-label {
  font-size: 24rpx;
  color: var(--lake);
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* === 分类 Tab === */
.category-tabs {
  white-space: nowrap;
  background: var(--paper);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
  position: sticky;
  top: 105rpx;
  z-index: 99;
}

.cat-tab {
  display: inline-block;
  padding: 20rpx 24rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--muted);
  border-bottom: 4rpx solid transparent;
  transition: color 0.2s, border-color 0.2s;
}

.cat-tab.active {
  color: var(--lake);
  border-bottom: 4rpx solid var(--lake);
  font-weight: 600;
}

/* === 内容概要 === */
.content-summary {
  padding: 16rpx 30rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* === 帖子列表 === */
.post-list {
  padding: 24rpx;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  color: var(--ink-divider);
  margin-bottom: 24rpx;
  line-height: 1;
}

.empty-text {
  color: var(--muted);
  font-size: 28rpx;
}

/* === 加载状态 === */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--ink-disabled);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ============================================================
 * 底部导航 - 浮动胶囊式（对齐 Web MobileNav）
 * ============================================================ */
.tab-bar {
  position: fixed;
  bottom: 12rpx;
  left: 12rpx;
  right: 12rpx;
  height: 108rpx;
  background: rgba(23, 77, 94, 0.95);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 16rpx 64rpx rgba(20, 55, 63, 0.25);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  align-items: center;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.bar-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  margin: 8rpx;
  border-radius: var(--radius-sm);
  transition: background 0.2s, color 0.2s;
}

.bar-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
}

.bar-tab.active {
  background: var(--paper);
}

.bar-tab.active .bar-label {
  color: var(--lake);
  font-weight: 700;
}

/* === 发布按钮（中间凸起） === */
.bar-publish {
  position: relative;
}

.publish-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--lamp);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -36rpx;
  box-shadow: var(--shadow-lamp);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.publish-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.publish-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.9);
}
