/* ============================================================
 * 专题列表页 - 水墨风
 * ============================================================ */

.topics-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.page-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--ink-divider);
}

.page-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--muted);
}

/* 专题列表 */
.topic-list {
  padding: 20rpx;
}

/* 专题卡片：圆角阴影 */
.topic-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.topic-card-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow);
}

.topic-cover {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--mist);
}

.topic-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lake-light);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.topic-info {
  flex: 1;
  padding: 4rpx 0 4rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  align-self: stretch;
}

.topic-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 帖子数量：湖水蓝 + 数据字体 */
.meta-count {
  color: var(--lake);
  font-family: var(--font-data);
  font-weight: 700;
}

.meta-time {
  font-family: var(--font-data);
}

/* 骨架屏 */
.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  padding: 30rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.loading-spinner-sm {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--ink-divider);
  border-top: 3rpx solid var(--lake);
  border-radius: 50%;
  animation: topics-spin 0.8s linear infinite;
}

@keyframes topics-spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--ink-disabled);
  font-size: 24rpx;
}
