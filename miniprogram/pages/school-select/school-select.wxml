<view class="school-page">
  <view class="page-header">
    <text class="page-title">选择你的学校</text>
    <text class="page-subtitle">不同学校的内容相互独立</text>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">
    <text>加载中...</text>
  </view>

  <view wx:else class="school-list">
    <view
      wx:for="{{schools}}"
      wx:key="id"
      class="school-card {{item.selected ? 'school-card-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelectSchool"
    >
      <view class="school-logo-wrap">
        <image
          wx:if="{{item.logoUrl}}"
          class="school-logo"
          src="{{item.logoUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="school-logo-default">
          <text>{{item.short_name}}</text>
        </view>
      </view>
      <view class="school-info">
        <view class="school-name-row">
          <text class="school-name">{{item.name}}</text>
          <view wx:if="{{item.selected}}" class="selected-badge">
            <text>✓</text>
          </view>
        </view>
        <view wx:if="{{item.description}}" class="school-desc">
          <text>{{item.description}}</text>
        </view>
        <view wx:if="{{item.location}}" class="school-location">
          <text class="location-icon">📍</text>
          <text class="location-text">{{item.location}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!schools.length}}" class="empty-state">
      <text class="empty-text">暂无可选学校</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view
      class="confirm-btn {{(!selectedId || submitting) ? 'confirm-btn-disabled' : ''}}"
      bindtap="onConfirm"
    >
      <text wx:if="{{submitting}}">切换中...</text>
      <text wx:else>确认选择</text>
    </view>
  </view>
</view>
