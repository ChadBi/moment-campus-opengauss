<view class="post-card" bindtap="onTap" hover-class="post-card-hover" hover-stay-time="120">
  <view class="card-header">
    <image class="author-avatar" src="{{authorAvatar || '/assets/default-avatar.png'}}" mode="aspectFill"/>
    <view class="header-info">
      <text class="author-name">{{post.author_nickname || '匿名用户'}}</text>
      <text class="post-time">{{formattedTime}}</text>
    </view>
    <view wx:if="{{post.category_name}}" class="category-tag cat-{{categoryClass}}">
      <text>{{post.category_name}}</text>
    </view>
  </view>

  <view class="card-body">
    <text class="post-title">{{post.title}}</text>
    <text class="post-content">{{post.content}}</text>
  </view>

  <view wx:if="{{displayImages.length > 0}}" class="card-images">
    <image
      wx:for="{{displayImages}}"
      wx:key="*this"
      src="{{item}}"
      mode="aspectFill"
      class="post-image"
      catchtap="onImageTap"
      data-src="{{item}}"/>
  </view>

  <view class="card-footer">
    <view wx:if="{{post.location_name}}" class="location-info">
      <icon name="map-pin" size="24rpx" color="#2d6270" />
      <text class="location-text">{{post.location_name}}</text>
    </view>
    <view class="post-stats">
      <view class="stat-item">
        <icon name="eye" size="24rpx" color="#6a7d81" />
        <text class="stat-num">{{formattedViews}}</text>
      </view>
      <view class="stat-item">
        <icon name="heart" size="24rpx" color="#6a7d81" />
        <text class="stat-num">{{formattedLikes}}</text>
      </view>
      <view class="stat-item">
        <icon name="message-circle" size="24rpx" color="#6a7d81" />
        <text class="stat-num">{{formattedComments}}</text>
      </view>
    </view>
  </view>
</view>
