/* ============================================================
 * post-card 组件 - 水墨风样式
 * 对齐 Web 端 PostCard 设计
 * ============================================================ */

.post-card {
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
  margin-bottom: 24rpx;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.post-card-hover {
  box-shadow: var(--shadow);
  transform: translateY(-2rpx);
}

/* === 头部 === */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--paper-hover);
  flex-shrink: 0;
  border: 1rpx solid var(--ink-divider);
}

.header-info {
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* B-06: 作者昵称 + 已认证徽标在同一行 */
.author-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 1.3;
}

/* B-06: 已认证徽标（对齐 locations.wxss .verified-badge） */
.verified-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.post-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
  font-family: var(--font-data);
}

/* === 分类标签（使用分类色板 CSS 类） === */
.category-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* === 正文 === */
.card-body {
  margin-bottom: 20rpx;
}

.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
  font-family: var(--font-display);
}

.post-content {
  display: -webkit-box;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* === 推荐理由（仅推荐列表展示，水墨风浅色小标签） === */
.recommend-reason {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 16rpx;
  background: var(--lake-light);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-left: 4rpx solid var(--lake);
  border-radius: var(--radius-sm);
}

.recommend-reason-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--lake);
  letter-spacing: 1rpx;
}

.recommend-reason-text {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* === 图片 === */
.card-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: var(--radius-sm);
  background: var(--mist);
}

/* === 底部分割线 === */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ink-divider);
}

.location-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 4rpx 12rpx 4rpx 8rpx;
  background: var(--lake-light);
  border-radius: var(--radius-sm);
}

.location-text {
  font-size: 22rpx;
  color: var(--lake-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: 500;
}

.post-stats {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stat-item .stat-num {
  font-family: var(--font-data);
  font-weight: 700;
  color: var(--ink-2);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

/* === reduced motion 降级 === */
@media (prefers-reduced-motion: reduce) {
  .post-card {
    transition: none;
  }
  .post-card-hover {
    transform: none;
  }
}
