/* ============================================================
 * skeleton 骨架屏组件 - shimmer 动画
 * 对齐 skill Section 4.5 "Skeletal loaders matching final layout"
 * ============================================================ */

.skeleton-root {
  width: 100%;
}

.skeleton-root > view,
.skeleton-root .sk-head,
.skeleton-root .sk-foot,
.skeleton-root .sk-line,
.skeleton-root .sk-circle,
.skeleton-root .sk-tag,
.skeleton-root .sk-btn,
.skeleton-root .sk-block,
.skeleton-root .sk-stat-card,
.skeleton-root .sk-profile-bg {
  background: linear-gradient(
    90deg,
    var(--paper-hover) 0%,
    var(--mist) 50%,
    var(--paper-hover) 100%
  );
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  border-radius: var(--radius-sm);
}

@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* === post-card 骨架 === */
.skeleton-post-card {
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sk-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  background: transparent !important;
  animation: none !important;
}

.sk-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sk-circle-sm {
  width: 48rpx;
  height: 48rpx;
}

.sk-circle-lg {
  width: 120rpx;
  height: 120rpx;
}

.sk-head-info {
  flex: 1;
  margin-left: 18rpx;
  background: transparent !important;
  animation: none !important;
}

.sk-tag {
  width: 80rpx;
  height: 32rpx;
  border-radius: var(--radius-sm);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.sk-line {
  height: 24rpx;
  margin-bottom: 12rpx;
}

.sk-line-name {
  width: 140rpx;
  height: 28rpx;
}

.sk-line-time {
  width: 100rpx;
  height: 22rpx;
  margin-top: 8rpx;
}

.sk-line-title {
  width: 80%;
  height: 32rpx;
  margin-bottom: 16rpx;
}

.sk-line-content {
  width: 100%;
  height: 26rpx;
}

.sk-line-short {
  width: 60%;
}

.sk-line-num {
  width: 60rpx;
  height: 36rpx;
  margin: 8rpx auto 4rpx;
}

.sk-line-label {
  width: 80rpx;
  height: 20rpx;
  margin: 0 auto;
}

.sk-line-loc {
  width: 160rpx;
  height: 22rpx;
}

.sk-line-stats {
  width: 200rpx;
  height: 22rpx;
}

.sk-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--ink-divider);
  background: transparent !important;
  animation: none !important;
}

/* === profile-card 骨架 === */
.skeleton-profile-card {
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.sk-profile-bg {
  background: linear-gradient(135deg, var(--lake), var(--lake-2)) !important;
  padding: 60rpx 40rpx;
  animation: none !important;
}

.sk-profile-bg .sk-circle-lg {
  background: rgba(255, 255, 255, 0.2) !important;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.sk-profile-bg .sk-head-info {
  flex: 1;
}

.sk-profile-bg .sk-line-name {
  width: 180rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.3) !important;
}

.sk-profile-bg .sk-line-time {
  width: 140rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.2) !important;
}

.sk-profile-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 40rpx;
  background: var(--paper) !important;
  animation: none !important;
}

.sk-btn {
  width: 180rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
}

/* === stats-grid 骨架 === */
.skeleton-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
  background: transparent !important;
  animation: none !important;
}

.sk-stat-card {
  padding: 24rpx 12rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  background: var(--paper) !important;
  animation: none !important;
}

.sk-stat-card .sk-circle-sm {
  margin: 0 auto 8rpx;
}

/* === block 骨架 === */
.skeleton-block .sk-block {
  width: 100%;
  border-radius: var(--radius-md);
}

/* === reduced motion 降级 === */
@media (prefers-reduced-motion: reduce) {
  .skeleton-root > view,
  .skeleton-root .sk-line,
  .skeleton-root .sk-circle,
  .skeleton-root .sk-tag,
  .skeleton-root .sk-btn,
  .skeleton-root .sk-block,
  .skeleton-root .sk-stat-card {
    animation: none !important;
    background: var(--paper-hover);
  }
}
