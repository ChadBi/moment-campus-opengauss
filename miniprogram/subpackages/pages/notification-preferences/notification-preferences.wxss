/* ============================================================
 * 通知偏好页 - 水墨风
 * ============================================================ */
.np-page {
  min-height: 100vh;
  padding: 24rpx 30rpx 60rpx;
}

/* 未登录占位 */
.login-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 0;
}
.login-guide-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.login-guide-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.login-guide-btn {
  margin-top: 48rpx;
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 22rpx 64rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
}
.login-guide-btn:active {
  background: var(--lake-dark);
}

/* 加载中 */
.np-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

/* 顶部提示 */
.np-tip {
  display: flex;
  align-items: flex-start;
  background: var(--lake-light);
  border-radius: var(--radius-md);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.np-tip-text {
  flex: 1;
  margin-left: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 开关列表 */
.np-group {
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.np-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}
.np-item:last-child {
  border-bottom: none;
}
.np-info {
  flex: 1;
  margin-right: 24rpx;
}
.np-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.np-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}