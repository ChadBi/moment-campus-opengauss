<view class="school-page">
  <view class="page-header">
    <view class="page-kicker"><view class="kicker-dot"></view><text>{{schools.length}} 所学校可选</text></view>
    <text class="page-title">{{mode === 'switch' ? '切换当前学校' : '选择你的学校'}}</text>
    <text class="page-subtitle">选择你的校园空间，内容会随学校独立呈现</text>
  </view>

  <view class="search-bar {{loading ? 'search-bar-disabled' : ''}}">
    <icon name="search" size="32rpx" color="#174d5e" />
    <input
      class="search-input"
      value="{{searchQuery}}"
      placeholder="搜索学校名称、城市或拼音"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
      disabled="{{loading}}" />
    <view wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch" hover-class="search-clear-hover">
      <icon name="x" size="28rpx" color="#6a7d81" />
    </view>
  </view>

  <!-- 加载中：骨架屏 -->
  <view wx:if="{{loading}}" class="loading-skeleton">
    <skeleton variant="list-item" />
    <skeleton variant="list-item" />
    <skeleton variant="list-item" />
  </view>

  <block wx:else>
    <view class="result-meta">
      <text wx:if="{{searchQuery}}">找到 {{filteredSchools.length}} 所学校</text>
      <text wx:else>当前学校会显示在首页顶部</text>
      <text wx:if="{{selectedName}}" class="selected-meta">已选 {{selectedName}}</text>
    </view>
    <view class="school-list">
      <view
        wx:for="{{filteredSchools}}"
        wx:key="id"
        class="school-card {{item.selected ? 'school-card-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectSchool"
        hover-class="school-card-hover"
        hover-stay-time="120">
        <view class="school-logo-wrap">
          <image
            wx:if="{{item.logoUrl}}"
            class="school-logo"
            src="{{item.logoUrl}}"
            mode="aspectFill"></image>
          <view wx:else class="school-logo-default">
            <text>{{item.logoText}}</text>
          </view>
        </view>
        <view class="school-info">
          <view class="school-name-row">
            <text class="school-name">{{item.name}}</text>
            <view wx:if="{{item.selected}}" class="selected-badge">
              <icon name="check-circle" size="32rpx" color="#ffffff" />
            </view>
          </view>
          <view wx:if="{{item.description}}" class="school-desc">
            <text>{{item.description}}</text>
          </view>
          <view wx:if="{{item.city}}" class="school-location">
            <icon name="map-pin" size="22rpx" color="#6a7d81" />
            <text class="location-text">{{item.province}} {{item.city}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{filteredSchools.length === 0}}" class="empty-result-wrap">
        <empty-state
          icon="search"
          title="没有找到相关学校"
          hint="换个关键词试试"
        />
      </view>
    </view>
  </block>

  <!-- 底部确认栏 -->
  <view class="bottom-bar">
    <view wx:if="{{selectedName}}" class="bottom-selection">
      <view class="selection-mark"><icon name="check" size="22rpx" color="#ffffff" /></view>
      <text>当前选择：{{selectedName}}</text>
    </view>
    <view
      class="confirm-btn {{(!selectedId || submitting) ? 'confirm-btn-disabled' : ''}}"
      bindtap="onConfirm"
      hover-class="{{(!selectedId || submitting) ? '' : 'confirm-btn-hover'}}"
      hover-stay-time="120">
      <text wx:if="{{submitting}}">切换中...</text>
      <text wx:else>确认选择</text>
    </view>
  </view>
</view>
