/* ============================================================
 * 学校选择页 - 水墨风
 * ============================================================ */

.school-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: linear-gradient(180deg, #eef5f4 0%, #f7faf9 44%, #f4f8f7 100%);
}

.page-header {
  padding: 42rpx 30rpx 18rpx;
}

.page-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--lake);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.kicker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--grass);
  box-shadow: 0 0 0 6rpx rgba(63, 125, 98, 0.12);
}

.page-title {
  display: block;
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.search-bar {
  height: 84rpx;
  margin: 12rpx 30rpx 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(23, 77, 94, 0.13);
  border-radius: 26rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 77, 94, 0.07);
  transition: all 0.2s;
}

.search-bar:focus-within {
  border-color: var(--lake);
  box-shadow: 0 14rpx 32rpx rgba(23, 77, 94, 0.12);
}

.search-bar-disabled {
  opacity: 0.65;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: var(--ink);
  font-size: 27rpx;
}

.search-placeholder {
  color: var(--ink-disabled);
}

.search-clear {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.search-clear-hover {
  background: var(--paper-hover);
}

.result-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34rpx;
  padding: 22rpx 30rpx 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.selected-meta {
  color: var(--lake);
  font-weight: 600;
}

.loading-skeleton {
  padding: 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.school-list {
  padding: 10rpx 30rpx 30rpx;
}

.school-card {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  border: 1rpx solid rgba(23, 77, 94, 0.06);
  box-shadow: 0 10rpx 24rpx rgba(23, 77, 94, 0.06);
  transition: all 0.2s;
}

.school-card-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow);
}

.school-card-active {
  border-color: var(--lake);
  background: linear-gradient(135deg, rgba(232, 243, 244, 0.98), rgba(248, 252, 251, 0.98));
  box-shadow: 0 12rpx 28rpx rgba(23, 77, 94, 0.14);
}

.school-logo-wrap {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.school-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
}

.school-logo-default {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #d9eaeb, var(--lake));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 25rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  white-space: nowrap;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.22);
}

.school-info {
  flex: 1;
  min-width: 0;
}

.school-name-row {
  display: flex;
  align-items: center;
}

.school-name {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.selected-badge {
  width: 32rpx;
  height: 32rpx;
  background: var(--lake);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.school-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.school-location {
  margin-top: 7rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.location-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-result-wrap {
  padding: 96rpx 0 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(23, 77, 94, 0.08);
  box-shadow: 0 -12rpx 28rpx rgba(23, 77, 94, 0.08);
  backdrop-filter: blur(18px);
}

.bottom-selection {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 38rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.selection-mark {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--grass);
}

.confirm-btn {
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 25rpx 0;
  margin-top: 8rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.confirm-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

.confirm-btn-disabled {
  background: var(--paper-hover);
  color: var(--ink-disabled);
  box-shadow: none;
}
