/* ============================================================
 * 学校选择页 - 水墨风
 * ============================================================ */

.school-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.page-header {
  padding: 40rpx 30rpx 20rpx;
}

.page-title {
  display: block;
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.loading-skeleton {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.school-list {
  padding: 20rpx;
}

.school-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: var(--paper);
  border-radius: var(--radius-lg);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.school-card-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow);
}

.school-card-active {
  border-color: var(--lake);
  background: var(--lake-light);
  box-shadow: var(--shadow-lake);
}

.school-logo-wrap {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.school-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
}

.school-logo-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(145deg, var(--lake-light), var(--lake));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 25rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  white-space: nowrap;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.22);
}

.school-info {
  flex: 1;
  min-width: 0;
}

.school-name-row {
  display: flex;
  align-items: center;
}

.school-name {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.selected-badge {
  width: 32rpx;
  height: 32rpx;
  background: var(--lake);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.school-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.school-location {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.location-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  box-shadow: var(--shadow);
}

.confirm-btn {
  background: var(--lake);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.confirm-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.98);
}

.confirm-btn-disabled {
  background: var(--paper-hover);
  color: var(--ink-disabled);
  box-shadow: none;
}
