.locations-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ============== 顶部标题 ============== */
.page-header {
  margin-bottom: 16rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 48rpx;
  letter-spacing: 2rpx;
  color: var(--lake);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

/* ============== 列表 ============== */
.list-area {
  padding-bottom: 20rpx;
}

/* 骨架屏 */
.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

.loading-box,
.detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 80rpx 0;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lake);
  opacity: 0.4;
  animation: dotPulse 1.2s infinite ease-in-out;
}

.loading-dot-delay1 { animation-delay: 0.15s; }
.loading-dot-delay2 { animation-delay: 0.3s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--muted);
  margin-left: 8rpx;
}

.error-box,
.detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 40rpx;
}

.error-text {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
}

.retry-btn {
  padding: 12rpx 40rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.retry-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

/* 地点卡片 */
.loc-card {
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.loc-card-hover {
  border-color: rgba(23, 77, 94, 0.4);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow);
}

.loc-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.loc-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.loc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.verified-badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.loc-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.loc-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.loc-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stars {
  color: var(--lamp);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.score-number {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 26rpx;
  color: var(--ink);
}

.rating-count,
.review-count {
  font-size: 22rpx;
  color: var(--muted);
}

/* ============== 详情弹层 ============== */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(21, 38, 41, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  width: 100%;
  max-height: 88vh;
  background: var(--paper);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: panelUp 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes panelUp {
  from { transform: translateY(40rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 80%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.panel-close-hover {
  background: var(--paper-hover);
}

.panel-scroll {
  max-height: 76vh;
  padding: 8rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 评分汇总 */
.summary {
  background: var(--mist);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.summary-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stars-lg {
  color: var(--lamp);
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.score-lg {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 48rpx;
  color: var(--ink);
}

.summary-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
}

.summary-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 12rpx;
  display: block;
}

.summary-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
}

.summary-loc-text {
  font-size: 24rpx;
  color: var(--muted);
}

/* 我的评价 */
.my-review {
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

.login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.login-hint {
  font-size: 26rpx;
  color: var(--muted);
}

.login-btn {
  padding: 12rpx 32rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.login-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

.star-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.star-option {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.star-option-hover {
  transform: scale(1.15);
}

.star-char {
  font-size: 44rpx;
  color: var(--line-strong);
  transition: color 0.15s;
}

.star-option.active .star-char {
  color: var(--lamp);
}

.score-preview {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-left: 8rpx;
}

.review-input {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

.ph {
  color: var(--ink-disabled);
}

.review-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.withdraw-btn {
  padding: 14rpx 32rpx;
  background: var(--paper-hover);
  color: var(--danger);
  font-size: 26rpx;
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.withdraw-btn-hover {
  background: #f6e4e2;
  transform: scale(0.96);
}

.submit-btn {
  padding: 14rpx 40rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.submit-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

/* 全部评价 */
.no-reviews {
  font-size: 26rpx;
  color: var(--muted);
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.review-item:last-child {
  border-bottom: none;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.author-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-time {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.stars-sm {
  color: var(--lamp);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.review-score {
  font-size: 24rpx;
  color: var(--ink-2);
}

.review-content {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 8rpx;
  display: block;
}