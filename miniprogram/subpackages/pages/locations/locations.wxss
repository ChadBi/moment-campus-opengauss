.locations-page {
  min-height: 100vh;
  padding: 0 0 60rpx;
  box-sizing: border-box;
  background: var(--mist, #f3f6f7);
}

/* ============== 自定义导航栏 ============== */
.custom-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  background: var(--paper, #ffffff);
  z-index: 999;
  box-sizing: border-box;
}

.custom-nav-status {
  width: 100%;
}

.custom-nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.custom-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(21, 38, 41, 0.04);
  transition: background 0.18s ease, transform 0.15s ease;
  flex-shrink: 0;
}

.custom-nav-back-hover {
  background: rgba(23, 77, 94, 0.12);
  transform: scale(0.92);
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 55%;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink, #152629);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
}

.custom-nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.custom-nav-shadow {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 1rpx;
  background: rgba(21, 38, 41, 0.06);
  box-shadow: 0 6rpx 16rpx rgba(21, 38, 41, 0.05);
}

/* 页面入场动画不能包住 fixed 弹层，否则 fixed 会以整页文档而非当前视口为定位基准。 */
.locations-content {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============== 顶部标题 ============== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 48rpx;
  letter-spacing: 2rpx;
  color: var(--lake);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

/* ============== 搜索框 ============== */
.location-search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 22rpx;
  padding: 18rpx 22rpx;
  height: 88rpx;
  box-sizing: border-box;
  background: var(--paper, #ffffff);
  border: 1rpx solid rgba(23, 77, 94, 0.18);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(21, 38, 41, 0.06);
  transition: all 0.2s ease;
}

.location-search-wrap:focus-within,
.location-search-wrap:active {
  border-color: var(--lake);
  box-shadow: 0 10rpx 26rpx rgba(47, 127, 143, 0.14);
}

.location-search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: var(--ink, #152629);
  font-weight: 500;
  line-height: 1;
}

.location-search-ph {
  color: #8a9a9e;
  font-size: 26rpx;
  font-weight: 400;
}

.location-select-hint {
  margin-bottom: 10rpx;
}

/* ============== 列表 ============== */
.list-area {
  padding-bottom: 20rpx;
}

/* 骨架屏 */
.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-result-wrap {
  padding: 80rpx 0;
}

.loading-box,
.detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 80rpx 0;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lake);
  opacity: 0.4;
  animation: dotPulse 1.2s infinite ease-in-out;
}

.loading-dot-delay1 { animation-delay: 0.15s; }
.loading-dot-delay2 { animation-delay: 0.3s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--muted);
  margin-left: 8rpx;
}

.error-box,
.detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 40rpx;
}

.error-text {
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
}

.retry-btn {
  padding: 12rpx 40rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.retry-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

/* 地点卡片 */
.loc-card {
  background: var(--paper);
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.loc-card-hover {
  border-color: rgba(23, 77, 94, 0.4);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow);
}

.loc-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.loc-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.loc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.verified-badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  background: var(--lake-light);
  color: var(--lake);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.loc-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}

.loc-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.loc-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stars {
  color: var(--lamp);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.score-number {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 26rpx;
  color: var(--ink);
}

.rating-count,
.review-count {
  font-size: 22rpx;
  color: var(--muted);
}

/* ============== 详情弹层 ============== */
.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 38, 41, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.add-location-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  margin-top: 0;
  padding: 0 20rpx;
  min-width: 168rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--lake);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: var(--shadow-lake);
}

.add-location-btn text {
  display: block;
  line-height: 1;
}

.add-location-btn-hover {
  opacity: 0.86;
  transform: translateY(-1rpx);
}

.detail-panel {
  width: 100%;
  max-height: 88vh;
  background: var(--paper);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: panelUp 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes panelUp {
  from { transform: translateY(40rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.panel-header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 80%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.panel-close-hover {
  background: var(--paper-hover);
}

.panel-scroll {
  max-height: 76vh;
  padding: 8rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.create-mask {
  z-index: 110;
}

.create-panel {
  width: 100%;
  max-height: 82vh;
  background: var(--paper);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: panelUp 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.create-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}

.create-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.create-scroll {
  max-height: 70vh;
  padding: 16rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.create-map-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 4rpx;
}

.create-map-heading-text {
  min-width: 0;
}

.create-map-heading .create-coordinate-title {
  display: block;
  margin-top: 0;
}

.create-map-heading-hint {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.create-picked-badge {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(232, 167, 65, 0.14);
  color: #a76c16;
  font-size: 20rpx;
}

.create-picked-badge.is-picked {
  background: rgba(47, 127, 143, 0.12);
  color: var(--lake);
}

.create-location-map {
  width: 100%;
  height: 300rpx;
  margin-top: 12rpx;
  border: 1rpx solid rgba(47, 127, 143, 0.18);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(21, 38, 41, 0.08);
}

.create-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-md);
  background: var(--paper);
  color: var(--ink);
  font-size: 26rpx;
}

.create-select {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-md);
  background: var(--paper);
  color: var(--muted);
  font-size: 26rpx;
}

.create-select.has-value {
  color: var(--ink);
}

.create-textarea {
  min-height: 120rpx;
  line-height: 1.5;
}

.create-coordinate-title {
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.create-coordinate-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.create-coordinate-hint.is-picked {
  color: var(--lake);
}

.create-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.create-cancel-btn,
.create-submit-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.create-cancel-btn {
  color: var(--ink-2);
  background: var(--mist);
}

.create-submit-btn {
  color: #ffffff;
  background: var(--lake);
  box-shadow: var(--shadow-lake);
}

.create-submit-btn.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.detail-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 12rpx 0 8rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(163, 107, 34, 0.24);
  border-radius: var(--radius-md);
  background: rgba(248, 239, 224, 0.72);
  color: #8a5b20;
  font-size: 22rpx;
  line-height: 1.55;
}

/* 评分汇总 */
.knowledge-card {
  margin: 16rpx 0;
  padding: 22rpx;
  border: 1rpx solid var(--ink-divider);
  border-radius: var(--radius-lg);
  background: var(--paper);
}
.summary-card { background: rgba(47, 127, 143, 0.06); border-color: rgba(47, 127, 143, 0.25); }
.knowledge-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; }
.knowledge-title-row .section-title { margin-bottom: 0; }
.fact-proposal-trigger {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(47, 127, 143, 0.28);
  border-radius: 999rpx;
  color: var(--lake);
  font-size: 20rpx;
  background: rgba(47, 127, 143, 0.06);
}
.fact-proposal-trigger-hover { background: rgba(47, 127, 143, 0.14); }
.knowledge-note { font-size: 20rpx; color: var(--muted); }
.knowledge-empty { display: block; font-size: 24rpx; color: var(--muted); line-height: 1.6; }
.fact-row { padding: 14rpx 16rpx; background: var(--mist); border-radius: var(--radius-md); margin-top: 10rpx; }
.fact-label { display: block; font-size: 22rpx; color: var(--muted); }
.fact-value { display: block; margin-top: 4rpx; font-size: 26rpx; color: var(--ink); white-space: pre-wrap; }
.summary-text { display: block; font-size: 26rpx; line-height: 1.65; color: var(--ink-2); }
.summary-confidence { font-size: 20rpx; color: var(--lake); }
.summary-source-count { display: block; margin-top: 10rpx; }
.claims-list { margin-top: 12rpx; }
.claim-row { padding: 12rpx 14rpx; background: var(--paper); border-radius: var(--radius-md); margin-top: 8rpx; }
.claim-text { display: block; font-size: 24rpx; color: var(--ink); line-height: 1.5; }
.conflict-box { margin-top: 12rpx; padding: 12rpx 14rpx; color: var(--ink-2); background: rgba(232, 167, 65, 0.12); border-radius: var(--radius-md); font-size: 22rpx; line-height: 1.5; }
.proposal-mask { z-index: 120; }
.proposal-panel {
  width: 100%;
  max-height: 82vh;
  background: var(--paper);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: panelUp 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}
.proposal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--ink-divider);
}
.proposal-header .panel-title { display: block; }
.proposal-hint { display: block; margin-top: 6rpx; }
.proposal-scroll { max-height: 68vh; padding: 20rpx 32rpx 44rpx; box-sizing: border-box; }
.proposal-form { margin-top: 12rpx; }
.fact-picker, .proposal-input { box-sizing: border-box; width: 100%; min-height: 72rpx; margin-top: 10rpx; padding: 16rpx; border: 1rpx solid var(--ink-divider); border-radius: var(--radius-md); background: var(--paper); color: var(--ink); font-size: 24rpx; }
.proposal-input { min-height: auto; }
.submit-btn.disabled { opacity: 0.45; pointer-events: none; }
.summary {
  background: var(--mist);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.summary-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stars-lg {
  color: var(--lamp);
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.score-lg {
  font-family: var(--font-data);
  font-weight: 700;
  font-size: 48rpx;
  color: var(--ink);
}

.summary-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
}

.summary-desc {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 12rpx;
  display: block;
}

.summary-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
}

.summary-loc-text {
  font-size: 24rpx;
  color: var(--muted);
}

/* 我的评价 */
.my-review {
  border: 1rpx solid rgba(216, 225, 227, 0.6);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

.login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.login-hint {
  font-size: 26rpx;
  color: var(--muted);
}

.login-btn {
  padding: 12rpx 32rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.login-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

.star-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.star-option {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.star-option-hover {
  transform: scale(1.15);
}

.star-char {
  font-size: 44rpx;
  color: var(--line-strong);
  transition: color 0.15s;
}

.star-option.active .star-char {
  color: var(--lamp);
}

.score-preview {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-left: 8rpx;
}

.review-input {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

.ph {
  color: var(--ink-disabled);
}

.review-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.withdraw-btn {
  padding: 14rpx 32rpx;
  background: var(--paper-hover);
  color: var(--danger);
  font-size: 26rpx;
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.withdraw-btn-hover {
  background: #f6e4e2;
  transform: scale(0.96);
}

.submit-btn {
  padding: 14rpx 40rpx;
  background: var(--lake);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lake);
  transition: all 0.2s;
}

.submit-btn-hover {
  background: var(--lake-dark);
  transform: scale(0.96);
}

/* 全部评价 */
.no-reviews {
  font-size: 26rpx;
  color: var(--muted);
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ink-divider);
}

.review-item:last-child {
  border-bottom: none;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.author-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-time {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.stars-sm {
  color: var(--lamp);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.review-score {
  font-size: 24rpx;
  color: var(--ink-2);
}

.review-content {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 8rpx;
