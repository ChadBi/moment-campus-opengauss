/* ============================================================
 * 找回密码页 - 水墨风（对齐 Web ForgotPasswordPage）
 * 品牌区 + 卡片容器 + 两步流程（发起 / 重置）
 * ============================================================ */

.fp-page {
  min-height: 100vh;
  padding: 120rpx 60rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* ============== 品牌区 ============== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: #e8f3f4;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.brand-logo-image {
  width: 160rpx;
  height: 160rpx;
  margin: -16rpx;
}

.brand-title {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--lake);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: var(--muted);
}

/* ============== 卡片容器 ============== */
.fp-card {
  background: var(--paper);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx 56rpx;
  box-shadow: var(--shadow);
}

.form-item {
  margin-bottom: 28rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--mist);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 88rpx;
  transition: border-color 0.2s;
}

.input-wrap:focus-within {
  border-color: var(--lake);
}

.form-input {
  flex: 1;
  height: 100%;
  background: transparent;
  font-size: 30rpx;
  color: var(--ink);
}

.ph {
  color: var(--ink-disabled);
}

.error-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(205, 88, 82, 0.08);
  color: var(--danger);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.info-msg {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(47, 133, 90, 0.08);
  color: var(--grass);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.info-msg text {
  flex: 1;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: var(--lake);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lake);
  transition: transform 0.15s;
}

.submit-btn-hover {
  transform: scale(0.98);
}

.submit-btn.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.form-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  font-size: 26rpx;
}

.link-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--muted);
}

.link-resend {
  color: var(--lake);
  font-weight: 500;
}
