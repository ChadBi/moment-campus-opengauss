<view class="fp-page">
  <!-- ============== 品牌区（对齐 Web ForgotPasswordPage） ============== -->
  <view class="brand-area">
    <view class="brand-logo">
      <image class="brand-logo-image" src="/assets/logo.png" mode="aspectFit" />
    </view>
    <text class="brand-title">找回密码</text>
    <text class="brand-slogan">{{step === 1 ? '输入注册邮箱，获取重置链接' : '输入 Token 和新密码'}}</text>
  </view>

  <!-- ============== 卡片容器 ============== -->
  <view class="fp-card">
    <!-- 步骤一：发起找回 -->
    <block wx:if="{{step === 1}}">
      <view class="form-item">
        <view class="input-wrap">
          <icon name="mail" size="32rpx" color="#6a7d81" />
          <input
            class="form-input"
            type="text"
            placeholder="请输入注册邮箱"
            placeholder-class="ph"
            value="{{email}}"
            bindinput="onEmailInput"
          />
        </view>
      </view>

      <view wx:if="{{errorMsg}}" class="error-msg">
        <icon name="alert-circle" size="24rpx" color="#cd5852" />
        <text>{{errorMsg}}</text>
      </view>

      <view class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="onSendResetEmail" hover-class="submit-btn-hover" hover-stay-time="120">
        <text>{{loading ? '发送中...' : '发送重置链接'}}</text>
      </view>
    </block>

    <!-- 步骤二：输入 Token + 新密码 -->
    <block wx:else>
      <view wx:if="{{infoMsg}}" class="info-msg">
        <icon name="check-circle" size="24rpx" color="#2f855a" />
        <text>{{infoMsg}}</text>
      </view>

      <view class="form-item">
        <view class="input-wrap">
          <icon name="shield" size="32rpx" color="#6a7d81" />
          <input
            class="form-input"
            type="text"
            placeholder="请输入重置 Token"
            placeholder-class="ph"
            value="{{resetToken}}"
            bindinput="onResetTokenInput"
          />
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrap">
          <icon name="lock" size="32rpx" color="#6a7d81" />
          <input
            class="form-input"
            type="password"
            placeholder="请输入新密码（至少 6 位）"
            placeholder-class="ph"
            value="{{newPassword}}"
            bindinput="onPasswordInput"
          />
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrap">
          <icon name="lock" size="32rpx" color="#6a7d81" />
          <input
            class="form-input"
            type="password"
            placeholder="请再次输入新密码"
            placeholder-class="ph"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
        </view>
      </view>

      <view wx:if="{{errorMsg}}" class="error-msg">
        <icon name="alert-circle" size="24rpx" color="#cd5852" />
        <text>{{errorMsg}}</text>
      </view>

      <view class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="onResetPassword" hover-class="submit-btn-hover" hover-stay-time="120">
        <text>{{loading ? '重置中...' : '重置密码'}}</text>
      </view>
    </block>

    <view class="form-links">
      <text class="link-back" bindtap="goToLogin">返回登录</text>
      <text wx:if="{{step === 2}}" class="link-resend" bindtap="backToStep1">重新发送</text>
    </view>
  </view>
</view>
